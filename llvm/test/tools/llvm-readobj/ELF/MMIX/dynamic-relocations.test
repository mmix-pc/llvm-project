## Numeric records and named YAML must agree independently of MC/lld support.
## These synthetic records do not establish emission or application support.
# RUN: yaml2obj %s -o %t.o
# RUN: llvm-readobj --relocations --expand-relocs %t.o | FileCheck %s
# RUN: llvm-readelf --relocations %t.o | FileCheck %s --check-prefix=NAMES
# RUN: llvm-objdump -r %t.o | FileCheck %s --check-prefix=NAMES
# RUN: obj2yaml %t.o | FileCheck %s --check-prefix=YAML
