# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../../libc %t clang

#--- check.py
from pathlib import Path
import shutil
import subprocess
import sys

libc, out = map(Path, sys.argv[1:3])
clang = sys.argv[3]
resource = subprocess.check_output(
    [clang, "--no-default-config", "-print-resource-dir"], text=True).strip()
include = out / "include"
include.mkdir(exist_ok=True)
for name in ("llvm-libc-types", "llvm-libc-macros"):
    shutil.copytree(libc / "include" / name, include / name, dirs_exist_ok=True)
shutil.copyfile(libc / "include/__llvm-libc-common.h",
                include / "llvm-libc-macros/mmix/common-base.h")
shutil.copyfile(libc / "include/llvm-libc-macros/mmix/linux-common.h",
                include / "__llvm-libc-common.h")
for name in ("signal", "setjmp", "time"):
    subprocess.run([sys.executable, str(libc / "utils/hdrgen/main.py"),
                    str(libc / "include" / (name + ".yaml")), "--visibility",
                    str(libc / "config/linux/mmix/HeaderVisibility.yaml"),
                    "-o", str(include / (name + ".h"))], check=True)

modes = [([], 0, 0, False, False),
         (["-D_POSIX_C_SOURCE=200809L"], 200809, 0, False, False),
         (["-D_POSIX_C_SOURCE=202405L"], 202405, 0, False, False),
         (["-D_XOPEN_SOURCE=700"], 200809, 700, False, False),
         (["-D_XOPEN_SOURCE=800"], 202405, 800, False, False),
         (["-D_DEFAULT_SOURCE"], 202405, 0, False, True),
         (["-D_GNU_SOURCE"], 202405, 800, True, True)]
for language in ("c", "c++"):
    command = [clang, "--no-default-config", "--target=mmix-unknown-linux",
               "-nostdinc", "-I", str(include), "-isystem", resource + "/include",
               "-x", language, "-std=c17" if language == "c" else "-std=c++17",
               "-U_GNU_SOURCE", "-fsyntax-only", "-Werror", "-"]
    for defines, posix, xsi, gnu, default in modes:
        def compile(source):
            return subprocess.run(command + defines, input=source, text=True,
                                  capture_output=True)
        check = "static_assert" if language == "c++" else "_Static_assert"
        prefix = '#include <signal.h>\n#include <setjmp.h>\n'
        result = compile(prefix + check + '(sizeof(jmp_buf) == 304, "jump ABI");\n'
                         'sig_atomic_t atomic_signal;\n'
                         'void (*(*handler)(int, void (*)(int)))(int) = &signal;\n')
        assert result.returncode == 0, (language, defines, result.stderr)
        for name, active in (
                ("raise", True), ("SIGABRT", True), ("SIG_ERR", True),
                ("kill", posix > 0), ("SIGUSR1", posix > 0),
                ("SIGRTMIN", posix > 0), ("SIG_BLOCK", posix > 0),
                ("SA_RESTART", posix > 0), ("SIGEV_THREAD", posix > 0),
                ("sigpending", posix > 0), ("sigqueue", posix > 0),
                ("sigwait", posix > 0), ("sigwaitinfo", posix > 0),
                ("sigtimedwait", posix > 0), ("sigsuspend", posix > 0),
                ("psiginfo", posix >= 200809), ("psignal", posix >= 200809),
                ("sig2str", posix >= 202405), ("str2sig", posix >= 202405),
                ("killpg", xsi > 0 or default),
                ("sigaltstack", xsi > 0 or default),
                ("MINSIGSTKSZ", xsi > 0 or default),
                ("SS_DISABLE", xsi > 0 or default),
                ("SIGEV_THREAD_ID", gnu), ("SS_AUTODISARM", gnu),
                ("NSIG", default), ("SA_RESTORER", default),
                ("SIGIOT", default), ("SIGIO", default),
                ("SIGWINCH", posix >= 202405 or default),
                ("SIG2STR_MAX", posix >= 202405 or default),
                ("SIGPOLL", default or 0 < xsi < 800),
                ("SIG_HOLD", default or 0 < xsi < 800),
                ("sigsetjmp", posix > 0), ("siglongjmp", posix > 0)):
            result = compile(prefix + 'void probe(void) { (void)(' + name + '); }\n')
            if active:
                assert result.returncode == 0, (defines, name, result.stderr)
            else:
                assert result.returncode != 0 and "undeclared" in result.stderr and name in result.stderr, (defines, name, result.stderr)
        for name, active in (
                ("sigset_t", posix > 0), ("siginfo_t", posix > 0),
                ("pid_t", posix > 0), ("uid_t", posix > 0),
                ("pthread_t", posix > 0), ("pthread_attr_t", posix > 0),
                ("size_t", posix > 0), ("sigjmp_buf", posix > 0),
                ("stack_t", posix > 0),
                ("mcontext_t", posix > 0), ("ucontext_t", posix > 0),
                ("sig_t", default), ("sighandler_t", gnu)):
            result = compile(prefix + name + ' object;\n')
            if active:
                assert result.returncode == 0, (defines, name, result.stderr)
            else:
                assert result.returncode != 0 and name in result.stderr, (defines, name, result.stderr)
        if posix >= 202405 or default:
            result = compile(prefix + check +
                             '(SIG2STR_MAX == 32 && SIG2STR_MAX >= sizeof("RTMIN+29") && '
                             'SIG2STR_MAX >= sizeof("RTMAX-29"), "signal name capacity");\n')
            assert result.returncode == 0, (defines, result.stderr)
        if posix:
            result = compile(prefix + check +
                             '(sizeof(sigset_t) == 128 && sizeof(siginfo_t) == 128 && '
                             'sizeof(struct sigaction) == 152 && sizeof(sigjmp_buf) == 304, "signal ABI");\n' +
                             check + '(__builtin_offsetof(ucontext_t, uc_mcontext) == 168 && '
                             'sizeof(mcontext_t) == 10456 && sizeof(ucontext_t) == 10624, "context ABI");\n' +
                             check + '(SIGRTMIN == 34 && SIGRTMAX == 64, "reserved signals");\n'
                             'int (*waitfn)(const sigset_t *, int *) = &sigwait;\n'
                             'int (*queuefn)(pid_t, int, union sigval) = &sigqueue;\n'
                             'void (*infofn)(const siginfo_t *, const char *) = &psiginfo;\n'
                             'struct timespec timeout;\n')
            assert result.returncode == 0, (defines, result.stderr)
            if language == "c++":
                result = compile(prefix +
                                 'static_assert(!noexcept(sigwait(nullptr, nullptr)), "cancellation");\n'
                                 'static_assert(!noexcept(sigwaitinfo(nullptr, nullptr)), "cancellation");\n'
                                 'static_assert(!noexcept(sigtimedwait(nullptr, nullptr, nullptr)), "cancellation");\n'
                                 'static_assert(!noexcept(sigsuspend(nullptr)), "cancellation");\n')
                assert result.returncode == 0, (defines, result.stderr)
        # Macro provider reuse through another header must preserve ABI and
        # must not bypass the selected public namespace.
        result = compile('#include <time.h>\n' + prefix)
        assert result.returncode == 0, (defines, result.stderr)

# The common declaration must also work without the MMIX namespace policy,
# including architectures without a public ucontext implementation.
shutil.copyfile(libc / "include/__llvm-libc-common.h", include / "__llvm-libc-common.h")
subprocess.run([sys.executable, str(libc / "utils/hdrgen/main.py"),
                str(libc / "include/signal.yaml"),
                "-o", str(include / "signal.h")], check=True)
for triple in ("mmix-unknown-unknown", "mmix-unknown-linux",
               "x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"):
    source = ('#include <signal.h>\n'
              'void (*(*handler)(int, void (*)(int)))(int) = &signal;\n'
              'static_assert(noexcept(signal(0, nullptr)), "signal is nonthrowing");\n'
              'static_assert(!noexcept((*signal(0, nullptr))(0)), "handler is not noexcept");\n')
    subprocess.run([clang, "--no-default-config", "--target=" + triple,
                    "-nostdinc", "-I", str(include), "-isystem", resource + "/include",
                    "-x", "c++", "-std=c++17", "-fsyntax-only", "-Werror", "-"],
                   input=source, text=True, check=True)
