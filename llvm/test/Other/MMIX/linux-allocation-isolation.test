# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../.. %t

#--- profile.cmake
cmake_minimum_required(VERSION 3.20)
set(LIBC_MMIX_BUILD_ALLOCATION ON)
set(LIBC_MMIX_BUILD_RUNTIME_STATE ON)
set(LLVM_LIBC_FULL_BUILD ON)
set(CMAKE_CROSSCOMPILING TRUE)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mmix)
set(CMAKE_BUILD_TYPE Release)
set(LIBC_CONF_ERRNO_MODE LIBC_ERRNO_MODE_SHARED)
set(LIBC_CONF_THREAD_MODE LIBC_THREAD_MODE_SINGLE)
if(DEFINED KEY)
  set(${KEY} ${VALUE})
endif()
include(${SOURCE}/libc/config/linux/mmix/Allocation.cmake)

#--- entries.cmake
cmake_minimum_required(VERSION 3.20)
set(LLVM_LIBC_FULL_BUILD ON)
set(LIBC_CONF_ERRNO_MODE LIBC_ERRNO_MODE_SHARED)
set(LIBC_CONF_THREAD_MODE LIBC_THREAD_MODE_SINGLE)
if(DEFINED KEY)
  set(${KEY} ${VALUE})
endif()
function(add_subdirectory)
endfunction()
function(add_entrypoint_object name)
  cmake_parse_arguments(ARG "ALIAS" "" "DEPENDS" ${ARGN})
  if(NOT ARG_ALIAS OR NOT ARG_DEPENDS STREQUAL ".linux.mmix.${name}")
    message(FATAL_ERROR "incorrect provider ownership")
  endif()
  set_property(GLOBAL APPEND PROPERTY aliases ${name})
endfunction()
function(add_entrypoint_external name)
  if(NOT name STREQUAL "mallopt")
    message(FATAL_ERROR "required allocation API is external")
  endif()
endfunction()
include(${SOURCE}/libc/src/stdlib/linux/mmix/Entrypoints.cmake)
get_property(aliases GLOBAL PROPERTY aliases)
list(SORT aliases)
if(NOT aliases STREQUAL "aligned_alloc;calloc;free;malloc;posix_memalign;realloc")
  message(FATAL_ERROR "incorrect allocation API set")
endif()

#--- check.py
import pathlib
import subprocess
import sys
source, root = map(pathlib.Path, sys.argv[1:])
def check(script, key=None, value=None, error=None, extra=()):
    args = ["cmake", "-DSOURCE=" + str(source), *extra]
    if key:
        args += ["-DKEY=" + key, "-DVALUE=" + value]
    result = subprocess.run([*args, "-P", str(root / script)], text=True, capture_output=True)
    assert (result.returncode != 0) == (error is not None), result.stderr
    if error:
        assert error in result.stderr, result.stderr
for key, value in (("LIBC_MMIX_BUILD_RUNTIME_STATE", "OFF"),
                   ("LLVM_LIBC_FULL_BUILD", "OFF"), ("LLVM_LIBC_INCLUDE_SCUDO", "ON"),
                   ("CMAKE_CROSSCOMPILING", "FALSE"), ("CMAKE_SYSTEM_NAME", "Generic"),
                   ("CMAKE_SYSTEM_PROCESSOR", "x86_64"), ("CMAKE_BUILD_TYPE", "Debug"),
                   ("LIBC_CONF_ERRNO_MODE", "LIBC_ERRNO_MODE_THREAD_LOCAL"),
                   ("LIBC_CONF_THREAD_MODE", "LIBC_THREAD_MODE_POSIX")):
    check("profile.cmake", key, value, "requires cross Release")
for archive in ("", "libclang_rt.builtins.a", str(root / "missing.a"), str(root)):
    check("profile.cmake", error="explicit compiler-rt archive",
          extra=["-DLIBC_MMIX_COMPILER_RT_BUILTINS=" + archive])
# Opt-in preparation adds no target or library requirements when disabled.
check("profile.cmake", "LIBC_MMIX_BUILD_ALLOCATION", "OFF")
check("entries.cmake")
for key, value in (("LLVM_LIBC_FULL_BUILD", "OFF"), ("LLVM_LIBC_INCLUDE_SCUDO", "ON"),
                   ("LIBC_CONF_THREAD_MODE", "LIBC_THREAD_MODE_POSIX"),
                   ("LIBC_CONF_ERRNO_MODE", "LIBC_ERRNO_MODE_THREAD_LOCAL")):
    check("entries.cmake", key, value, "without Scudo")
