# REQUIRES: mmix-registered-target, mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libc %t %mmix_host_cxx

# Injected private lifecycle hooks, not guest fork-continuation qualification.
# Includes initial-thread terminal AFTER rollback, exact owner/root binding,
# nested terminal children, closed leases/cancellation and no drain replay.
# Initial-thread terminal DURING additionally runs production ForkOperation
# and completion with injected cursor/loader/transport boundaries. Both TLS
# and TSS locations include explicit-exit and cancellation-state entries,
# nested children, failed clone/frozen-check rollback, and a later AFTER fork.
#--- run.py
import pathlib
import shlex
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
host = shlex.split(sys.argv[3])
for opt in ("0", "2"):
    exe = root / ("native-O" + opt)
    subprocess.run([*host, "-std=c++17", "-fexceptions", "-UNDEBUG", "-O" + opt,
                    "-I", str(libc), "-DLIBC_NAMESPACE=exit_fork_test",
                    "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
                    "-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL",
                    str(libc / "test/src/stdlib/mmix_normal_exit_fork_native.cpp"),
                    "-o", str(exe)], check=True)
    subprocess.run([str(exe)], check=True, timeout=30)
