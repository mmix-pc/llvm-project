# REQUIRES: mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../.. %t %mmix_host_cxx

# Compile the selected public wrapper with its real target attribute layout.
# This checks error classification and full-object nonmutation, not scheduling.
#--- run.py
import pathlib
import shlex
import subprocess
import sys

source, out = map(pathlib.Path, sys.argv[1:3])
for opt in ("0", "2"):
    exe = out / ("policy-O" + opt)
    subprocess.run([
        *shlex.split(sys.argv[3]), "-std=c++17", "-UNDEBUG", "-O" + opt,
        "-I", str(out), "-I", str(source / "libc"),
        "-I", str(source / "libc/include"),
        "-DLIBC_NAMESPACE=attribute_policy_test", str(out / "test.cpp"),
        str(source / "libc/src/pthread/linux/mmix/pthread_attr_setschedpolicy.cpp"),
        "-o", str(exe)], check=True)
    subprocess.run([str(exe)], check=True, timeout=30)

#--- pthread.h
#include "include/llvm-libc-types/linux/mmix/pthread_attr_t.h"

#--- test.cpp
#include "src/pthread/pthread_attr_setschedpolicy.h"
#include <cassert>
#include <cerrno>
#include <cstring>

int main() {
  pthread_attr_t attr, before;
  std::memset(&attr, 0x5a, sizeof(attr));
  std::memcpy(&before, &attr, sizeof(attr));
  errno = EDOM;
  assert(attribute_policy_test::pthread_attr_setschedpolicy(&attr, 6) == ENOTSUP);
  assert(errno == EDOM && !std::memcmp(&attr, &before, sizeof(attr)));
  const int invalid[] = {-1, 4, 7, 0x40000001};
  for (int value : invalid) {
    assert(attribute_policy_test::pthread_attr_setschedpolicy(&attr, value) == EINVAL);
    assert(errno == EDOM && !std::memcmp(&attr, &before, sizeof(attr)));
  }
  const int supported[] = {0, 1, 2, 3, 5};
  for (int value : supported) {
    before.__schedpolicy = value;
    assert(attribute_policy_test::pthread_attr_setschedpolicy(&attr, value) == 0);
    assert(errno == EDOM && !std::memcmp(&attr, &before, sizeof(attr)));
  }
}
