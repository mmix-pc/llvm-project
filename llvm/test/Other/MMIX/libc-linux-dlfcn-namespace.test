# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../../libc %t clang

#--- check.py
from pathlib import Path
import shutil
import subprocess
import sys

libc, out = map(Path, sys.argv[1:3])
clang = sys.argv[3]
include = out / "include"
for directory in ("llvm-libc-macros", "llvm-libc-types"):
    shutil.copytree(libc / "include" / directory, include / directory,
                    dirs_exist_ok=True)
shutil.copyfile(libc / "include/__llvm-libc-common.h",
                include / "llvm-libc-macros/mmix/common-base.h")
shutil.copyfile(libc / "include/llvm-libc-macros/mmix/linux-common.h",
                include / "__llvm-libc-common.h")
subprocess.run([sys.executable, str(libc / "utils/hdrgen/main.py"),
                str(libc / "include/dlfcn.yaml"), "--visibility",
                str(libc / "config/linux/mmix/HeaderVisibility.yaml"),
                "-o", str(include / "dlfcn.h")], check=True)
for language in ("c", "c++"):
    for profile, defines in (
            ("posix", ["-D_POSIX_C_SOURCE=202405L"]),
            ("xsi", ["-D_XOPEN_SOURCE=800"]),
            ("old-posix", ["-D_POSIX_C_SOURCE=200809L"]),
            ("gnu", ["-D_GNU_SOURCE"]),
            ("both", ["-D_POSIX_C_SOURCE=202405L", "-D_GNU_SOURCE"])):
        for macro in (False, True):
            strict = profile in ("posix", "xsi", "old-posix")
            source = "#define Dl_info 37\n" if strict and macro else ""
            source += "#include <dlfcn.h>\n#include <dlfcn.h>\n"
            if strict:
                source += ("#if Dl_info != 37\n#error changed application macro\n#endif\n"
                           if macro else "int Dl_info;\n")
            else:
                source += "Dl_info *alias;\n"
            assertion = "_Static_assert" if language == "c" else "static_assert"
            if profile == "old-posix":
                source += "int Dl_info_t;\nint dladdr;\n"
            else:
                source += assertion + '(sizeof(Dl_info_t) == 4 * sizeof(void *), "layout");\n'
                for index, member in enumerate(("dli_fname", "dli_fbase", "dli_sname", "dli_saddr")):
                    source += assertion + '( __builtin_offsetof(Dl_info_t, ' + member + ') == ' + str(index) + ' * sizeof(void *), "offset");\n'
                source += "int (*query)(const void *, Dl_info_t *) = &dladdr;\n"
                if not strict:
                    source += "Dl_info_t *standard_alias(void) { return alias; }\n"
            command = [clang, "--no-default-config", "--target=mmix-unknown-linux",
                       "-nostdinc", "-I", str(include), "-x", language,
                       "-std=c17" if language == "c" else "-std=c++17",
                       "-U_GNU_SOURCE", *defines, "-Werror", "-fsyntax-only", "-"]
            result = subprocess.run(command, input=source, text=True, capture_output=True)
            assert result.returncode == 0, (profile, language, macro, result.stderr)
