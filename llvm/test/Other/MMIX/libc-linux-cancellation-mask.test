# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
common = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
          "-DLIBC_NAMESPACE=mask_test", "-I", str(libc)]
for opt in ("0", "2"):
    subprocess.run(["clang", "-cc1", "-triple", "mmix-unknown-linux",
                    "-mrelocation-model", "static", "-internal-isystem",
                    resource + "/include", *common, "-O" + opt, "-emit-obj",
                    str(root / "semantics.cpp"),
                    "-o", str(root / ("target-O" + opt + ".o"))], check=True)
    if len(sys.argv) == 4:
        exe = root / ("native-O" + opt)
        subprocess.run([sys.argv[3], *common, "-O" + opt, "-include",
                        str(root / "native-boundary.h"),
                        str(root / "semantics.cpp"), "-o", str(exe)], check=True)
        subprocess.run([str(exe)], check=True)

#--- native-boundary.h
#include "src/__support/macros/properties/architectures.h"
#undef LIBC_TARGET_ARCH_IS_X86_64
#define LIBC_TARGET_ARCH_IS_MMIX
#define __mmix__ 1
#include "include/llvm-libc-macros/linux/signal-macros.h"
#undef MINSIGSTKSZ
#undef SIGSTKSZ
#include "include/llvm-libc-macros/mmix/linux-signal-macros.h"

#--- semantics.cpp
#include "src/signal/linux/mmix/cancellation_pthread_sigmask.cpp"
static void require(bool value) { if (!value) __builtin_trap(); }
static int reply, calls;
namespace mask_test::mmix {
int cancellation_public_mask(int how, const uint64_t *set, uint64_t *old) {
  ++calls;
  require(how == SIG_SETMASK);
  require(set && *set == 0x8000000000000001UL);
  if (!reply && old) *old = *set;
  return reply;
}
}
extern "C" int main() {
  static_assert(sizeof(sigset_t) == 128);
  sigset_t input{{0x8000000000000001UL}};
  struct { sigset_t mask; unsigned long canary; } output;
  output.canary = 123;
  for (auto &word : output.mask.__signals) word = ~0UL;
  require(mask_test::pthread_sigmask(SIG_SETMASK, &input, &output.mask) == 0);
  require(output.mask.__signals[0] == input.__signals[0]);
  for (unsigned i = 1; i < __NSIGSET_WORDS; ++i)
    require(output.mask.__signals[i] == 0);
  reply = 22;
  for (auto &word : output.mask.__signals) word = ~0UL;
  require(mask_test::pthread_sigmask(SIG_SETMASK, &input, &output.mask) == 22);
  for (auto word : output.mask.__signals) require(word == ~0UL);
  require(mask_test::pthread_sigmask(SIG_SETMASK, &input, nullptr) == 22);
  require(output.canary == 123 && calls == 3);
  return 0;
}
