# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
common = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
          "-DLIBC_NAMESPACE=sigaction_test", "-I", str(root), "-I", str(libc)]
for opt in ("0", "2"):
    subprocess.run(["clang", "-cc1", "-triple", "mmix-unknown-linux",
                    "-mrelocation-model", "static",
                    "-internal-isystem", resource + "/include", *common,
                    "-O" + opt, "-emit-obj", str(root / "semantics.cpp"),
                    "-o", str(root / ("target-O" + opt + ".o"))], check=True)
    if len(sys.argv) == 4:
        exe = root / ("native-O" + opt)
        subprocess.run([sys.argv[3], *common, "-O" + opt,
                        "-include", str(root / "native-boundary.h"),
                        str(root / "semantics.cpp"), "-o", str(exe)], check=True)
        subprocess.run([str(exe)], check=True)

#--- native-boundary.h
// Execute host semantics, intercepting only the external MMIX syscall boundary.
#include "src/__support/macros/properties/architectures.h"
#undef LIBC_TARGET_ARCH_IS_X86_64
#undef LIBC_TARGET_ARCH_IS_X86_32
#undef LIBC_TARGET_ARCH_IS_AARCH64
#define LIBC_TARGET_ARCH_IS_MMIX
#define __mmix__ 1

#--- sys/syscall.h
// The exported-UAPI comparison is a separate consumer gate.
#define SYS_rt_sigaction 134

#--- linux/errno.h
// Linux error values; independently checked against the exported MMIX UAPI.
#define EINVAL 22
#define EFAULT 14
#define ENOSYS 38

#--- semantics.cpp
#include "src/signal/linux/mmix/rt_sigaction.h"
#include <linux/errno.h>

using namespace sigaction_test;
using mmix::KernelSigaction;
static_assert(sizeof(struct sigaction) == 32);
static_assert(__builtin_offsetof(struct sigaction, sa_mask) == 8);
static_assert(__builtin_offsetof(struct sigaction, sa_flags) == 16);
static_assert(__builtin_offsetof(struct sigaction, sa_restorer) == 24);

static void handler(int) {}
static void handler3(int, siginfo_t *, void *) {}
static void restorer() {}
static void require(bool value) { if (!value) __builtin_trap(); }
static unsigned long number, calls;
static long arguments[6], reply;
static KernelSigaction sent{}, returned{};

extern "C" long __llvm_libc_mmix_syscall(unsigned long n, long a, long b, long c,
                                         long d, long e, long f) {
  number = n;
  ++calls;
  arguments[0] = a; arguments[1] = b; arguments[2] = c;
  arguments[3] = d; arguments[4] = e; arguments[5] = f;
  if (b)
    sent = *reinterpret_cast<KernelSigaction *>(b);
  // Deliberately write even on failure: the public output must not change.
  if (c)
    *reinterpret_cast<KernelSigaction *>(c) = returned;
  return reply;
}

int main() {
  const bool modes[] = {false, true};
  for (bool info : modes) {
    struct sigaction action{};
    action.sa_flags = static_cast<int>(SA_RESETHAND | SA_RESTORER |
                                      (info ? SA_SIGINFO : 0));
    if (info) action.sa_sigaction = handler3;
    else action.sa_handler = handler;
    action.sa_restorer = restorer;
    action.sa_mask.__signals[0] = 0x8000000000000101UL;
    auto kernel = mmix::to_kernel_sigaction(action);
    require(kernel.sa_flags == (0x84000000UL | (info ? 4 : 0)));
    require(kernel.sa_restorer == restorer);
    require(kernel.sa_mask == 0x8000000000000101UL);
    auto roundtrip = mmix::from_kernel_sigaction(kernel);
    require(roundtrip.sa_flags == action.sa_flags);
    require(roundtrip.sa_restorer == restorer);
    require(roundtrip.sa_mask.__signals[0] == action.sa_mask.__signals[0]);
    if (info) require(roundtrip.sa_sigaction == handler3);
    else require(roundtrip.sa_handler == handler);
    returned = kernel;
    for (int combination = 0; combination < 4; ++combination) {
      struct sigaction old{};
      reply = 0;
      auto result = mmix::rt_sigaction(SIGUSR1, combination & 1 ? &action : nullptr,
                                      combination & 2 ? &old : nullptr);
      require(result && result.value() == 0);
      require(number == SYS_rt_sigaction && arguments[0] == SIGUSR1);
      require(bool(arguments[1]) == bool(combination & 1));
      require(bool(arguments[2]) == bool(combination & 2));
      require(arguments[3] == 8 && arguments[4] == 0 && arguments[5] == 0);
      if (combination & 1) {
        require(sent.sa_flags == kernel.sa_flags && sent.sa_mask == kernel.sa_mask);
        require(sent.sa_restorer == restorer);
        if (info) require(sent.sa_sigaction == handler3);
        else require(sent.sa_handler == handler);
      }
      if (combination & 2) {
        require(old.sa_flags == action.sa_flags && old.sa_restorer == restorer);
        require(old.sa_mask.__signals[0] == action.sa_mask.__signals[0]);
        if (info) require(old.sa_sigaction == handler3);
        else require(old.sa_handler == handler);
      }
    }
    const int errors[] = {EINVAL, EFAULT, ENOSYS};
    for (int error : errors) {
      struct sigaction old{};
      old.sa_handler = SIG_IGN;
      old.sa_mask.__signals[0] = 0x55;
      old.sa_flags = SA_RESTART;
      old.sa_restorer = nullptr;
      reply = -error;
      auto before = calls;
      auto result = mmix::rt_sigaction(-1, &action, &old);
      require(!result && result.error() == error && calls == before + 1);
      require(arguments[0] == -1);
      require(old.sa_handler == SIG_IGN && old.sa_flags == SA_RESTART);
      require(old.sa_mask.__signals[0] == 0x55 && old.sa_restorer == nullptr);
    }
  }
  void (*handlers[])(int) = {SIG_DFL, SIG_IGN};
  for (auto handler_value : handlers) {
    struct sigaction action{};
    action.sa_handler = handler_value;
    auto kernel = mmix::to_kernel_sigaction(action);
    auto decoded = mmix::from_kernel_sigaction(kernel);
    require(decoded.sa_handler == handler_value);
    require(kernel.sa_flags == 0 && kernel.sa_mask == 0 && !kernel.sa_restorer);
  }
  return 0;
}
