# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../../libc %t clang

#--- check.py
from pathlib import Path
import shutil
import subprocess
import sys

libc, out = map(Path, sys.argv[1:3])
clang = sys.argv[3]
include = out / "include"
for directory in ("llvm-libc-macros", "llvm-libc-types"):
    shutil.copytree(libc / "include" / directory, include / directory,
                    dirs_exist_ok=True)
shutil.copyfile(libc / "include/__llvm-libc-common.h",
                include / "llvm-libc-macros/mmix/common-base.h")
shutil.copyfile(libc / "include/llvm-libc-macros/mmix/linux-common.h",
                include / "__llvm-libc-common.h")
shutil.copyfile(libc / "include/llvm-libc-macros/mmix/pthread-cleanup.h",
                include / "llvm-libc-macros/mmix/pthread-cleanup-base.h")
shutil.copyfile(libc / "include/llvm-libc-macros/mmix/pthread-cleanup-async.h",
                include / "llvm-libc-macros/mmix/pthread-cleanup.h")
for name in ("pthread", "sched", "time", "signal"):
    subprocess.run([sys.executable, str(libc / "utils/hdrgen/main.py"),
                    str(libc / "include" / (name + ".yaml")), "--visibility",
                    str(libc / "config/linux/mmix/HeaderVisibility.yaml"),
                    "-o", str(include / (name + ".h"))], check=True)
resource = subprocess.check_output([clang, "--no-default-config", "-print-resource-dir"], text=True).strip()
names = {"PTHREAD_INHERIT_SCHED": 0, "PTHREAD_EXPLICIT_SCHED": 1,
         "PTHREAD_SCOPE_SYSTEM": 0, "PTHREAD_SCOPE_PROCESS": 1}
for wrapped in (False, True):
    # Exercise both the ordinary header and the installed forced-unwind wrapper.
    if wrapped:
        shutil.copyfile(include / "llvm-libc-macros/pthread-macros.h",
                        include / "llvm-libc-macros/mmix/pthread-base-macros.h")
        shutil.copyfile(libc / "include/llvm-libc-macros/mmix/pthread-macros.h",
                        include / "llvm-libc-macros/pthread-macros.h")
    for target in ("mmix-unknown-linux", "x86_64-linux-gnu", "i386-linux-gnu"):
        for language in ("c", "c++"):
            for feature in ("-D_POSIX_C_SOURCE=202405L", "-D_XOPEN_SOURCE=800"):
                for header in ("time.h", "signal.h", "llvm-libc-types/pthread_attr_t.h"):
                    for kind in ("identifier", "macro", "pthread-first", "pthread-last"):
                        source = ""
                        if kind == "macro":
                            source += "".join("#define " + n + " 19\n" for n in names)
                        if kind == "pthread-first":
                            source += "#include <pthread.h>\n"
                        source += "#include <" + header + ">\n"
                        if kind == "pthread-last":
                            source += "#include <pthread.h>\n"
                        if kind.startswith("pthread"):
                            if target.startswith("mmix"):
                                source += "".join("#ifndef " + n + "\n#error missing scheduling constant\n#endif\n#if " + n + " != " + str(v) + "\n#error wrong scheduling constant\n#endif\n" for n, v in names.items())
                                source += "_Static_assert(sizeof(pthread_attr_t) == 48, \"attribute ABI\");\n" if language == "c" else "static_assert(sizeof(pthread_attr_t) == 48, \"attribute ABI\");\n"
                        elif kind == "macro":
                            source += "".join("#if " + n + " != 19\n#error application macro changed\n#endif\n" for n in names)
                        else:
                            source += "".join("#ifdef " + n + "\n#error scheduling macro leaked\n#endif\n" for n in names)
                            source += "enum { " + ", ".join(n + " = 19" for n in names) + " };\n"
                        command = [clang, "--no-default-config", "--target=" + target,
                                   "-nostdinc", "-I", str(include), "-isystem", resource + "/include",
                                   "-x", language, "-std=c17" if language == "c" else "-std=c++17",
                                   "-U_GNU_SOURCE", feature, "-Werror", "-fsyntax-only", "-"]
                        result = subprocess.run(command, input=source, text=True, capture_output=True)
                        assert result.returncode == 0, (command, wrapped, header, kind, result.stderr)
