# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %S/../../../../libc/utils/hdrgen/main.py -o %t/unistd.h %S/../../../../libc/include/unistd.yaml
# Use compiler resource headers, but never host libc or libc++ headers.
# RUN: clang --no-default-config --target=mmix-unknown-linux -nostdlibinc -std=c17 -ffreestanding -I %t -I %S/../../../../libc/include -fsyntax-only %t/public.c
# RUN: clang --no-default-config --target=mmix-unknown-linux -nostdlibinc -nostdinc++ -x c++ -std=c++17 -ffreestanding -I %t -I %S/../../../../libc/include -fsyntax-only %t/public.c
# RUN: clang --no-default-config --target=mmix-unknown-linux -nostdlibinc -std=c17 -ffreestanding -DLIBC_THREAD_MODE=0 -I %t -I %S/../../../../libc/include -fsyntax-only %t/public.c
# RUN: clang --no-default-config --target=mmix-unknown-linux -nostdlibinc -std=c17 -ffreestanding -DLIBC_THREAD_MODE=1 -I %t -I %S/../../../../libc/include -fsyntax-only %t/public.c
# RUN: clang --no-default-config --target=mmix-unknown-unknown -nostdlibinc -std=c17 -ffreestanding -I %t -I %S/../../../../libc/include -fsyntax-only %t/public.c
# RUN: clang --no-default-config --target=x86_64-unknown-linux-gnu -nostdlibinc -std=c17 -ffreestanding -DLIBC_THREAD_MODE=1 -I %t -I %S/../../../../libc/include -fsyntax-only %t/public.c

#--- public.c
#include <unistd.h>

#ifdef __cplusplus
#define CHECK static_assert
#else
#define CHECK _Static_assert
#endif

// Public capability is independent of private libc compilation flags.
#if defined(__linux__) && defined(__mmix__)
CHECK(_POSIX_THREADS == -1L, "source-only headers have no configured provider");
#elif defined(__linux__)
CHECK(_POSIX_THREADS == 202405L, "retain other Linux targets");
#elif defined(_POSIX_THREADS)
#error "Do not expose Linux thread capability on bare metal"
#endif
