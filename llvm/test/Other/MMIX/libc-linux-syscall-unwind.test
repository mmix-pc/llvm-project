# REQUIRES: mmix-registered-target
# RUN: llvm-mc -triple=mmix-unknown-linux -filetype=obj %S/../../../../libc/src/__support/OSUtil/linux/mmix/syscall.S -o %t.o
# RUN: llvm-dwarfdump --eh-frame %t.o | FileCheck %s
# RUN: llvm-objdump -d %t.o | FileCheck %s --check-prefix=CODE

# The exact interrupted PC needs metadata even with cancellation disabled in
# the parent. This leaf changes neither the stack pointer nor the return link.
# CHECK: CIE
# CHECK: FDE
# CHECK: DW_CFA_def_cfa: R254 +0
# CHECK: DW_CFA_same_value: RJ
# CODE-LABEL: <__llvm_libc_mmix_syscall>:
# CODE: OR r255, r231, 0x0
# CODE: OR r237, r255, 0x0
# CODE-NEXT: {{.*}}TRAP 0x1, 0x0, 0x0
# CODE-NEXT: {{.*}}POP 0x0, 0x0
