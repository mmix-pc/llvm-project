# REQUIRES: mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../.. %t %mmix_host_cxx

# Native transition test only; no target signal/unwind claim.
#--- run.py
import pathlib
import shlex
import subprocess
import sys
source, out = map(pathlib.Path, sys.argv[1:3])
for opt in ("0", "2"):
    exe = out / ("state-O" + opt)
    subprocess.run([
        *shlex.split(sys.argv[3]), "-std=c++17", "-UNDEBUG", "-O" + opt,
        "-ffunction-sections", "-fdata-sections", "-Wl,--gc-sections",
        "-I", str(out), "-I", str(source / "libc"),
        "-DLIBC_NAMESPACE=loader_cancel_state_test",
        "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
        "-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL",
        "-DLIBC_MMIX_SHARED_STARTUP",
        str(source / "libc/test/src/__support/threads/mmix_loader_cancel_state_native.cpp"),
        "-o", str(exe)], check=True)
    subprocess.run([str(exe)], check=True, timeout=30)

#--- asm/rstack.h
#ifndef TEST_LOADER_CANCEL_RSTACK_H
#define TEST_LOADER_CANCEL_RSTACK_H
#include <stdint.h>
#define __NR_mmix_rstack_query 10000
struct mmix_rstack_query { uint64_t chain_id; };
#endif
