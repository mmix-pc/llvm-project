# REQUIRES: mmix-registered-target, mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libunwind %t %mmix_host_cxx

# Generic native cursor implementation, no target runtime or default exports.
# The MMIX strict entry/landing integration is a separate target obligation.
#--- run.py
import pathlib
import platform
import shlex
import subprocess
import sys

source, root = map(pathlib.Path, sys.argv[1:3])
if platform.machine() not in ("x86_64", "amd64"):
    raise SystemExit("metadata policy native fixture requires x86_64")
host = shlex.split(sys.argv[3])
for opt in ("0", "2"):
    exe = root / ("metadata-policy-O" + opt)
    subprocess.run([
        *host, "-std=c++17", "-UNDEBUG", "-O" + opt,
        "-fno-exceptions", "-fno-rtti", "-pthread",
        "-I", str(source / "include"),
        str(source / "test/metadata-policy.pass.cpp"),
        "-ldl", "-o", str(exe),
    ], check=True)
    subprocess.run([str(exe)], check=True, timeout=30)
