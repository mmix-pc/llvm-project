# REQUIRES: mmix-registered-target, mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libc %t %mmix_host_cxx

# Native cursor/syscall injection, not target unwind or clone qualification.
# Ordinary -> terminal TLS/TSS drain -> AFTER uses three distinct generations;
# only the ordinary root initializes cancellation windows.
# Original workers retain bounds through the fresh drain and AFTER roots;
# only actual drain return and last-thread election permit the latter.
#--- run.py
import pathlib
import shlex
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
host = shlex.split(sys.argv[3])
for opt in ("0", "2"):
    exe = root / ("native-O" + opt)
    subprocess.run([*host, "-std=c++17", "-fexceptions", "-UNDEBUG", "-O" + opt,
                    "-I", str(root), "-I", str(libc),
                    "-I", str(libc.parent / "libunwind/src"),
                    "-DLIBC_NAMESPACE=last_thread_root_test",
                    "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
                    "-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL",
                    "-DLIBC_MMIX_CANCELLATION_WINDOWS",
                    str(libc / "test/src/__support/threads/mmix_last_thread_root_native.cpp"),
                    "-o", str(exe)], check=True)
    subprocess.run([str(exe)], check=True, timeout=30)

#--- asm/rstack.h
#ifndef TEST_MMIX_RSTACK_H
#define TEST_MMIX_RSTACK_H
#include <stdint.h>
#define __NR_mmix_rstack_query 10000
struct mmix_rstack_query { uint64_t chain_id; };
#endif

#--- libunwind.h
#ifndef TEST_MMIX_LIBUNWIND_H
#define TEST_MMIX_LIBUNWIND_H
#include <stdint.h>
typedef uintptr_t unw_word_t;
struct unw_context_t { uintptr_t unused; };
struct unw_cursor_t { uintptr_t unused; };
struct unw_proc_info_t { uintptr_t start_ip; };
enum { UNW_MMIX_RO = 0, UNW_REG_SP = 1 };
extern "C" {
int unw_getcontext(unw_context_t *);
int unw_init_local(unw_cursor_t *, unw_context_t *);
int unw_step(unw_cursor_t *);
int unw_is_signal_frame(unw_cursor_t *);
int unw_get_reg(unw_cursor_t *, int, unw_word_t *);
int unw_get_proc_info(unw_cursor_t *, unw_proc_info_t *);
}
#endif
