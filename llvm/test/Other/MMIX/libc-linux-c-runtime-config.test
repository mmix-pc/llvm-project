# REQUIRES: mmix-registered-target
# RUN: rm -rf %t
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../../libc %t

#--- CMakeLists.txt
cmake_minimum_required(VERSION 3.20)
include(${LIBC_SOURCE}/cmake/caches/mmix-linux-c-runtime.cmake)
project(CRuntimeConfig NONE)
set(LIBC_TARGET_ARCHITECTURE mmix)
set(LIBC_TARGET_OS linux)
set(LIBC_BINARY_DIR ${CMAKE_BINARY_DIR}/libc)
set(LIBC_INCLUDE_DIR ${LIBC_BINARY_DIR}/include)
# Imported stand-ins exercise composition configuration, not runtime behavior.
foreach(target libc mmix_libc_state)
  add_library(${target} STATIC IMPORTED)
  set_target_properties(${target} PROPERTIES IMPORTED_LOCATION ${CMAKE_BINARY_DIR}/${target}.a)
endforeach()
add_library(libc.startup.linux.mmix.crt1 OBJECT IMPORTED)
set_target_properties(libc.startup.linux.mmix.crt1 PROPERTIES
  IMPORTED_OBJECTS ${CMAKE_BINARY_DIR}/crt1.o)
foreach(target libc-startup libc-headers mmix_libc_allocation)
  add_custom_target(${target})
endforeach()
include(${LIBC_SOURCE}/config/linux/mmix/CRuntime.cmake)

#--- check-manifest.cmake
include(${MANIFEST})
if(NOT MMIX_C_RUNTIME_EXCLUDED STREQUAL EXPECTED_EXCLUDED)
  message(FATAL_ERROR "Excluded providers do not match selection: ${MMIX_C_RUNTIME_EXCLUDED}")
endif()

#--- check.py
import pathlib
import shutil
import struct
import subprocess
import sys

source, root = (pathlib.Path(arg).resolve() for arg in sys.argv[1:])
sysroot = root / "sysroot"
for header in ("asm/unistd.h", "asm/unistd_64.h", "linux/errno.h"):
    path = sysroot / "usr/include" / header
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch()
resources = root / "resources/mmix-unknown-linux"
resources.mkdir(parents=True)
# Minimal ELF objects test architecture admission without requiring another
# registered backend. These are deliberately not qualification artifacts.
def elf(machine):
    return struct.pack(">16sHHIQQQIHHHHHH", b"\x7fELF\x02\x02\x01" + bytes(9),
                       1, machine, 1, 0, 0, 0, 0, 64, 0, 0, 64, 0, 0)

for name in ("builtins", "begin", "end"):
    (resources / name).write_bytes(elf(80))
(resources / "host").write_bytes(elf(62))
(resources / "invalid").write_text("not ELF")
generic = root / "mmix-unknown-unknown"
generic.mkdir()
(generic / "begin").write_bytes(elf(80))
base = ["cmake", "-S", str(root), "-DLIBC_SOURCE=" + str(source),
        "-DCMAKE_SYSROOT=" + str(sysroot), "-DLIBC_KERNEL_HEADERS=/usr/include",
        "-DCMAKE_C_COMPILER=" + shutil.which("clang"),
        "-DLIBC_MMIX_COMPILER_RT_BUILTINS=" + str(resources / "builtins"),
        "-DLIBC_MMIX_COMPILER_RT_CRTBEGIN=" + str(resources / "begin"),
        "-DLIBC_MMIX_COMPILER_RT_CRTEND=" + str(resources / "end")]
cases = [([], None),
         (["-DLIBC_MMIX_BUILD_SIGNAL_MASKS=ON"], None),
         (["-DLIBC_MMIX_BUILD_SIGNAL_MASKS=ON", "-DLIBC_MMIX_BUILD_FORK=ON"], None),
         (["-DLIBC_MMIX_BUILD_SIGNAL_MASKS=ON", "-DLIBC_MMIX_BUILD_FORK=ON",
           "-DLIBC_MMIX_BUILD_SPAWN=ON"], None)]
for component in ("CORE", "DESCRIPTORS", "STDIO", "FILESYSTEM", "VM", "TIME",
                  "PROCESS_BASE", "RUNTIME_STATE", "ALLOCATION"):
    cases.append(([f"-DLIBC_MMIX_BUILD_{component}=OFF"], "requires " + component))
for option in ("CMAKE_SYSTEM_NAME=Generic", "CMAKE_SYSTEM_PROCESSOR=x86_64",
               "CMAKE_BUILD_TYPE=Debug", "LLVM_LIBC_FULL_BUILD=OFF",
               "LIBC_CONF_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
               "LIBC_CONF_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL",
               "LIBC_CONF_TIMEOUT_ENSURE_MONOTONICITY=ON", "LLVM_LIBC_INCLUDE_SCUDO=ON"):
    cases.append((["-D" + option], "requires cross Linux Release"))
for language in ("C", "CXX", "ASM"):
    cases.append(([f"-DCMAKE_{language}_COMPILER_TARGET=mmix-unknown-unknown"],
                  "requires Linux compiler targets"))
for kind in ("INCLUDE", "LIBRARY", "PACKAGE"):
    cases.append(([f"-DCMAKE_FIND_ROOT_PATH_MODE_{kind}=BOTH"],
                  "requires sysroot-only " + kind + " searches"))
for provider in ("BUILTINS", "CRTBEGIN", "CRTEND"):
    cases.append(([f"-DLIBC_MMIX_COMPILER_RT_{provider}=" + str(root / "missing")],
                  "requires an explicit " + provider))
cases += [
    (["-DLIBC_MMIX_COMPILER_RT_CRTBEGIN=" + str(generic / "begin")],
     "requires compiler-rt resources in mmix-unknown-linux"),
    (["-DLIBC_MMIX_COMPILER_RT_CRTEND=" + str(resources / "begin")],
     "requires distinct compiler-rt providers"),
    (["-DLIBC_MMIX_COMPILER_RT_CRTBEGIN=" + str(resources / "host")],
     "rejects non-MMIX provider"),
    (["-DLIBC_MMIX_COMPILER_RT_CRTBEGIN=" + str(resources / "invalid")],
     "requires non-TLS Linux ELF providers"),
]
for index, (options, error) in enumerate(cases):
    build = root / str(index)
    result = subprocess.run(base + ["-B", str(build)] + options,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if error:
        assert result.returncode and error in " ".join(result.stdout.split()), result.stdout
    else:
        assert result.returncode == 0, result.stdout
        manifest = (build / "mmix-c-runtime/Inputs.cmake").read_text()
        for key in ("LIBC", "STATE", "CRT1", "BUILTINS", "CRTBEGIN", "CRTEND",
                    "HEADERS", "ENTRYPOINTS", "SYSROOT", "EXCLUDED"):
            assert "set(MMIX_C_RUNTIME_" + key + " " in manifest, key
        excluded = ["fork", "spawn", "signals", "pthread", "TLS", "dynamic-linking"]
        if "-DLIBC_MMIX_BUILD_FORK=ON" in options:
            excluded.remove("fork")
        if "-DLIBC_MMIX_BUILD_SIGNAL_MASKS=ON" in options:
            excluded.remove("signals")
        if "-DLIBC_MMIX_BUILD_SPAWN=ON" in options:
            excluded.remove("spawn")
        subprocess.run(["cmake", "-DMANIFEST=" + str(build / "mmix-c-runtime/Inputs.cmake"),
                        "-DEXPECTED_EXCLUDED=" + ";".join(excluded),
                        "-P", str(root / "check-manifest.cmake")], check=True)
