# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: cmake -DLIBC_SOURCE=%S/../../../../libc -P %t/selection.cmake

#--- selection.cmake
cmake_minimum_required(VERSION 3.20)
include(${LIBC_SOURCE}/config/linux/mmix/entrypoints.txt)
if(libc.src.stdio.putchar IN_LIST TARGET_LIBC_ENTRYPOINTS)
  message(FATAL_ERROR "stdio changed the foundation selection")
endif()
set(extensions __fsetlocking __freadable __fwritable __freading __fwriting
               __flbf __fbufsize __fpending __fpurge _flushlbf)
foreach(name IN LISTS extensions)
  if("libc.src.stdio_ext.${name}" IN_LIST TARGET_LIBC_ENTRYPOINTS)
    message(FATAL_ERROR "disabled stdio selected extension ${name}")
  endif()
endforeach()
set(LIBC_MMIX_BUILD_STDIO ON CACHE BOOL "" FORCE)
include(${LIBC_SOURCE}/config/linux/mmix/entrypoints.txt)
foreach(name putchar fputc stdout ftello perror)
  if(NOT "libc.src.stdio.${name}" IN_LIST TARGET_LIBC_ENTRYPOINTS)
    message(FATAL_ERROR "missing stdio provider ${name}")
  endif()
endforeach()
foreach(name IN LISTS extensions)
  if(NOT "libc.src.stdio_ext.${name}" IN_LIST TARGET_LIBC_ENTRYPOINTS)
    message(FATAL_ERROR "missing stdio extension ${name}")
  endif()
endforeach()
include(${LIBC_SOURCE}/config/linux/mmix/headers.txt)
if(NOT libc.include.stdio_ext IN_LIST TARGET_PUBLIC_HEADERS)
  message(FATAL_ERROR "missing stdio extension header")
endif()
