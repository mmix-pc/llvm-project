# RUN: split-file %s %t
# RUN: cmake -DLIBC_SOURCE=%S/../../../../libc -DTEST_ROOT=%t -P %t/check.cmake

# Exercise consumer/prerequisite registration for partial Linux libc builds.
# No MMIX-only behavior is expected from these shared registration points.
#--- check.cmake
cmake_minimum_required(VERSION 3.20)
foreach(entry none pathconf fpathconf err verr errx verrx warn vwarn warnx vwarnx)
  execute_process(COMMAND ${CMAKE_COMMAND} -S ${TEST_ROOT}/consumers
    -B ${TEST_ROOT}/${entry} -DLIBC_SOURCE=${LIBC_SOURCE} -DENTRY=${entry}
    RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "consumer registration failed for ${entry}")
  endif()
endforeach()
foreach(have_vdso OFF ON)
  execute_process(COMMAND ${CMAKE_COMMAND} -S ${TEST_ROOT}/time
    -B ${TEST_ROOT}/time-${have_vdso} -DLIBC_SOURCE=${LIBC_SOURCE}
    -DHAVE_VDSO=${have_vdso} RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "time prerequisite registration failed")
  endif()
endforeach()

#--- consumers/CMakeLists.txt
cmake_minimum_required(VERSION 3.20)
project(CheckSelectedConsumers NONE)
set(TARGET_ENTRYPOINT_NAME_LIST ${ENTRY})
set(LLVM_LIBC_FULL_BUILD ON)
add_custom_target(libc.src.__support.OSUtil.osutil)
function(add_entrypoint_object)
endfunction()
function(add_header_library)
endfunction()
function(add_object_library name)
  if(name STREQUAL "pathconf_utils" OR name STREQUAL "report")
    add_custom_target(${name})
  endif()
endfunction()
include(${LIBC_SOURCE}/src/unistd/linux/CMakeLists.txt)
include(${LIBC_SOURCE}/src/err/CMakeLists.txt)
if(ENTRY STREQUAL "pathconf" OR ENTRY STREQUAL "fpathconf")
  if(NOT TARGET pathconf_utils OR TARGET report)
    message(FATAL_ERROR "incorrect pathconf helper selection")
  endif()
elseif(ENTRY STREQUAL "none")
  if(TARGET pathconf_utils OR TARGET report)
    message(FATAL_ERROR "unused helper requires an unselected state provider")
  endif()
elseif(NOT TARGET report OR TARGET pathconf_utils)
  message(FATAL_ERROR "incorrect err helper selection")
endif()

#--- time/CMakeLists.txt
cmake_minimum_required(VERSION 3.20)
project(CheckTimePrerequisites NONE)
set(LIBC_TARGET_OS linux)
file(MAKE_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/linux)
add_custom_target(libc.src.__support.OSUtil.osutil)
if(HAVE_VDSO)
  add_custom_target(libc.src.__support.OSUtil.linux.vdso)
endif()
function(add_header_library name)
  add_custom_target(libc.src.__support.time.${name})
endfunction()
function(add_object_library name)
  if(IN_OS_DIR)
    add_custom_target(libc.src.__support.time.linux.${name})
  else()
    add_custom_target(${name})
  endif()
endfunction()
function(add_subdirectory name)
  set(IN_OS_DIR ON)
  include(${LIBC_SOURCE}/src/__support/time/linux/CMakeLists.txt)
endfunction()
include(${LIBC_SOURCE}/src/__support/time/CMakeLists.txt)
if(NOT TARGET clock_settime OR NOT TARGET libc.src.__support.time.abs_timeout)
  message(FATAL_ERROR "vDSO-independent helpers were lost")
endif()
if(HAVE_VDSO AND NOT TARGET clock_gettime)
  message(FATAL_ERROR "missing supported clock utility")
elseif(NOT HAVE_VDSO AND TARGET clock_gettime)
  message(FATAL_ERROR "clock utility registered without vDSO support")
endif()
if(HAVE_VDSO AND NOT TARGET libc.src.__support.time.monotonicity)
  message(FATAL_ERROR "missing clock conversion consumer")
elseif(NOT HAVE_VDSO AND TARGET libc.src.__support.time.monotonicity)
  message(FATAL_ERROR "clock conversion consumer lacks its provider")
endif()
