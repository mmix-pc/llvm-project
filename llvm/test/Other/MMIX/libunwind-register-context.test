# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: clang --target=mmix -ffreestanding -std=c++17 -D_LIBUNWIND_IS_NATIVE_ONLY -I %S/../../../../libunwind/include -I %S/../../../../libunwind/src -fsyntax-only %t/layout.cpp
# RUN: clang --target=mmix -ffreestanding -D_LIBUNWIND_IS_NATIVE_ONLY -I %S/../../../../libunwind/include -x c -fsyntax-only %t/public.c
# Public consumers must not need libunwind's internal build definitions.
# RUN: clang --target=mmix -ffreestanding -I %S/../../../../libunwind/include -x c -fsyntax-only %t/public.c
# RUN: clang --target=mmix -ffreestanding -std=c++17 -I %S/../../../../libunwind/include -I %S/../../../../libunwind/src -fsyntax-only %t/layout.cpp
# Pure storage/access tests run through the host-endian interpreter, not MMIX
# execution. Native capture, restore and register-window traversal are separate.
# Remove the host OS macro so this models Generic MMIX, not MMIX Linux policy.
# RUN: clang --target=x86_64-unknown-linux-gnu -U__linux__ -std=c++17 -O1 -fno-exceptions -fno-rtti -D__mmix__ -D_LIBUNWIND_IS_NATIVE_ONLY -D_LIBUNWIND_IS_BAREMETAL -DNDEBUG -I %S/../../../../libunwind/include -I %S/../../../../libunwind/src -emit-llvm -c %t/access.cpp -o %t/access.bc
# RUN: lli -force-interpreter=true %t/access.bc
# RUN: clang --target=x86_64-unknown-linux-gnu -U__linux__ -std=c++17 -O1 -fno-exceptions -fno-rtti -D__mmix__ -D_LIBUNWIND_IS_BAREMETAL -DNDEBUG -I %S/../../../../libunwind/include -I %S/../../../../libunwind/src -emit-llvm -c %t/access.cpp -o %t/access-public.bc
# RUN: lli -force-interpreter=true %t/access-public.bc
# Instantiate the shared cursor with the MMIX register class without linking
# the native capture and restore entrypoints.
# RUN: clang --target=x86_64-unknown-linux-gnu -U__linux__ -std=c++17 -fno-exceptions -fno-rtti -D__mmix__ -D_LIBUNWIND_IS_NATIVE_ONLY -D_LIBUNWIND_IS_BAREMETAL -D_LIBUNWIND_HAS_NO_THREADS -DNDEBUG -I %S/../../../../libunwind/include -I %S/../../../../libunwind/src -emit-llvm -c %S/../../../../libunwind/src/libunwind.cpp -o %t/cursor.bc
# RUN: clang --target=x86_64-unknown-linux-gnu -U__linux__ -std=c++17 -fno-exceptions -fno-rtti -D__mmix__ -D_LIBUNWIND_IS_BAREMETAL -D_LIBUNWIND_HAS_NO_THREADS -DNDEBUG -I %S/../../../../libunwind/include -I %S/../../../../libunwind/src -emit-llvm -c %S/../../../../libunwind/src/libunwind.cpp -o %t/cursor-public.bc

#--- layout.cpp
#include <libunwind.h>
#include "mmix/Context.h"
static_assert(sizeof(unw_context_t) == 2128, "context storage");
static_assert(sizeof(unw_cursor_t) == 2224, "cursor storage");
static_assert(alignof(unw_context_t) == 8, "context alignment");
static_assert(alignof(unw_cursor_t) == 8, "cursor alignment");
static_assert(UNW_MMIX_R231 == 7 && UNW_MMIX_R232 == 8, "EH registers");
static_assert(UNW_MMIX_R253 == 29 && UNW_MMIX_R254 == 30, "software stack");
static_assert(UNW_MMIX_RJ == 35 && UNW_MMIX_RO == 38, "return and window");
static_assert(_LIBUNWIND_HIGHEST_DWARF_REGISTER == UNW_MMIX_PC, "DWARF bound");

#--- public.c
#include <libunwind.h>
_Static_assert(sizeof(unw_context_t) == 2128, "C context storage");
_Static_assert(sizeof(unw_cursor_t) == 2224, "C cursor storage");

#--- access.cpp
#include "UnwindCursor.hpp"
using namespace libunwind;
static_assert(sizeof(UnwindCursor<LocalAddressSpace, Registers_mmix>) <=
                  sizeof(unw_cursor_t), "cursor must fit opaque storage");
static_assert(alignof(UnwindCursor<LocalAddressSpace, Registers_mmix>) <=
                  alignof(unw_cursor_t), "cursor alignment");

struct WindowMemory {
  uint64_t words[64]{};
  uint64_t get64(uint64_t address) { return words[address / 8]; }
};

int main() {
  MMIXUnwindContext context{};
  for (int i = 0; i < 256; ++i)
    context.gpr[i] = 0x8000000000000000ULL + i;
  context.rd = 32; context.re = 33; context.rh = 34; context.rj = 35;
  context.rr = 36; context.ro = 38; context.rs = 283;
  context.rg = 291; context.rl = 292; context.ip = 304;
  Registers_mmix registers(&context);
  for (int i = 0; i < 256; ++i) {
    int dwarf = i < 224 ? i + 48 : i - 224;
    if (!registers.validRegister(dwarf) ||
        registers.getRegister(dwarf) != context.gpr[i])
      return 1;
    registers.setRegister(dwarf, 0x123456789abcdef0ULL + i);
    if (registers.getRegister(dwarf) != 0x123456789abcdef0ULL + i ||
        context.gpr[i] != 0x8000000000000000ULL + i)
      return 2;
    // Check architectural names independently of the DWARF index.
    const char *name = Registers_mmix::getRegisterName(dwarf);
    if (*name++ != '$') return 3;
    int number = 0;
    while (*name) number = number * 10 + (*name++ - '0');
    if (number != i) return 4;
  }
  int specials[] = {32, 33, 34, 35, 36, 38, 283, 291, 292, 304};
  for (int dwarf : specials) {
    if (!registers.validRegister(dwarf) ||
        registers.getRegister(dwarf) != static_cast<uint64_t>(dwarf))
      return 5;
    registers.setRegister(dwarf, 0xfedcba9876543210ULL);
    if (registers.getRegister(dwarf) != 0xfedcba9876543210ULL)
      return 6;
  }
  for (int n = 0; n <= 305; ++n) {
    bool valid = n <= 36 || n == 38 || (n >= 48 && n <= 271) ||
                 n == 283 || n == 291 || n == 292 || n == 304;
    if (registers.validRegister(n) != valid ||
        registers.validFloatRegister(n) || registers.validVectorRegister(n))
      return 7;
    if (!valid && Registers_mmix::getRegisterName(n)[0] != 'u')
      return 8;
  }
  if (registers.validRegister(-3) || registers.validRegister(0x7fffffff))
    return 9;
  registers.setRegister(UNW_REG_SP, 0x8000000000000100ULL);
  registers.setRegister(UNW_REG_IP, 0x8000000000000200ULL);
  registers.setRegisterWindow(0x6000000000000300ULL);
  if (registers.getSP() != registers.getRegister(30) ||
      registers.getIP() != registers.getRegister(304) ||
      registers.getRegisterWindow() != registers.getRegister(38))
    return 10;
  Registers_mmix copy = registers;
  registers.setSP(0); registers.setIP(0); registers.setRegisterWindow(0);
  if (copy.getRegister(UNW_REG_SP) != 0x8000000000000100ULL ||
      copy.getRegister(UNW_REG_IP) != 0x8000000000000200ULL ||
      copy.getRegisterWindow() != 0x6000000000000300ULL)
    return 11;
  Registers_mmix empty;
  if (empty.getSP() || empty.getIP() || empty.getRegisterWindow()) return 12;
  WindowMemory memory;
  memory.words[63] = 31;
  for (unsigned i = 0; i < 31; ++i) memory.words[32 + i] = 1000 + i;
  Registers_mmix current;
  current.setRegisterWindow(512);
  current.setRegister(UNW_MMIX_RG, 32);
  Registers_mmix caller = current;
  caller.setSP(4096);
  if (restoreMMIXWindow(memory, current, caller) != UNW_STEP_SUCCESS ||
      caller.getRegisterWindow() != 256 || caller.getSP() != 4096 ||
      current.getRegisterWindow() != 512 ||
      caller.getRegister(UNW_MMIX_RL) != 31) return 13;
  for (int i = 0; i < 31; ++i)
    if (caller.getRegister(UNW_MMIX_R0 + i) != 1000u + i) return 14;
  memory.words[63] = 33;
  if (restoreMMIXWindow(memory, current, caller) != UNW_EBADFRAME ||
      caller.getRegisterWindow() != 256) return 15;
  current.setRegisterWindow(7);
  if (restoreMMIXWindow(memory, current, caller) != UNW_EBADFRAME) return 16;
  current.setRegisterWindow(8);
  memory.words[0] = 31;
  if (restoreMMIXWindow(memory, current, caller) != UNW_EBADFRAME) return 17;
  return 0;
}
