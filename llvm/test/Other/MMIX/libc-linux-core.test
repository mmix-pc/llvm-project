# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-crt-composition.test %t/crt
# RUN: split-file %S/libc-linux-lifecycle.test %t/crt/lifecycle
# RUN: split-file %S/libc-linux-stack-guard.test %t/crt/lifecycle/guard
# RUN: split-file %S/libc-linux-process-args.test %t/crt/lifecycle/guard/args
# RUN: split-file %S/libc-linux-synchronization.test %t/crt/lifecycle/guard/args/sync
# RUN: %python %t/run.py %S/../../../../libc %t

#--- selection.cmake
cmake_minimum_required(VERSION 3.20)
include(${LIBC_SOURCE}/config/linux/mmix/entrypoints.txt)
set(initial ${TARGET_LIBC_ENTRYPOINTS})
if(LIBC_MMIX_BUILD_CORE)
  message(FATAL_ERROR "core must not change the initial foundation profile")
endif()
set(LIBC_MMIX_BUILD_CORE ON CACHE BOOL "" FORCE)
include(${LIBC_SOURCE}/config/linux/mmix/entrypoints.txt)
include(${LIBC_SOURCE}/config/linux/mmix/headers.txt)
foreach(entry IN LISTS MMIX_CORE_ENTRYPOINTS initial)
  if(NOT entry IN_LIST TARGET_LIBC_ENTRYPOINTS OR
     NOT entry IN_LIST TARGET_LLVMLIBC_ENTRYPOINTS)
    message(FATAL_ERROR "missing core entry ${entry}")
  endif()
endforeach()
foreach(header libc.include.ctype libc.include.inttypes libc.include.stdlib
               libc.include.string libc.include.strings)
  if(NOT header IN_LIST TARGET_PUBLIC_HEADERS)
    message(FATAL_ERROR "missing public core header ${header}")
  endif()
endforeach()
file(WRITE ${OUTPUT} "")
foreach(entry IN LISTS MMIX_CORE_ENTRYPOINTS)
  string(REPLACE "libc.src." "" entry ${entry})
  string(REPLACE "." "/" entry ${entry})
  file(APPEND ${OUTPUT} "${entry}\n")
endforeach()

#--- run.py
import pathlib
import runpy
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
crt = root / "crt"
sys.argv = [str(crt / "run.py"), str(libc), str(crt)]
composition = runpy.run_path(sys.argv[0])
base = composition["ctx"]["base"]
# The synchronization fixture contains an adapted test header. Never use that
# header to compile upstream tests: retain their real framework and assertions.
test_base = []
i = 0
while i < len(base):
    if base[i] == "-I" and base[i + 1] == str(crt / "lifecycle/guard/args/sync"):
        i += 2
    else:
        test_base.append(base[i])
        i += 1

def run(*args):
    subprocess.run(list(map(str, args)), check=True)

def output(*args):
    return subprocess.check_output(list(map(str, args)), text=True)

selection = root / "core.txt"
run("cmake", "-DLIBC_SOURCE=" + str(libc), "-DOUTPUT=" + str(selection),
    "-P", root / "selection.cmake")
entries = selection.read_text().splitlines()
assert len(entries) == len(set(entries)) == 65, entries
# Keep the original memory providers, including compiler-emitted memmove in
# generic qsort's fixed-size swap. Do not replace it with a test helper.
entries += ["string/" + name for name in ("memcpy", "memmove", "memset", "memcmp", "strlen")]
headers = crt / "lifecycle/guard/args/headers"
for name in ("ctype", "inttypes", "string", "strings", "stdlib", "fenv", "stdio"):
    run(sys.executable, libc / "utils/hdrgen/main.py", "-o", headers / (name + ".h"),
        libc / "include" / (name + ".yaml"))

# Compile upstream tests without replacing their framework or assertions.
# These objects are not linked or run, and do not qualify Linux execution.
# memchr/strcpy death tests require Linux signal-stack definitions; retain
# that execution dependency for signal support rather than inventing constants.
tests = ["string/strrchr", "string/strcmp", "string/strncmp", "string/stpcpy",
         "string/strdup", "strings/strcasecmp", "stdlib/strtol", "stdlib/strtoul",
         "stdlib/strtof", "stdlib/strtod", "stdlib/strtold", "stdlib/atoi",
         "stdlib/abs", "stdlib/div", "stdlib/bsearch", "ctype/isalpha", "ctype/tolower"]
for opt in ("0", "2"):
    out = root / ("O" + opt)
    out.mkdir(exist_ok=True)
    objects = []
    for entry in entries:
        obj = out / (entry.replace("/", "-") + ".o")
        run(*base, "-O" + opt, "-emit-obj", "-o", obj, libc / "src" / (entry + ".cpp"))
        objects.append(obj)
    archive = out / "core.a"
    run("llvm-ar", "rcs", archive, *objects)
    for test in tests:
        run(*test_base, "-O" + opt, "-emit-obj", "-o", out / (test.replace("/", "-") + "-test.o"),
            libc / "test/src" / (test + "_test.cpp"))
    # Include every selected function through its actual declaration; this
    # simultaneously checks public signatures and ordinary archive extraction.
    consumer = out / "consumer.c"
    lines = ["#include <ctype.h>", "#include <inttypes.h>", "#include <stdlib.h>",
             "#include <string.h>", "#include <strings.h>"]
    for entry in entries:
        name = entry.split("/")[-1]
        lines.append(f"__typeof__(&{name}) volatile use_{name} = &{name};")
    lines.append("int main(int argc, char **argv, char **env) {")
    for entry in entries:
        lines.append(f"  if (!use_{entry.split('/')[-1]}) return 1;")
    lines.append("  return 0;\n}")
    consumer.write_text("\n".join(lines) + "\n")
    consumer_obj = out / "consumer.o"
    run("clang", "--target=mmix-unknown-linux", "-std=gnu17", "-ffreestanding",
        "-fno-builtin", "-fstack-protector-strong", "-O" + opt,
        "-isystem", headers, "-c", consumer, "-o", consumer_obj)
    providers = crt / ("O" + opt)
    elf = out / "core.elf"
    run("ld.lld", "-m", "elf64mmix_linux", "-static", "--gc-sections", "-e", "_start",
        providers / "crt1.o", providers / "crtbegin.o", consumer_obj,
        "--start-group", archive, providers / "libc.a", providers / "libclang_rt.builtins.a",
        "--end-group", providers / "crtend.o", "-o", elf)
    assert not output("llvm-nm", "-u", elf).strip()
    symbols = output("llvm-nm", "--defined-only", elf).splitlines()
    for entry in entries:
        name = entry.split("/")[-1]
        assert sum(line.endswith(" " + name) for line in symbols) == 1, name
    sections = output("llvm-readobj", "--sections", "--program-headers", elf)
    for forbidden in ("SHF_TLS", ".MMIX.reg_contents", "PT_INTERP", "PT_DYNAMIC"):
        assert forbidden not in sections, sections
