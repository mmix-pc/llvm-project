# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: cmake -DSOURCE=%S/../../../.. -P %t/check.cmake
# RUN: %python %t/run.py %S/../../../../libc %t

#--- check.cmake
cmake_minimum_required(VERSION 3.20)
set(TARGET_LIBC_ENTRYPOINTS sentinel)
include(${SOURCE}/libc/config/linux/mmix/ProcessTiming.cmake)
if(NOT "${TARGET_LIBC_ENTRYPOINTS}" STREQUAL "sentinel")
  message(FATAL_ERROR "timing providers must be opt-in")
endif()
set(LIBC_MMIX_BUILD_PROCESS_TIMING ON)
include(${SOURCE}/libc/config/linux/mmix/ProcessTiming.cmake)
include(${SOURCE}/libc/config/linux/mmix/ProcessTiming.cmake)
list(LENGTH TARGET_LIBC_ENTRYPOINTS count)
if(NOT count EQUAL 6)
  message(FATAL_ERROR "incorrect or duplicate timing providers")
endif()
foreach(entry libc.src.sys.times.times libc.src.unistd.alarm
              libc.src.unistd.sleep libc.src.unistd.usleep libc.src.time.nanosleep)
  if(NOT entry IN_LIST TARGET_LIBC_ENTRYPOINTS)
    message(FATAL_ERROR "missing timing provider: ${entry}")
  endif()
endforeach()

#--- run.py
import pathlib
import subprocess
import sys
libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
common = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
          "-DLIBC_ERRNO_MODE=3", "-DLIBC_NAMESPACE=timing_test",
          "-I", str(root), "-I", str(libc)]
for opt in ("0", "2"):
    subprocess.run(["clang", "-cc1", "-triple", "mmix-unknown-linux",
        "-mrelocation-model", "static", "-internal-isystem", resource + "/include",
        *common, "-O" + opt, "-emit-obj", str(root / "semantics.cpp"),
        "-o", str(root / ("target-O" + opt + ".o"))], check=True)
    if len(sys.argv) == 4:
        exe = root / ("native-O" + opt)
        subprocess.run([sys.argv[3], *common, "-O" + opt, "-include",
            str(root / "native-boundary.h"), str(root / "semantics.cpp"),
            "-o", str(exe)], check=True)
        subprocess.run([str(exe)], check=True, timeout=30)

#--- native-boundary.h
#include "src/__support/macros/properties/architectures.h"
#undef LIBC_TARGET_ARCH_IS_X86_64
#undef LIBC_TARGET_ARCH_IS_X86_32
#undef LIBC_TARGET_ARCH_IS_AARCH64
#define LIBC_TARGET_ARCH_IS_MMIX
#define __mmix__ 1

#--- sys/syscall.h
#define SYS_nanosleep 101
#define SYS_setitimer 103
#define SYS_times 153

#--- linux/errno.h
#define EINTR 4
#define EFAULT 14
#define EINVAL 22
#define ENOSYS 38

#--- semantics.cpp
#include "src/sys/times/linux/times.cpp"
#include "src/time/linux/nanosleep.cpp"
#include "src/unistd/linux/alarm.cpp"
#include "src/unistd/linux/sleep.cpp"
#include "src/unistd/linux/usleep.cpp"
#include "src/errno/libc_errno.cpp"

using namespace timing_test;
static void require(bool ok) { if (!ok) __builtin_trap(); }
static long reply, args[6], seconds, fraction;
static unsigned long number;
static unsigned calls;
static bool fill;
static timeval previous;
extern "C" long __llvm_libc_mmix_syscall(unsigned long n, long a, long b,
                                        long c, long d, long e, long f) {
  number = n; ++calls;
  args[0] = a; args[1] = b; args[2] = c;
  args[3] = d; args[4] = e; args[5] = f;
  if (n == SYS_times && a && fill)
    *reinterpret_cast<tms *>(a) = {11, 22, 33, 44};
  if (n == SYS_setitimer) {
    auto *request = reinterpret_cast<itimerval *>(b);
    require(a == ITIMER_REAL && request->it_interval.tv_sec == 0 &&
            request->it_interval.tv_usec == 0 && request->it_value.tv_usec == 0);
    seconds = request->it_value.tv_sec;
    if (fill) reinterpret_cast<itimerval *>(c)->it_value = previous;
  }
  if (n == SYS_nanosleep && a) {
    auto *request = reinterpret_cast<const timespec *>(a);
    seconds = request->tv_sec; fraction = request->tv_nsec;
    if (b && fill) *reinterpret_cast<timespec *>(b) = {3, 456};
  }
  return reply;
}

int main() {
  static_assert(sizeof(clock_t) == 8 && sizeof(tms) == 32);
  tms buffer{};
  const long values[] = {0, 123, 0x7fffffffffffffffL, -0x7fffffffffffffffL - 1, -4096};
  for (long value : values) {
    reply = value; fill = true; libc_errno = 77;
    require(times(&buffer) == value && int(libc_errno) == 77);
    require(number == 153 && args[0] == reinterpret_cast<long>(&buffer));
    require(buffer.tms_utime == 11 && buffer.tms_stime == 22 &&
            buffer.tms_cutime == 33 && buffer.tms_cstime == 44);
    require(times(nullptr) == value && args[0] == 0);
  }
  const int errors[] = {EFAULT, EINVAL, ENOSYS, 4095};
  for (int error : errors) {
    reply = -error; fill = false; libc_errno = 77;
    require(times(reinterpret_cast<tms *>(-1L)) == -1 && int(libc_errno) == error);
    require(args[0] == -1);
  }
  reply = 0; fill = true;
  const unsigned alarms[] = {0, 1, 0xffffffffU};
  for (unsigned input : alarms) {
    previous = {9, 1}; libc_errno = 77;
    require(alarm(input) == 10 && seconds == input && int(libc_errno) == 77);
    previous = {9, 0}; require(alarm(input) == 9);
    previous = {0, 1}; require(alarm(input) == 1);
  }
  reply = -EINVAL; fill = false; libc_errno = 77;
  require(alarm(1) == 0 && int(libc_errno) == 77);
  const unsigned micros[] = {0, 1, 999999, 1000000, 0xffffffffU};
  for (unsigned input : micros) {
    reply = 0; libc_errno = 77;
    require(usleep(input) == 0 && seconds == input / 1000000 &&
            fraction == (input % 1000000) * 1000L && args[1] == 0);
    require(number == 101 && int(libc_errno) == 77);
  }
  reply = -EINTR; fill = true;
  timespec request{5, 789}, remaining{};
  unsigned before = calls;
  require(nanosleep(&request, &remaining) == -1 && int(libc_errno) == EINTR);
  require(calls == before + 1 && args[0] == reinterpret_cast<long>(&request));
  require(remaining.tv_sec == 3 && remaining.tv_nsec == 456 && request.tv_sec == 5);
  libc_errno = 77; before = calls;
  require(sleep(5) == 3 && int(libc_errno) == 77 && calls == before + 1);
  require(seconds == 5 && fraction == 0);
  reply = 0;
  require(sleep(0xffffffffU) == 0 && seconds == 0xffffffffU);
  reply = -EINTR; before = calls;
  require(usleep(1) == -1 && int(libc_errno) == EINTR && calls == before + 1);
  reply = -EINVAL;
  require(nanosleep(&request, nullptr) == -1 && int(libc_errno) == EINVAL);
  require(args[1] == 0 && args[2] == 0 && args[3] == 0 && args[4] == 0 && args[5] == 0);
  return 0;
}
