# REQUIRES: mmix-registered-target, mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libc %t %mmix_host_cxx

# Production metadata helper only, using the repository's real unw_context_t
# with host-native storage configuration. No fake context/cursor ABI, unwinder
# linkage, target wrapper execution, cursor disposal or POSIX admission claim.
#--- run.py
import pathlib
import shlex
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
host = shlex.split(sys.argv[3])
wrapped = ("malloc", "calloc", "realloc", "free", "aligned_alloc",
           "posix_memalign", "pthread_mutex_lock")
for opt, shared in ((o, s) for o in ("0", "2") for s in (False, True)):
    exe = root / ("signal-boundary-O" + opt + ("-shared" if shared else "-static"))
    subprocess.run([
        *host, "-std=c++17", "-UNDEBUG", "-O" + opt, "-pthread",
        "-I", str(libc), "-I", str(libc.parent / "libunwind/include"),
        "-I", str(libc.parent / "libunwind/src"),
        *(["-DLIBC_MMIX_SHARED_STARTUP"] if shared else []),
        "-D_LIBUNWIND_IS_NATIVE_ONLY",
        "-DLIBC_NAMESPACE=signal_boundary_test",
        "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
        "-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL",
        str(libc / "test/src/__support/threads/mmix_signal_boundary_native.cpp"),
        *("-Wl,--wrap=" + name for name in wrapped),
        "-o", str(exe),
    ], check=True)
    subprocess.run([str(exe)], check=True, timeout=30)
