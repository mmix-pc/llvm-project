# REQUIRES: mmix-registered-target, mmix-native-linux-host
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-notification-dispatcher.test %t/dispatch
# RUN: split-file %S/libc-linux-thread-create.test %t/base
# RUN: split-file %S/libc-linux-synchronization.test %t/sync
# RUN: %python %t/run.py %S/../../../../libc %t %mmix_host_cxx

#--- run.py
import pathlib
import shlex
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
host = shlex.split(sys.argv[3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
flags = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
         "-DEPROTO=71", "-DFUTEX_WAIT_PRIVATE=128", "-DLIBC_NAMESPACE=mq_test",
         "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
         "-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL",
         "-I", str(root / "headers"), "-I", str(root / "dispatch/headers"),
         "-I", str(root / "base/headers"), "-I", str(root / "sync"),
         "-I", str(libc), "-I", str(libc / "include")]
sources = [libc / "src/__support/threads/linux/mmix" / (name + ".cpp")
           for name in ("notification_mq", "notification_callback")]
for opt in ("0", "2"):
    for source in sources:
        obj = root / (source.stem + "-O" + opt + ".o")
        subprocess.run(["clang", "-cc1", "-triple", "mmix-unknown-linux",
            "-internal-isystem", resource + "/include", *flags, "-O" + opt,
            "-emit-obj", str(source), "-o", str(obj)], check=True)
        symbols = subprocess.check_output(["llvm-nm", "-u", str(obj)], text=True)
        assert all(s not in symbols for s in ("pthread_", "__emutls", "__atomic_"))
    bridge = root / "bridge.o"
    subprocess.run([*host, "-std=c++17", "-c", str(root / "bridge.cpp"),
                    "-o", str(bridge)], check=True)
    exe = root / ("host-O" + opt)
    subprocess.run([*host, *flags, "-D__mmix__", "-O" + opt,
        "-include", str(root / "base/transport.h"), *map(str, sources),
        str(root / "test.cpp"), str(bridge), "-o", str(exe)], check=True)
    for mode in range(12):
        subprocess.run([str(exe), str(mode)], check=True, timeout=10)
    print(f"Notification MQ: 12 scenarios passed at O{opt}", flush=True)

#--- headers/sys/syscall.h
#define SYS_mq_notify 184
#define SYS_futex 98
#define SYS_write 64
#define SYS_rt_sigprocmask 135
#define SYS_clock_gettime 113

#--- bridge.cpp
#include <cstdlib>
extern "C" void *host_allocate(__SIZE_TYPE__ size) { return std::malloc(size); }
extern "C" void host_free(void *p) { std::free(p); }

#--- test.cpp
#include "src/__support/threads/linux/mmix/notification_mq.h"
#include "src/__support/threads/linux/mmix/thread_create.h"
#include "src/__support/OSUtil/linux/kernel_sigevent.h"
#include "hdr/errno_macros.h"
using namespace mq_test;
using namespace mq_test::mmix;
using notification_transport::Event;
extern "C" void *host_allocate(__SIZE_TYPE__);
extern "C" void host_free(void *);
static void check(bool b) { if (!b) __builtin_trap(); }
static int mode, allocations, frees, attempts, syscalls, activations, discards;
static int drops, wakes, callbacks, lock_depth;
static bool cleanup_failure;
static bool creator;
static CallbackPhase phase = CallbackPhase::None;
static uint64_t cookie;
static NotificationMq *table;
static ThreadControl control;
static ThreadPreparation pending;

namespace mq_test {
void *malloc(size_t size) {
  check(!lock_depth);
  if (mode == 10) return nullptr;
  ++allocations;
  return host_allocate(size);
}
void free(void *p) { check(p && !lock_depth); ++frees; host_free(p); }
namespace mmix {
ThreadRegistry thread_registry;
// Model the lifecycle API contract, not actual clone/reaper execution. The
// production lifecycle/creator tests independently cover registry accounting.
ThreadRegistryLock::ThreadRegistryLock(ThreadRegistry &r) : registry(r) {
  check(!lock_depth++);
}
ThreadRegistryLock::~ThreadRegistryLock() {
  check(lock_depth-- == 1);
  if (changed) ++wakes;
}
bool ThreadRegistryLock::activate_callback(ThreadControl &c) {
  check(lock_depth && creator && &c == &control);
  check(phase == CallbackPhase::Waiting);
  if (mode == 7) return false;
  phase = CallbackPhase::Active; changed = true; ++activations;
  return true;
}
bool ThreadRegistryLock::discard_callback(ThreadControl &c) {
  check(lock_depth && creator && &c == &control);
  check(phase == CallbackPhase::Waiting);
  phase = CallbackPhase::Discarded; changed = true; ++discards;
  return true;
}
bool ThreadRegistryLock::drop_creator(ThreadControl &c) {
  check(lock_depth && creator && &c == &control);
  check(phase != CallbackPhase::Waiting);
  creator = false; changed = true; ++drops;
  return true;
}
ThreadCreationResult create_callback_waiter(const ThreadPreparation &request,
                                            ThreadControl *&output) {
  check(!lock_depth && request.detached);
  ++attempts;
  check(request.resource_owner.retain(request.resource_owner.context) == 0);
  if (mode == 6 || mode == 11) {
    ThreadCreationResult result;
    result.error = -EAGAIN;
    result.preparation.retained.owner = request.resource_owner;
    return result;
  }
  pending = request;
  creator = true;
  phase = CallbackPhase::Waiting;
  output = &control;
  return {};
}
long release_thread_resources(ThreadResources &resources) {
  check(!lock_depth && resources.owner.context);
  if (cleanup_failure) return EAGAIN;
  check(resources.owner.release(resources.owner.context) == 0);
  resources.owner = {};
  return 0;
}
}}

extern "C" long __llvm_libc_mmix_syscall(unsigned long number, long a, long b,
                                        long, long, long, long) {
  check(number == SYS_mq_notify && !lock_depth && a == 5);
  check(attempts == 1 && !activations && !discards && !drops);
  ++syscalls;
  const auto &event = *reinterpret_cast<linux_syscalls::KernelSigevent *>(b);
  check(event.sigev_notify == SIGEV_THREAD && event.sigev_signo == 17);
  const auto *bytes = static_cast<unsigned char *>(event.sigev_value.sival_ptr);
  for (int i = 0; i < 8; ++i) cookie = (cookie << 8) | bytes[i];
  check(cookie == 1);
  for (int i = 8; i < 32; ++i) check(!bytes[i]);
  if (mode == 2 || mode == 3 || mode == 4 || mode == 9) {
    table->consume({cookie, mode == 3 ? Event::MqRemoved : Event::MqWokenUp, 0});
    if (mode == 9) table->consume({cookie, Event::MqRemoved, 0});
    check(!activations && !discards && !drops && !table->drained());
  }
  return mode == 4 || mode == 5 ? -EBUSY : 0;
}
static void callback(sigval value) { check(value.sival_int == 73); ++callbacks; }
extern "C" int main(int argc, char **argv) {
  check(argc == 2);
  for (const char *p = argv[1]; *p; ++p) mode = mode * 10 + *p - '0';
  NotificationMq mq(mode == 8 ? UINT64_MAX : 0); table = &mq;
  sigevent event{};
  event.sigev_notify = SIGEV_THREAD;
  event.sigev_notify_function = callback;
  event.sigev_value.sival_int = 73;
  cleanup_failure = mode == 11;
  long result = mq.install(5, 17, event, {}, 8192);
  long expected = mode == 4 || mode == 5 ? EBUSY :
                  mode == 6 || mode == 11 ? EAGAIN :
                  mode == 8 ? EOVERFLOW : mode == 10 ? ENOMEM : 0;
  check(result == expected);
  if (mode == 0 || mode == 1 || mode == 7) {
    check(!mq.drained() && !drops);
    mq.consume({cookie + 1, Event::MqWokenUp, 0});
    mq.consume({cookie, Event::TimerExpired, 0});
    mq.consume({cookie, Event::MqWokenUp, 1});
    check(!drops);
    mq.consume({cookie, mode == 1 ? Event::MqRemoved : Event::MqWokenUp, 0});
  }
  mq.consume({cookie, Event::MqWokenUp, 0});
  mq.consume({cookie, Event::MqRemoved, 0});
  check(callbacks == 0);
  if (mode == 11) {
    check(!mq.drained() && mq.retry_cleanup() == EAGAIN);
    cleanup_failure = false;
    check(mq.retry_cleanup() == 0);
  }
  check(mq.drained() && mq.retry_cleanup() == 0);
  check(syscalls == (mode == 6 || mode == 8 || mode == 10 || mode == 11 ? 0 : 1));
  check(mq.last_issued_cookie() == (mode == 8 ? UINT64_MAX : uint64_t(syscalls)));
  if (pending.resource_owner.context) {
    check(drops == 1 && wakes == 1 && !creator);
    bool activated = mode == 0 || mode == 2 || mode == 9;
    check(activations == int(activated) && discards == int(!activated));
    // The transaction freed its record, but the resource owner still pins the
    // envelope through callback entry and simulated terminal reclamation.
    check(frees == 1);
    if (activated) pending.runner.posix_runner(pending.argument);
    check(callbacks == int(activated));
    check(pending.resource_owner.release(pending.resource_owner.context) == 0);
  } else {
    check(!drops && !wakes && !activations && !discards);
  }
  check(allocations == frees);
  return 0;
}
