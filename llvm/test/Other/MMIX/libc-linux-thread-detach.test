# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-synchronization.test %t/sync
# RUN: split-file %S/libc-linux-thread-resources.test %t/resources
# RUN: split-file %S/libc-linux-thread-reclaim.test %t/reclaim
# RUN: split-file %S/libc-linux-thread-join.test %t/join
# RUN: split-file %S/libc-linux-thread-reaper.test %t/reaper
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import subprocess
import sys
libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(['clang','-print-resource-dir'],text=True).strip()
common = ['-std=c++17','-ffreestanding','-fno-builtin','-DLIBC_FULL_BUILD',
    '-DLIBC_NAMESPACE=detach_test','-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM',
    '-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL', '-I',str(root/'join/headers'),
    '-I',str(root/'reclaim/headers'),'-I',str(root/'resources/headers'),
    '-I',str(root/'sync'),'-I',str(libc),'-I',str(libc/'include')]
sources = [libc/'src/__support/threads/linux/mmix'/n for n in
    ('thread_detach.cpp','thread_reaper_loop.cpp','thread_join.cpp','thread_reclaim.cpp',
     'resources.cpp','tls.cpp','lifecycle.cpp')]
for opt in ('0','2'):
    objects=[]
    for i,src in enumerate(sources):
        obj=root/(str(i)+'-O'+opt+'.o'); objects.append(str(obj))
        subprocess.run(['clang','-cc1','-triple','mmix-unknown-linux',
            '-mrelocation-model','static','-ftls-model=local-exec',
            '-internal-isystem',resource+'/include',*common,'-O'+opt,
            '-emit-obj',str(src),'-o',str(obj)],check=True)
    linked=root/('detach-O'+opt+'.o')
    subprocess.run(['ld.lld','-m','elf64mmix_linux','-r',*objects,'-o',str(linked)],check=True)
    undefined=subprocess.check_output(['llvm-nm','-u',str(linked)],text=True)
    assert {l.split()[-1] for l in undefined.splitlines()} <= {
        '__llvm_libc_mmix_syscall','memcpy','memset'},undefined
    if len(sys.argv)==4:
        import resource as limits
        limits.setrlimit(limits.RLIMIT_CORE,(0,0))
        bridge=root/('bridge-O'+opt+'.o')
        subprocess.run([sys.argv[3],'-std=c++17','-pthread','-O'+opt,'-c',
            str(root/'reaper/bridge.cpp'),'-o',str(bridge)],check=True)
        exe=root/('host-O'+opt)
        subprocess.run([sys.argv[3],*common,'-D__mmix__','-pthread','-O'+opt,
            '-include',str(root/'reclaim/transport.h'),*map(str,sources),
            str(root/'test.cpp'),str(bridge),'-o',str(exe)],check=True)
        for mode in range(18):
            subprocess.run([str(exe),str(mode)],check=True,timeout=15)
        print('Native detach/reaper: 18 scenarios passed at O'+opt,flush=True)

#--- test.cpp
#include "src/__support/threads/linux/mmix/thread_detach.h"
#include "src/__support/threads/linux/mmix/thread_reaper.h"
#include "src/__support/threads/linux/mmix/thread_join.h"
#include "src/__support/threads/thread.h"
#include "hdr/errno_macros.h"
#include <linux/futex.h>
#include <sys/syscall.h>
using namespace detach_test;
using namespace detach_test::mmix;
extern "C" void concurrent(void (*)());
extern "C" long host_futex(long,long,long,long,long,long);
extern "C" int fork();
extern "C" int waitpid(int,int*,int);
extern "C" void *memset(void*,int,__SIZE_TYPE__);
extern "C" int printf(const char*,...);
static void check(bool ok,unsigned line) {
  if (!ok) { printf("detach check failed at %u\n",line); __builtin_abort(); }
}
#define require(x) check(bool(x),__LINE__)
alignas(8192) static unsigned char memory[6][81920];
alignas(8) static unsigned char supplied[65536];
static size_t sizes[6];
static bool freed[6];
static unsigned mode,maps,unmaps,shared_waits,event_waits;
static ThreadControl main_control,*records[2];
static cpp::Atomic<unsigned> actors{0},finished{0},winners{0};
static bool join_won;
struct Done {};
static void *runner(void *p) { return p; }
static void complete(ThreadControl &c) {
  ThreadRegistryLock lock(thread_registry);
  require(lock.begin_cleanup(c) && lock.close_leases(c));
  require(lock.exit_ready(c,ThreadReturnValue(42)));
  require(!lock.exit_ready(c,ThreadReturnValue(43)));
}
extern "C" long __llvm_libc_mmix_syscall(unsigned long n,long a,long b,long c,long d,long e,long f) {
  if(n==SYS_mmap) { unsigned i=maps++; require(i<6 && b<=81920);
    sizes[i]=b; return reinterpret_cast<long>(memory[i]); }
  if(n==SYS_mprotect) return 0;
  if(n==SYS_munmap) {
    unsigned i=(reinterpret_cast<unsigned char *>(a)-memory[0])/sizeof(memory[0]);
    require(i<maps && !freed[i] && sizes[i]==size_t(b));
    { ThreadRegistryLock lock(thread_registry); } // Never unmap under registry lock.
    if(mode==10 && i==2) return -EINVAL;
    freed[i]=true; ++unmaps;
    memset(reinterpret_cast<void*>(a),0xa5,b); return 0;
  }
  if(n==SYS_clock_gettime) {
    if(mode==12) return -ENOSYS;
    require(a==CLOCK_MONOTONIC); *reinterpret_cast<timespec*>(b)={30,0}; return 0;
  }
  if(n==SYS_futex) {
    if(b==FUTEX_WAKE_PRIVATE || (mode==13 && b==FUTEX_WAIT_BITSET_PRIVATE))
      return host_futex(a,b,c,d,e,f);
    require(e==0 && f==FUTEX_BITSET_MATCH_ANY);
    auto *ts=reinterpret_cast<timespec*>(d);
    require(ts && ts->tv_sec==30 && ts->tv_nsec==10000000);
    if(b==FUTEX_WAIT_BITSET) {
      ++shared_waits;
      require(a==reinterpret_cast<long>(&records[0]->clear_tid.value.val));
      { ThreadRegistryLock lock(thread_registry); require(lock.queued_reclaims()>=1); }
      if(mode==11) return -EFAULT;
      if(mode==4) return -EINTR;
      if(mode==5) return -EAGAIN;
      if(mode==6) return 0;
      if(mode==9 && shared_waits==2) records[0]->clear_tid.value.store(0);
      return -ETIMEDOUT;
    }
    require(b==FUTEX_WAIT_BITSET_PRIVATE && (mode==8 || mode==9));
    ++event_waits;
    if(unmaps==maps) throw Done{};
    if(mode==8) {
      require(event_waits==1 && !unmaps);
      complete(*records[0]); records[0]->clear_tid.value.store(0);
      return -EAGAIN;
    }
    return -ETIMEDOUT;
  }
  __builtin_trap();
}
static void race() {
  unsigned actor=actors.fetch_add(1);
  internal::self.attrib=&main_control.attributes;
  if(actor==0) {
    ThreadJoinClaim claim;
    int result=claim_thread_join(&records[0]->attributes,claim);
    require(result==0 || result==EINVAL);
    if(!result) { winners.fetch_add(1); join_won=true; }
    while(finished.load()!=2) {}
    if(!result) abandon_thread_join(claim);
  } else {
    int result=detach_thread(&records[0]->attributes);
    require(result==0 || result==EINVAL);
    if(!result) winners.fetch_add(1);
    finished.fetch_add(1);
  }
}
extern "C" int main(int argc,char **argv) {
  require(argc==2); for(auto p=argv[1];*p;++p) mode=mode*10+*p-'0';
  bool two=(mode>=3 && mode<=7) || mode==9;
  { ThreadRegistryLock lock(thread_registry); main_control.attributes.tid=1;
    require(lock.register_main(main_control)); }
  internal::self.attrib=&main_control.attributes;
  for(unsigned i=0;i<(two?2:1);++i) {
    ThreadPreparation r; r.runner.posix_runner=runner;
    if(mode==14) { r.stack=supplied; r.guard_size=0; }
    require(prepare_thread(r,records[i]).error==ThreadPrepareError::None);
    ThreadRegistryLock lock(thread_registry);
    require(lock.reserve() && lock.insert(*records[i],mode==2) && lock.start(*records[i]));
    if(!(mode==7 && i==0)) require(lock.drop_creator(*records[i]));
  }
  auto *c=records[0];
  require(detach_thread(reinterpret_cast<ThreadAttributes*>(1))==ESRCH);
  require(detach_thread(&main_control.attributes)==ENOTSUP);
  if(mode==13) { concurrent(race); require(winners.load()==1);
    if(join_won) require(detach_thread(&c->attributes)==0); }
  else if(mode==16) {
    ThreadJoinClaim claim; require(claim_thread_join(&c->attributes,claim)==0);
    require(detach_thread(&c->attributes)==EINVAL);
    complete(*c);
    { ThreadRegistryLock lock(thread_registry); require(!lock.queued_reclaims()); }
    abandon_thread_join(claim); require(detach_thread(&c->attributes)==0);
  } else if(mode!=1 && mode!=2) require(detach_thread(&c->attributes)==0);
  if(mode!=1 && mode!=16) { ThreadRegistryLock lock(thread_registry); require(!lock.queued_reclaims()); }
  if(mode!=8 && mode!=16) complete(*c);
  if(mode==1) { ThreadRegistryLock lock(thread_registry); require(!lock.queued_reclaims()); }
  if(mode==1) require(detach_thread(&c->attributes)==0);
  require(detach_thread(&c->attributes)==EINVAL);
  if(mode==15) { ThreadRegistryLock lock(thread_registry);
    require(lock.queued_reclaims()==1 && !lock.requeue_candidate(*c)); }
  if(two) { require(detach_thread(&records[1]->attributes)==0); complete(*records[1]);
    records[1]->clear_tid.value.store(0); }
  bool delayed=(mode>=3 && mode<=6) || mode==9 || mode==11 || mode==12 || mode==17;
  if(!delayed && mode!=8) c->clear_tid.value.store(0);
  if(mode==7) { ThreadRegistryLock lock(thread_registry); require(lock.pin(&c->attributes)==c); }
  bool fatal=mode==10 || mode==11 || mode==12;
  if(fatal) { int child=fork(); require(child>=0);
    if(child) { int status; require(waitpid(child,&status,0)==child); require((status&127)==4); return 0; } }
  if(mode==8 || mode==9) {
    try { __llvm_libc_mmix_reaper_loop(); __builtin_abort(); } catch(Done &) {}
    require(event_waits && (mode!=9 || shared_waits==2));
  } else {
    uint32_t before; { ThreadRegistryLock lock(thread_registry); before=lock.sequence(); }
    bool progress=reap_detached_pass();
    if(delayed || mode==7) {
      require(progress==two && unmaps==(two?3:0));
      { ThreadRegistryLock lock(thread_registry);
        require(lock.queued_reclaims()==1);
        if(mode==17) require(before==lock.sequence());
        if(mode==7) { require(!lock.pin(&c->attributes));
          require(lock.drop_creator(*c) && lock.unpin(*c)); } }
      c->clear_tid.value.store(0); require(reap_detached_pass());
    } else require(progress);
  }
  require(!fatal && unmaps==maps);
  require(!reap_detached_pass());
  { ThreadRegistryLock lock(thread_registry); require(!lock.queued_reclaims()); }
  for(auto b:supplied) require(b==0);
  return 0;
}
