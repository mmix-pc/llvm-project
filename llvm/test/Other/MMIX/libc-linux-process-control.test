# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: cmake -DSOURCE=%S/../../../.. -P %t/check.cmake
# RUN: not cmake -DSOURCE=%S/../../../.. -DNO_MASKS=ON -P %t/check.cmake 2>&1 | FileCheck %s
# RUN: %python %t/run.py %S/../../../../libc %t
# CHECK: MMIX process control requires signal-mask support

#--- check.cmake
cmake_minimum_required(VERSION 3.20)
set(TARGET_LIBC_ENTRYPOINTS sentinel)
include(${SOURCE}/libc/config/linux/mmix/ProcessControl.cmake)
if(NOT TARGET_LIBC_ENTRYPOINTS STREQUAL "sentinel")
  message(FATAL_ERROR "process control must be opt-in")
endif()
set(LIBC_MMIX_BUILD_PROCESS_CONTROL ON)
if(NOT NO_MASKS)
  set(LIBC_MMIX_BUILD_SIGNAL_MASKS ON)
endif()
include(${SOURCE}/libc/config/linux/mmix/ProcessControl.cmake)
foreach(entry unistd.getppid unistd.getpagesize termios.tcflush
              signal.sigtimedwait sched.sched_getaffinity sys.prctl.prctl)
  if(NOT "libc.src.${entry}" IN_LIST TARGET_LIBC_ENTRYPOINTS)
    message(FATAL_ERROR "missing process control provider ${entry}")
  endif()
endforeach()

#--- run.py
import pathlib
import subprocess
import sys
libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
common = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
          "-DLIBC_ERRNO_MODE=3", "-DLIBC_NAMESPACE=process_test",
          "-I", str(root), "-I", str(libc)]
for opt in ("0", "2"):
    for mode, flags in (("legacy", []), ("time64", ["-DTEST_TIME64"])):
        suffix = mode + "-O" + opt
        subprocess.run(["clang", "-cc1", "-triple", "mmix-unknown-linux",
            "-mrelocation-model", "static", "-internal-isystem", resource + "/include",
            *common, *flags, "-O" + opt, "-emit-obj", str(root / "semantics.cpp"),
            "-o", str(root / ("target-" + suffix + ".o"))], check=True)
        if len(sys.argv) == 4:
            exe = root / ("native-" + suffix)
            subprocess.run([sys.argv[3], *common, *flags, "-O" + opt, "-include",
                str(root / "native-boundary.h"), str(root / "semantics.cpp"),
                "-o", str(exe)], check=True)
            subprocess.run([str(exe)], check=True, timeout=30)

#--- native-boundary.h
#include "src/__support/macros/properties/architectures.h"
#undef LIBC_TARGET_ARCH_IS_X86_64
#undef LIBC_TARGET_ARCH_IS_X86_32
#undef LIBC_TARGET_ARCH_IS_AARCH64
#define LIBC_TARGET_ARCH_IS_MMIX
#define __mmix__ 1

#--- sys/syscall.h
#define SYS_ioctl 29
#define SYS_sched_getaffinity 123
#define SYS_rt_sigtimedwait 137
#ifdef TEST_TIME64
#define SYS_rt_sigtimedwait_time64 421
#endif
#define SYS_prctl 167
#define SYS_getppid 173

#--- linux/errno.h
#define EINTR 4
#define EAGAIN 11
#define EFAULT 14
#define EINVAL 22
#define ENOTTY 25
#define ENOSYS 38
#define EOVERFLOW 75

#--- asm/ioctls.h
#define TCFLSH 0x540B

#--- semantics.cpp
#include "src/signal/linux/sigtimedwait.cpp"
#include "src/sched/linux/sched_getaffinity.cpp"
#include "src/sys/prctl/linux/prctl.cpp"
#include "src/termios/linux/tcflush.cpp"
#include "src/unistd/linux/getppid.cpp"
#include "src/errno/libc_errno.cpp"

using namespace process_test;
#ifdef TEST_TIME64
static constexpr long WAIT_SYSCALL = SYS_rt_sigtimedwait_time64;
#else
static constexpr long WAIT_SYSCALL = SYS_rt_sigtimedwait;
#endif
static void require(bool ok) { if (!ok) __builtin_trap(); }
static unsigned long number;
static long args[6], reply;
static unsigned calls;
static bool inspect_timeout;
extern "C" long __llvm_libc_mmix_syscall(unsigned long n, long a, long b,
                                        long c, long d, long e, long f) {
  number = n;
  args[0] = a; args[1] = b; args[2] = c;
  args[3] = d; args[4] = e; args[5] = f;
  ++calls;
  if (n == WAIT_SYSCALL && inspect_timeout) {
    auto *timeout = reinterpret_cast<long *>(c);
    require(timeout[0] == 0x100000001L && timeout[1] == 999999999);
    timeout[0] = 0;
  }
  return reply;
}
extern "C" int main() {
  static_assert(sizeof(sigset_t) == 8 && sizeof(siginfo_t) == 128);
  static_assert(sizeof(timespec) == 16 && sizeof(cpu_set_t) == 128);
  static_assert(TCIFLUSH == 0 && TCOFLUSH == 1 && TCIOFLUSH == 2);
  sigset_t set{{0x8000000000000001UL}};
  siginfo_t info{};
  const timespec timeout{0x100000001L, 999999999};
  inspect_timeout = true;
  reply = SIGUSR1;
  libc_errno = 77;
  require(sigtimedwait(&set, &info, &timeout) == SIGUSR1);
  require(number == WAIT_SYSCALL && args[0] == reinterpret_cast<long>(&set));
  require(args[1] == reinterpret_cast<long>(&info) && args[3] == 8);
  require(timeout.tv_sec == 0x100000001L && timeout.tv_nsec == 999999999);
  require(int(libc_errno) == 77);
  inspect_timeout = false;
  const int errors[] = {EAGAIN, EINTR, EFAULT, EINVAL, ENOSYS};
  for (int error : errors) {
    reply = -error;
    unsigned before = calls;
    require(sigtimedwait(&set, nullptr, nullptr) == -1);
    require(int(libc_errno) == error && calls == before + 1);
    require(args[1] == 0 && args[2] == 0 && args[3] == 8);
  }
  const timespec invalid[] = {{-1, 0}, {0, -1}, {0, 1000000000}};
  for (const auto &value : invalid) {
    unsigned before = calls;
    require(sigtimedwait(&set, nullptr, &value) == -1);
    require(int(libc_errno) == EINVAL && calls == before);
  }
  reply = -EFAULT;
  require(sigtimedwait(nullptr, nullptr, nullptr) == -1 && args[0] == 0);
  reply = 123;
  libc_errno = 77;
  require(getppid() == 123 && number == SYS_getppid && int(libc_errno) == 77);
  reply = 0;
  const int selectors[] = {TCIFLUSH, TCOFLUSH, TCIOFLUSH};
  for (int selector : selectors) {
    require(tcflush(7, selector) == 0 && number == SYS_ioctl);
    require(args[0] == 7 && args[1] == TCFLSH && args[2] == selector);
  }
  reply = -ENOTTY;
  require(tcflush(7, -1) == -1 && int(libc_errno) == ENOTTY && args[2] == -1);
  cpu_set_t mask;
  auto *bytes = reinterpret_cast<unsigned char *>(&mask);
  for (unsigned i = 0; i < sizeof(mask); ++i) bytes[i] = 0x5a;
  reply = 8;
  require(sched_getaffinity(0, sizeof(mask), &mask) == 0);
  require(number == SYS_sched_getaffinity && args[0] == 0 && args[1] == sizeof(mask));
  require(args[2] == reinterpret_cast<long>(&mask));
  for (unsigned i = 0; i < sizeof(mask); ++i) require(bytes[i] == (i < 8 ? 0x5a : 0));
  reply = -EINVAL;
  require(sched_getaffinity(0, 1, &mask) == -1 && int(libc_errno) == EINVAL);
  const char name[] = "process";
  reply = 0;
  require(prctl(15, reinterpret_cast<long>(name), 0L, 0L, 0L) == 0);
  require(number == SYS_prctl && args[0] == 15 && args[1] == reinterpret_cast<long>(name));
  require(args[2] == 0 && args[3] == 0 && args[4] == 0);
  reply = -EFAULT;
  require(prctl(15, 0L, 0L, 0L, 0L) == -1 && int(libc_errno) == EFAULT);
  return 0;
}
