# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../../libc %t

#--- check.py
import pathlib
import subprocess
import sys
libc, root = map(pathlib.Path, sys.argv[1:])
script = root / 'mode.cmake'
script.write_text('cmake_minimum_required(VERSION 3.20)\ninclude("' +
                  str(libc.resolve() / 'config/linux/mmix/RuntimeMode.cmake') +
                  '")\nmmix_check_runtime_mode()\n')
for shared, windows in ((False, False), (True, False), (False, True)):
    args = {'LIBC_MMIX_BUILD_ROBUST_MUTEX': 'ON',
            'LIBC_MMIX_BUILD_PROCESS_SHARED': 'ON' if shared else 'OFF',
            'LIBC_MMIX_BUILD_CANCELLATION_WINDOWS': 'ON' if windows else 'OFF'}
    result = subprocess.run(['cmake', *[f'-D{k}={v}' for k,v in args.items()],
                             '-P', str(script)], capture_output=True, text=True)
    assert result.returncode != 0
    assert 'MMIX robust mutexes require shared synchronization and cancellation windows' in result.stderr
result = subprocess.run(['cmake', '-DLIBC_CONF_THREAD_MODE=LIBC_THREAD_MODE_SINGLE',
                         '-DLIBC_CONF_ERRNO_MODE=LIBC_ERRNO_MODE_SHARED',
                         '-P', str(script)], capture_output=True, text=True)
assert result.returncode == 0, result.stderr
