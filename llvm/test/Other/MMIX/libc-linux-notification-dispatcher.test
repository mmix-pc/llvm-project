# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-thread-create.test %t/base
# RUN: split-file %S/libc-linux-synchronization.test %t/sync
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import shlex
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
flags = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
         "-DEPROTO=71", "-DFUTEX_WAIT_PRIVATE=128",
         "-DLIBC_NAMESPACE=dispatch_test", "-DLIBC_MMIX_PTHREAD_SCHEDULING",
         "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
         "-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL",
         "-I", str(root / "headers"), "-I", str(root / "base/headers"),
         "-I", str(root / "sync"), "-I", str(libc), "-I", str(libc / "include")]
source = libc / "src/__support/threads/linux/mmix/notification_dispatcher.cpp"
for opt in ("0", "2"):
    obj = root / ("dispatcher-O" + opt + ".o")
    subprocess.run(["clang", "-cc1", "-triple", "mmix-unknown-linux",
        "-internal-isystem", resource + "/include", *flags, "-O" + opt,
        "-emit-obj", str(source), "-o", str(obj)], check=True)
    symbols = subprocess.check_output(["llvm-nm", "-u", str(obj)], text=True)
    assert all(s not in symbols for s in ("pthread_", "__emutls", "__atomic_"))
    assert "create_thread_helper" in symbols and "reclaim_thread" in symbols
    if len(sys.argv) == 4:
        host = shlex.split(sys.argv[3])
        bridge = root / "bridge.o"
        subprocess.run([*host, "-std=c++17", "-pthread", "-c",
                        str(root / "bridge.cpp"), "-o", str(bridge)], check=True)
        exe = root / ("host-O" + opt)
        subprocess.run([*host, *flags, "-D__mmix__", "-O" + opt,
            "-include", str(root / "base/transport.h"), str(source),
            str(root / "test.cpp"), str(bridge), "-pthread", "-o", str(exe)], check=True)
        for mode in range(21):
            if mode == 16:
                import resource as limits
                import signal
                limits.setrlimit(limits.RLIMIT_CORE, (0, 0))
                result = subprocess.run([str(exe), str(mode)], timeout=10)
                assert result.returncode == -signal.SIGILL, result
            else:
                subprocess.run([str(exe), str(mode)], check=True, timeout=10)
        print(f"Notification dispatcher: 21 scenarios passed at O{opt}", flush=True)

# Isolated transport definitions; real UAPI layout is checked by target builds.
#--- headers/sys/syscall.h
#define SYS_eventfd2 19
#define SYS_signalfd4 74
#define SYS_socket 198
#define SYS_read 63
#define SYS_write 64
#define SYS_recvmsg 212
#define SYS_close 57
#define SYS_futex 98
#define SYS_rt_sigprocmask 135
#define SYS_ppoll 73
#--- headers/linux/fcntl.h
#define O_NONBLOCK 04000
#define O_CLOEXEC 02000000
#--- headers/linux/netlink.h
#ifndef TEST_NETLINK_H
#define TEST_NETLINK_H
struct sockaddr_nl {
  unsigned short nl_family, nl_pad;
  unsigned nl_pid, nl_groups;
};
#define NETLINK_ROUTE 0
#endif
#--- headers/linux/signalfd.h
#ifndef TEST_SIGNALFD_H
#define TEST_SIGNALFD_H
#include <stdint.h>
#define SFD_NONBLOCK 04000
#define SFD_CLOEXEC 02000000
struct signalfd_siginfo {
  uint32_t ssi_signo;
  int32_t ssi_errno, ssi_code;
  uint32_t ssi_pid, ssi_uid;
  int32_t ssi_fd;
  uint32_t ssi_tid, ssi_band, ssi_overrun, ssi_trapno;
  int32_t ssi_status, ssi_int;
  uint64_t ssi_ptr;
  unsigned char remaining[72];
};
#endif
#--- bridge.cpp
#include <chrono>
#include <thread>
static std::thread worker;
extern "C" void host_start(void (*run)()) { worker = std::thread(run); }
extern "C" void host_join() { worker.join(); }
extern "C" void host_pause() {
  std::this_thread::sleep_for(std::chrono::microseconds(100));
}

#--- test.cpp
#include "src/__support/threads/linux/mmix/notification_dispatcher.h"
#include "src/__support/threads/linux/mmix/thread_reclaim.h"
#include "include/llvm-libc-macros/poll-macros.h"
#include "hdr/types/struct_pollfd.h"
#include <linux/futex.h>
using namespace dispatch_test;
using namespace dispatch_test::mmix;
extern "C" void host_start(void (*)());
extern "C" void host_join();
extern "C" void host_pause();
static void check(bool b) { if (!b) __builtin_trap(); }
static int mode, creates, reclaims, releases, closes, sockets;
static cpp::Atomic<int> go{0}, received{0}, event_sent{0};
static cpp::Atomic<int> reads{0}, handler_entered{0}, handler_release{0}, polls{0};
static ThreadControl child;
static ThreadPreparation preparation;
static bool release_failed;

static void child_entry() {
  if (mode != 16)
    preparation.runner.posix_runner(preparation.argument);
  child.clear_tid.value.store(0);
}
namespace dispatch_test { namespace mmix {
ThreadCreationResult create_thread_helper(const ThreadPreparation &request,
    ThreadAttributes *&output, ThreadControl **control) {
  ++creates;
  check(request.detached && !request.stack && request.apply_scheduling &&
        request.scheduling_policy == 0 && request.scheduling_priority == 0);
  if (mode == 3 || mode == 14) {
    ThreadCreationResult error{-EAGAIN};
    if (mode == 14) {
      error.preparation.rollback_error = EIO;
      error.preparation.retained.stack = {8192, 8192};
    }
    return error;
  }
  preparation = request;
  child.attributes.tid = 42;
  child.clear_tid.value.store(42);
  *control = &child;
  output = &child.attributes;
  host_start(child_entry);
  return {};
}
long release_thread_resources(ThreadResources &resources) {
  ++releases;
  check(resources.stack.size == 8192);
  resources = {};
  return 0;
}
long reclaim_thread(ThreadControl &control, ThreadOwner owner,
                    ThreadResources &retained) {
  check(&control == &child && owner == ThreadOwner::Detached);
  ++reclaims;
  host_join();
  check(control.clear_tid.value.load() == 0);
  if (mode == 12 && !release_failed) {
    release_failed = true;
    retained.stack = {8192, 8192};
    return EIO;
  }
  retained = {};
  return 0;
}
}}
extern "C" long __llvm_libc_mmix_syscall(unsigned long number, long a, long b,
                                        long c, long d, long e, long f) {
  if (number == SYS_eventfd2) return mode == 1 ? -EMFILE : 50;
  if (number == SYS_signalfd4) return mode == 2 ? -ENOMEM : 51;
  if (number == SYS_socket) { ++sockets; return mode == 13 ? -EMFILE : 52; }
  if (number == SYS_close) {
    check(a >= 50 && a <= 52);
    ++closes;
    return mode == 17 ? -EINTR : 0;
  }
  if (number == SYS_rt_sigprocmask) {
    if (mode == 15) return -EIO;
    *reinterpret_cast<uint64_t *>(c) = mode == 4 ? 0 : UINT64_MAX & ~(uint64_t(1) << 32);
    return 0;
  }
  if (number == SYS_futex) {
    if (b == FUTEX_WAKE_PRIVATE) return 0;
    host_pause();
    return -EAGAIN;
  }
  if (number == SYS_write) {
    check(a == 50 && c == 8 && *reinterpret_cast<uint64_t *>(b) == 1);
    return mode == 11 ? -EIO : 8;
  }
  if (number == SYS_ppoll) {
    auto *fds = reinterpret_cast<pollfd *>(a);
    check(b == 3 && fds[0].fd == 50 && fds[1].fd == 51);
    host_pause();
    polls.fetch_add(1);
    if (!go.load()) return 0;
    if (mode == 5) return -EIO;
    if (mode == 10 && !event_sent.exchange(1)) return -EINTR;
    if ((mode == 19 || mode == 20) && !reads.load()) {
      fds[1].revents = POLLIN;
      return 1;
    }
    if ((mode == 6 || mode == 9 || mode == 10) && event_sent.exchange(2) < 2) {
      fds[1].revents = POLLIN;
      return 1;
    }
    if ((mode == 7 || mode == 8) && fds[2].fd == 52 && !event_sent.exchange(1)) {
      fds[2].revents = POLLIN;
      return 1;
    }
    return 0;
  }
  if (number == SYS_read) {
    check(a == 51 && c == 128);
    reads.fetch_add(1);
    if (mode == 9) return 127;
    auto &info = *reinterpret_cast<signalfd_siginfo *>(b);
    info = {};
    info.ssi_signo = 34; info.ssi_code = SI_TIMER;
    info.ssi_tid = 7; info.ssi_ptr = 123; info.ssi_overrun = 9;
    return 128;
  }
  if (number == SYS_recvmsg) {
    check(a == 52 && c == MSG_DONTWAIT);
    auto &msg = *reinterpret_cast<msghdr *>(b);
    auto &source = *static_cast<sockaddr_nl *>(msg.msg_name);
    source = {AF_NETLINK, 0, 0, 0};
    auto &cookie = *static_cast<unsigned char (*)[32]>(msg.msg_iov[0].iov_base);
    check(notification_transport::encode_mq_cookie(456, cookie));
    cookie[31] = notification_transport::MQ_WOKENUP;
    return 32;
  }
  check(false);
  return -ENOSYS;
}
static int timer(void *context, const signalfd_siginfo &info) {
  check(context == &child && info.ssi_ptr == 123 && info.ssi_tid == 7);
  if (mode == 19) {
    handler_entered.store(1);
    while (!handler_release.load()) host_pause();
  }
  received.fetch_add(1);
  return 0;
}
static int mq(void *context, const notification_transport::Notification &event) {
  check(context == &child && event.token == 456 &&
        event.event == notification_transport::Event::MqWokenUp);
  received.fetch_add(1);
  return mode == 8 ? EIO : 0;
}
extern "C" int main(int argc, char **argv) {
  check(argc == 2);
  for (char *p = argv[1]; *p; ++p) mode = mode * 10 + *p - '0';
  NotificationDispatcher dispatcher;
  NotificationHandlers handlers{&child, timer, mq};
  if (mode == 18) {
    {
      NotificationDispatcher::Operation first(dispatcher), second(dispatcher);
      check(bool(first) && bool(second) && !dispatcher.try_park());
    }
    check(dispatcher.try_park() && !dispatcher.try_park());
    {
      NotificationDispatcher::Operation rejected(dispatcher);
      check(!rejected);
    }
    dispatcher.resume();
    check(dispatcher.try_park());
    dispatcher.resume();
    return 0;
  }
  check(dispatcher.start({}, 4096, handlers) == EINVAL && dispatcher.drained());
  check(dispatcher.enable_mq() == EINVAL);
  int error = dispatcher.start({}, 8192, handlers);
  if (mode == 1 || mode == 2 || mode == 3 || mode == 4 || mode == 14 || mode == 15) {
    check(error == (mode == 1 ? EMFILE : mode == 2 ? ENOMEM : mode == 4 ? EPROTO :
                    mode == 15 ? EIO : EAGAIN));
    if (mode == 14) {
      check(!dispatcher.drained());
      check(dispatcher.start({}, 8192, handlers) == EBUSY);
    }
    check(dispatcher.stop() == 0 && dispatcher.drained());
    check(reclaims == (mode == 4 || mode == 15 ? 1 : 0));
    check(closes == (mode == 1 ? 0 : mode == 2 ? 1 : 2));
    check(releases == (mode == 14 ? 1 : 0));
    return 0;
  }
  check(error == 0 && dispatcher.timer_tid() == 42);
  check(dispatcher.start({}, 8192, handlers) == EBUSY);
  check(dispatcher.enable_mq() == (mode == 13 ? EMFILE : mode == 11 ? EIO : 0));
  if (mode != 13) {
    check(dispatcher.mq_fd() == 52);
    check(dispatcher.enable_mq() == (mode == 11 ? EIO : 0));
    check(sockets == 1);
  }
  if (mode == 20) {
    bool parked = false;
    for (unsigned n = 0; n < 20000 && !parked; ++n) {
      parked = dispatcher.try_park();
      if (!parked) host_pause();
    }
    check(parked);
    check(dispatcher.enable_mq() == EAGAIN);
    check(dispatcher.start({}, 8192, handlers) == EAGAIN);
    check(dispatcher.stop() == EAGAIN && !reclaims && !closes);
    int before = polls.load();
    go.store(1);
    for (unsigned n = 0; n < 20000 && polls.load() < before + 10; ++n)
      host_pause();
    check(polls.load() >= before + 10 && !reads.load() && !received.load());
    check(dispatcher.timer_tid() == 42 && child.clear_tid.value.load() == 42);
    dispatcher.resume();
  }
  go.store(1);
  if (mode == 19) {
    for (unsigned n = 0; n < 20000 && !handler_entered.load(); ++n) host_pause();
    check(handler_entered.load() && !dispatcher.try_park());
    handler_release.store(1);
  }
  if (mode == 19 || mode == 20) {
    for (unsigned n = 0; n < 20000 && !received.load(); ++n) host_pause();
    check(received.load() == 1 && reads.load() == 1);
  }
  if (mode >= 5 && mode <= 10) {
    for (unsigned n = 0; n < 20000 && !dispatcher.error() && !received.load(); ++n)
      host_pause();
    if (mode == 5 || mode == 8 || mode == 9) {
      for (unsigned n = 0; n < 20000 && !dispatcher.error(); ++n) host_pause();
      check(dispatcher.error() == (mode == 9 ? EPROTO : EIO));
      // Failure closes intake, not the published kernel-task lifetime. Delay
      // while a hypothetical registration still owns the external service gate.
      for (unsigned n = 0; n < 20; ++n) host_pause();
      check(child.clear_tid.value.load() == 42 && dispatcher.timer_tid() == 42);
      check(dispatcher.enable_mq() == dispatcher.error());
    } else check(received.load() == 1);
  }
  check(dispatcher.stop() == (mode == 11 || mode == 12 ? EIO : mode == 17 ? EINTR : 0));
  check(closes == (mode == 13 ? 2 : 3) && reclaims == 1);
  check(dispatcher.drained() == (mode != 12));
  check(dispatcher.stop() == 0 && dispatcher.drained());
  check(reclaims == 1 && closes == (mode == 13 ? 2 : 3));
  check(releases == (mode == 12 ? 1 : 0));
  return 0;
}
