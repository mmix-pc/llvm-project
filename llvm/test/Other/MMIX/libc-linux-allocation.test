# REQUIRES: mmix-registered-target
# RUN: split-file %S/libc-linux-heap-mapping.test %t/mapping
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
mapping = root / "mapping"
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
sources = [libc / ("src/stdlib/linux/mmix/" + name + ".cpp")
           for name in ("allocator", "malloc", "free")]
sources += [libc / "src/__support/OSUtil/linux/mmix/heap.cpp",
            libc / "src/__support/freelist.cpp", libc / "src/__support/freetrie.cpp",
            libc / "src/errno/libc_errno.cpp"]
defines = ["-DLIBC_FULL_BUILD", "-DLIBC_NAMESPACE=allocation_test", "-DNDEBUG",
           "-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_SHARED"]
includes = ["-I", str(mapping / "headers"), "-I", str(libc), "-I", str(libc / "include")]
base = ["clang", "-cc1", "-std=c++17", "-ffreestanding", "-triple", "mmix-unknown-linux",
        "-mrelocation-model", "static", "-internal-isystem", resource + "/include",
        *includes, *defines, "-DLIBC_COPT_PUBLIC_PACKAGING", "-stack-protector", "2"]
for opt in ("0", "2"):
    objects = []
    for index, source in enumerate(sources):
        obj = root / (str(index) + "-O" + opt + ".o")
        subprocess.run(base + ["-O" + opt, "-emit-obj", "-o", str(obj), str(source)], check=True)
        objects.append(str(obj))
    combined = root / ("allocation-O" + opt + ".o")
    subprocess.run(["ld.lld", "-r", *objects, "-o", str(combined)], check=True)
    undefined = subprocess.check_output(["llvm-nm", "-u", str(combined)], text=True)
    for name in ("__llvm_libc_mmix_syscall", "__stack_chk_guard", "__stack_chk_fail"):
        assert name in undefined, undefined
    for name in ("pthread_", "__tls_get_addr", "__atomic_", "freelist_heap", "_end"):
        assert name not in undefined, undefined
    defined = subprocess.check_output(["llvm-nm", "--defined-only", str(combined)], text=True)
    for name in ("malloc", "free"):
        assert sum(line.split()[-1] == name for line in defined.splitlines() if line.split()) == 1
    elf = subprocess.check_output(["llvm-readobj", "--sections", str(combined)], text=True)
    assert "SHF_TLS" not in elf and ".init_array" not in elf

# Native semantics are explicitly selected by the validation caller, not a
# target execution result. Do not override the native process's malloc/free.
if len(sys.argv) == 4:
    for opt in ("0", "2"):
        exe = root / ("native-O" + opt)
        subprocess.run([sys.argv[3], "-std=c++17", "-O" + opt,
            "-I", str(mapping / "fake"), *includes, *defines,
            *map(str, sources), str(root / "test.cpp"), "-o", str(exe)], check=True)
        subprocess.run([str(exe)], check=True)

#--- test.cpp
#include "src/stdlib/malloc.h"
#include "src/stdlib/free.h"
#include "src/__support/libc_errno.h"
#include "src/__support/error_or.h"
#include "hdr/types/off_t.h"
#include <stddef.h>
#include "hdr/stdint_proxy.h"

alignas(8192) unsigned char pages[4][131072];
bool used[4];
int maps, releases;
bool fail_map, fail_unmap;
size_t last_request;

namespace allocation_test::linux_syscalls {
ErrorOr<void *> mmap(void *, size_t size, int, int, int, off_t) {
  ++maps;
  last_request = size;
  if (fail_map || size > sizeof(pages[0]))
    return Error(ENOMEM);
  for (int i = 0; i != 4; ++i)
    if (!used[i]) {
      used[i] = true;
      return static_cast<void *>(pages[i]);
    }
  return Error(ENOMEM);
}
ErrorOr<int> munmap(void *address, size_t) {
  ++releases;
  if (fail_unmap)
    return Error(EINVAL);
  for (int i = 0; i != 4; ++i)
    if (address == pages[i]) {
      used[i] = false;
      // Poison released metadata to expose reads after unmap.
      for (unsigned char &byte : pages[i])
        byte = 0xa5;
      return 0;
    }
  return Error(EINVAL);
}
}

int main() {
  using allocation_test::malloc;
  using allocation_test::free;
  libc_errno = 17;
  free(nullptr);
  if (malloc(0) || int(libc_errno) != 17 || maps || releases)
    return 1;
  auto *a = static_cast<unsigned char *>(malloc(64));
  auto *b = static_cast<unsigned char *>(malloc(64));
  if (!a || !b || a == b || maps != 1 || int(libc_errno) != 17 ||
      reinterpret_cast<uintptr_t>(a) % alignof(max_align_t))
    return 2;
  a[0] = 1;
  b[0] = 2;
  free(a);
  a = static_cast<unsigned char *>(malloc(64));
  if (!a || maps != 1 || releases || b[0] != 2)
    return 3;
  void *large = malloc(20000);
  if (!large || maps != 2 || a == large || b == large)
    return 4;
  free(b);
  free(a);
  if (releases != 1 || int(libc_errno) != 17)
    return 5;
  fail_unmap = true;
  free(large);
  int calls = maps;
  void *again = malloc(20000);
  if (!again || maps != calls || int(libc_errno) != 17)
    return 6;
  fail_unmap = false;
  free(again);
  fail_map = true;
  calls = maps;
  if (malloc(1000) || int(libc_errno) != ENOMEM || maps != calls + 1)
    return 7;
  fail_map = false;
  calls = maps;
  if (malloc(static_cast<size_t>(-1)) || maps != calls || int(libc_errno) != ENOMEM)
    return 8;
  if (malloc(1000000) || last_request < 1000000)
    return 9;
  for (bool live : used)
    if (live)
      return 10;
  return 0;
}
