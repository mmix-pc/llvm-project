# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: cmake -DSOURCE=%S/../../../.. -P %t/check.cmake
# RUN: %python %t/run.py %S/../../../../libc %t

#--- check.cmake
cmake_minimum_required(VERSION 3.20)
set(TARGET_LIBC_ENTRYPOINTS sentinel)
include(${SOURCE}/libc/config/linux/mmix/Poll.cmake)
if(NOT "${TARGET_LIBC_ENTRYPOINTS}" STREQUAL "sentinel")
  message(FATAL_ERROR "poll providers must be opt-in")
endif()
set(LIBC_MMIX_BUILD_POLL ON)
include(${SOURCE}/libc/config/linux/mmix/Poll.cmake)
if(NOT "${TARGET_LIBC_ENTRYPOINTS}" STREQUAL "sentinel;libc.src.poll.poll;libc.src.poll.ppoll")
  message(FATAL_ERROR "unexpected polling provider selection")
endif()

#--- run.py
import pathlib
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
common = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
          "-DLIBC_ERRNO_MODE=3", "-DLIBC_NAMESPACE=poll_test",
          "-I", str(root), "-I", str(libc)]
for opt in ("0", "2"):
    subprocess.run(["clang", "-cc1", "-triple", "mmix-unknown-linux",
                    "-mrelocation-model", "static", "-internal-isystem",
                    resource + "/include", *common, "-O" + opt, "-emit-obj",
                    str(root / "semantics.cpp"),
                    "-o", str(root / ("target-O" + opt + ".o"))], check=True)
    if len(sys.argv) == 4:
        for mode in ("legacy", "time64"):
            exe = root / ("native-" + mode + "-O" + opt)
            subprocess.run([sys.argv[3], *common, "-O" + opt,
                            *( ["-DSYS_ppoll_time64=414"] if mode == "time64" else []),
                            "-include", str(root / "native-boundary.h"),
                            str(root / "semantics.cpp"), "-o", str(exe)], check=True)
            subprocess.run([str(exe)], check=True, timeout=30)

#--- native-boundary.h
#include "src/__support/macros/properties/architectures.h"
#undef LIBC_TARGET_ARCH_IS_X86_64
#undef LIBC_TARGET_ARCH_IS_X86_32
#undef LIBC_TARGET_ARCH_IS_AARCH64
#define LIBC_TARGET_ARCH_IS_MMIX
#define __mmix__ 1

#--- sys/syscall.h
#define SYS_ppoll 73

#--- linux/errno.h
#define EINTR 4
#define EFAULT 14
#define EINVAL 22
#define ENOMEM 12
#define EOVERFLOW 75
#define ENOSYS 38

#--- semantics.cpp
#include "src/poll/linux/poll.cpp"
#include "src/poll/linux/ppoll.cpp"
#include "src/errno/libc_errno.cpp"

using namespace poll_test;
static void require(bool ok) { if (!ok) __builtin_trap(); }
static unsigned long number;
static long args[6], reply;
static unsigned calls;
static long long seconds, nanos;
static const timespec *public_timeout;
extern "C" long __llvm_libc_mmix_syscall(unsigned long n, long a, long b,
                                        long c, long d, long e, long f) {
  number = n;
  args[0] = a; args[1] = b; args[2] = c;
  args[3] = d; args[4] = e; args[5] = f;
  ++calls;
  if (c) {
    require(c != reinterpret_cast<long>(public_timeout));
    long long time[2];
    __builtin_memcpy(time, reinterpret_cast<void *>(c), sizeof(time));
    seconds = time[0]; nanos = time[1];
    time[0] = 0; time[1] = 0;
    __builtin_memcpy(reinterpret_cast<void *>(c), time, sizeof(time));
  }
  if (a && b && reply > 0)
    reinterpret_cast<pollfd *>(a)->revents = 1;
  return reply;
}

int main() {
  static_assert(sizeof(pollfd) == 8 && sizeof(nfds_t) == 4);
  pollfd fd{7, 1, 0};
  const int timeouts[] = {-2147483647 - 1, -1, 0, 1, 999, 1000, 2147483647};
  for (int timeout : timeouts) {
    reply = 1;
    libc_errno = 77;
    require(poll(&fd, 1, timeout) == 1 && fd.revents == 1 && int(libc_errno) == 77);
    require(args[0] == reinterpret_cast<long>(&fd) && args[1] == 1);
    require(args[3] == 0 && args[4] == 0 && args[5] == 0);
    if (timeout < 0) require(args[2] == 0);
    else require(args[2] && seconds == timeout / 1000 && nanos == (timeout % 1000) * 1000000LL);
  }
  sigset_t mask{{0x8000000000000001UL}};
  timespec timeout{2147483648LL, 999999999};
  public_timeout = &timeout;
  const int errors[] = {0, EINTR, EFAULT, EINVAL, ENOMEM, ENOSYS};
  for (int error : errors) {
    reply = -error;
    libc_errno = 77;
    unsigned before = calls;
    require(ppoll(&fd, 1, &timeout, &mask) == (error ? -1 : 0));
    require(calls == before + 1 && int(libc_errno) == (error ? error : 77));
    require(args[3] == reinterpret_cast<long>(&mask) && args[4] == 8 && args[5] == 0);
    require(seconds == 2147483648LL && nanos == 999999999);
    require(timeout.tv_sec == 2147483648LL && timeout.tv_nsec == 999999999);
    require(mask.__signals[0] == 0x8000000000000001UL);
    before = calls;
    require(poll(&fd, 1, 0) == (error ? -1 : 0) && calls == before + 1);
  }
  const timespec invalid[] = {{-1, 0}, {0, -1}, {0, 1000000000}};
  for (auto value : invalid) {
    unsigned before = calls;
    require(ppoll(&fd, 1, &value, nullptr) == -1 && int(libc_errno) == EINVAL);
    require(calls == before);
  }
  reply = 1;
  require(ppoll(&fd, 1, nullptr, nullptr) == 1);
  require(args[2] == 0 && args[3] == 0 && args[4] == 8);
  reply = -EFAULT;
  require(ppoll(nullptr, 1, nullptr, reinterpret_cast<sigset_t *>(-1L)) == -1);
  require(args[0] == 0 && args[3] == -1 && int(libc_errno) == EFAULT);
#ifdef SYS_ppoll_time64
  require(number == 414);
#else
  require(number == 73);
#endif
  return 0;
}
