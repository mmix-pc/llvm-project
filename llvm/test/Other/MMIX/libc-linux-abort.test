# REQUIRES: mmix-registered-target
# RUN: split-file %S/libc-linux-sigaction.test %t
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../../libc %t

#--- sys/syscall.h
// Independently checked against exported MMIX Linux UAPI.
#define SYS_write 64
#define SYS_exit 93
#define SYS_exit_group 94
#define SYS_tgkill 131
#define SYS_rt_sigaction 134
#define SYS_rt_sigprocmask 135
#define SYS_getpid 172
#define SYS_gettid 178

#--- check.py
import pathlib
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
common = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
          "-DLIBC_NAMESPACE=abort_test", "-I", str(root), "-I", str(libc)]
sources = [libc / "src/stdlib/abort.cpp", libc / "src/assert/generic/__assert_fail.cpp",
           libc / "src/__support/OSUtil/linux/exit.cpp"]
for opt in ("0", "2"):
    for source in [*sources, root / "semantics.cpp"]:
        obj = root / (source.stem + opt + ".o")
        subprocess.run(["clang", "-cc1", "-triple", "mmix-unknown-linux",
                        "-mrelocation-model", "static", "-internal-isystem",
                        resource + "/include", *common, "-O" + opt, "-emit-obj",
                        str(source), "-o", str(obj)], check=True)
        names = subprocess.check_output(["llvm-nm", "-u", str(obj)], text=True)
        assert all(name not in names for name in
                   ("vdso", "__restore_rt", "RawRwLock", "current_thread", "atexit"))
        if source in sources:
            assert "__llvm_libc_mmix_syscall" in names
    if len(sys.argv) == 4:
        exe = root / ("native" + opt)
        subprocess.run([sys.argv[3], *common, "-O" + opt, "-include",
                        str(root / "native-boundary.h"), str(root / "semantics.cpp"),
                        "-o", str(exe)], check=True)
        for entry in ("abort", "assert"):
            for mask in ("clear", "blocked"):
                for failure in range(-1, 14):
                    subprocess.run([str(exe), entry, mask, str(failure)], check=True,
                                   timeout=30)

#--- semantics.cpp
// Run real abort/assert/exit algorithms; substitute only syscall transport.
#include "src/stdlib/abort.cpp"
#include "src/assert/generic/__assert_fail.cpp"
#include "src/__support/OSUtil/linux/exit.cpp"

extern "C" [[noreturn]] void _Exit(int);
using namespace abort_test;
static void require(bool ok) { if (!ok) __builtin_trap(); }
static constexpr unsigned long ABRT_MASK = 1UL << (SIGABRT - 1);
static unsigned long mask, saved_mask;
static int failure, count, size, writes;
static bool assertion;
static char message[256];
static unsigned message_size;
static const char expected_message[] =
    "source.cpp:17: Assertion failed: 'false' in function: 'caller'\n";
struct Event { long nr, operation, reply; };
static Event events[20];
static void add(int slot, long nr, long operation, long reply = 0) {
  events[size++] = {nr, operation, failure == slot ? -22 : reply};
}
static void add_raise(int base) {
  add(base, SYS_rt_sigprocmask, SIG_BLOCK);
  if (failure == base) return;
  add(base + 1, SYS_getpid, 0, 101);
  if (failure != base + 1) {
    add(base + 2, SYS_gettid, 0, 202);
    if (failure != base + 2)
      add(base + 3, SYS_tgkill, 0);
  }
  add(base + 4, SYS_rt_sigprocmask, SIG_SETMASK);
}
extern "C" long __llvm_libc_mmix_syscall(unsigned long nr, long a, long b,
                                        long c, long d, long e, long f) {
  require(!e && !f);
  if (nr == SYS_write) {
    require(assertion && !count && a == 2 && !d && c >= 0);
    ++writes;
    auto *text = reinterpret_cast<const char *>(b);
    for (long i = 0; i < c; ++i) {
      require(message_size + 1 < sizeof(message));
      message[message_size++] = text[i];
    }
    // A failed diagnostic write must not prevent abnormal termination.
    return failure == 13 ? -22 : c;
  }
  require(count < size);
  Event event = events[count++];
  require(nr == static_cast<unsigned long>(event.nr));
  if (nr == SYS_rt_sigprocmask) {
    require(a == event.operation && b && d == 8);
    auto bits = reinterpret_cast<const sigset_t *>(b)->__signals[0];
    if (a == SIG_BLOCK) {
      require(bits == ~0UL);
      if (c) {
        saved_mask = mask;
        if (!event.reply)
          reinterpret_cast<sigset_t *>(c)->__signals[0] = mask;
      }
      if (!event.reply) mask |= bits;
    } else if (a == SIG_SETMASK) {
      require(!c && bits == saved_mask);
      if (!event.reply) mask = bits;
    } else {
      require(a == SIG_UNBLOCK && !c && bits == ABRT_MASK);
      if (!event.reply) mask &= ~bits;
    }
  } else if (nr == SYS_getpid || nr == SYS_gettid) {
    require(!a && !b && !c && !d);
  } else if (nr == SYS_tgkill) {
    require(a == 101 && b == 202 && c == SIGABRT && !d);
    // Returning/ignored/blocked delivery is deliberately allowed by this double.
  } else if (nr == SYS_rt_sigaction) {
    require(a == SIGABRT && b && !c && d == 8);
    auto &action = *reinterpret_cast<const mmix::KernelSigaction *>(b);
    require(action.sa_handler == SIG_DFL && !action.sa_flags &&
            !action.sa_mask && !action.sa_restorer);
    if (failure != 5) require(mask == ~0UL);
  } else {
    require((nr == SYS_exit_group || nr == SYS_exit) && a == 127 &&
            !b && !c && !d);
    if (count == size) {
      if (assertion) {
        require(writes && message_size == sizeof(expected_message) - 1);
        for (unsigned i = 0; i != message_size; ++i)
          require(message[i] == expected_message[i]);
      } else require(!writes);
      _Exit(0);
    }
  }
  return event.reply;
}
int main(int argc, char **argv) {
  require(argc == 4);
  assertion = argv[1][1] == 's';
  mask = argv[2][0] == 'b' ? ABRT_MASK : 0;
  failure = argv[3][0] == '-' ? -1 : argv[3][0] - '0';
  if (failure >= 0 && argv[3][1]) failure = failure * 10 + argv[3][1] - '0';
  add_raise(0);
  add(5, SYS_rt_sigprocmask, SIG_BLOCK);
  add(6, SYS_rt_sigaction, 0);
  add_raise(7);
  add(12, SYS_rt_sigprocmask, SIG_UNBLOCK);
  // Failed final syscalls must retry rather than return, run handlers or trap.
  add(-2, SYS_exit_group, 0, -22);
  add(-2, SYS_exit, 0, -22);
  add(-2, SYS_exit_group, 0, -22);
  if (assertion)
    abort_test::__assert_fail("false", "source.cpp", 17, "caller");
  abort_test::abort();
}
