# RUN: split-file %s %t
# RUN: cmake -S %t -B %t/linux -DLIBC_SOURCE=%S/../../../../libc -DTEST_OS=linux -DTEST_MMIX=ON
# RUN: cmake -S %t -B %t/generic -DLIBC_SOURCE=%S/../../../../libc -DTEST_OS=baremetal -DTEST_MMIX=ON
# RUN: cmake -S %t -B %t/other-linux -DLIBC_SOURCE=%S/../../../../libc -DTEST_OS=linux -DTEST_MMIX=OFF
# RUN: cmake -S %t -B %t/other-generic -DLIBC_SOURCE=%S/../../../../libc -DTEST_OS=baremetal -DTEST_MMIX=OFF

# Exercise real registration decisions without requiring a complete libc build.
#--- CMakeLists.txt
cmake_minimum_required(VERSION 3.20)
project(CheckPlatformSelection NONE)
set(LIBC_TARGET_OS ${TEST_OS})
set(LIBC_TARGET_ARCHITECTURE_IS_MMIX ${TEST_MMIX})
set(LLVM_LIBC_FULL_BUILD ON)
if(TEST_OS STREQUAL "baremetal")
  set(LIBC_TARGET_OS_IS_BAREMETAL ON)
endif()
function(add_object_library)
endfunction()
function(add_entrypoint_external)
endfunction()
function(add_header_library name)
  if(name STREQUAL "abort_utils")
    cmake_parse_arguments(ARG "" "" "DEPENDS;HDRS" ${ARGN})
    set_property(GLOBAL PROPERTY abort_dependency "${ARG_DEPENDS}")
  endif()
endfunction()
function(add_entrypoint_object name)
  if(name STREQUAL "wide_stream")
    cmake_parse_arguments(ARG "" "" "DEPENDS;SRCS" ${ARGN})
    if(NOT "libc.src.__support.OSUtil.baremetal.mmix.platform_io" IN_LIST ARG_DEPENDS)
      message(FATAL_ERROR "wide-stream platform dependency missing")
    endif()
    set_property(GLOBAL PROPERTY have_wide_stream ON)
  endif()
endfunction()
function(add_subdirectory name)
  # Only descend into the relevant platform leaf, retaining its real dependencies.
  if(name STREQUAL "baremetal/mmix")
    include(${LIBC_SOURCE}/src/wchar/${name}/CMakeLists.txt)
  endif()
endfunction()
include(${LIBC_SOURCE}/src/stdlib/CMakeLists.txt)
include(${LIBC_SOURCE}/src/wchar/CMakeLists.txt)
get_property(abort_dependency GLOBAL PROPERTY abort_dependency)
get_property(have_wide_stream GLOBAL PROPERTY have_wide_stream)
set(expected_abort .${TEST_OS}.abort_utils)
if(TEST_MMIX AND LIBC_TARGET_OS_IS_BAREMETAL)
  set(expected_abort .baremetal.mmix.abort_utils)
  if(NOT have_wide_stream)
    message(FATAL_ERROR "missing MMIX bare-metal wide streams")
  endif()
elseif(have_wide_stream)
  message(FATAL_ERROR "bare-metal streams leaked into another platform")
endif()
if(NOT abort_dependency STREQUAL expected_abort)
  message(FATAL_ERROR "incorrect abort dependency: ${abort_dependency}")
endif()
