# REQUIRES: mmix-native-linux-host
# RUN: rm -rf %t
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../.. %t %mmix_host_cxx

# Native configure-only fixtures inspect deferred target wiring, not signal
# execution or provider qualification. No runtime targets are built.
#--- CMakeLists.txt
cmake_minimum_required(VERSION 3.20)
project(SignalCancellation CXX)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mmix)
set(CMAKE_CXX_COMPILER_TARGET mmix-unknown-linux)
set(LIBUNWIND_ENABLE_THREADS ON)
set(LIBUNWIND_IS_NATIVE_ONLY ON)
set(LIBUNWIND_REMEMBER_HEAP_ALLOC ON)
set(LIBUNWIND_ADDITIONAL_COMPILE_FLAGS
  -D_LIBUNWIND_MMIX_LINUX_THREADS ${LEGACY_FLAGS})
if(PROFILE STREQUAL "shared")
  set(MMIX_LINUX_SHARED_RUNTIME_VALIDATED TRUE)
  set(LIBUNWIND_ENABLE_SHARED ON)
  set(LIBUNWIND_ENABLE_STATIC OFF)
  list(APPEND LIBUNWIND_ADDITIONAL_COMPILE_FLAGS -D_LIBUNWIND_MMIX_STARTUP_IMAGES)
else()
  set(MMIX_LINUX_THREADED_RUNTIME_VALIDATED TRUE)
  set(LIBUNWIND_ENABLE_STATIC ON)
  set(LIBUNWIND_ENABLE_SHARED OFF)
endif()
if(OPTION)
  set(${OPTION} "${VALUE}")
endif()
set(original_flags "${LIBUNWIND_ADDITIONAL_COMPILE_FLAGS}")
include("${SOURCE}/libunwind/src/mmix/SignalCancellation.cmake")
include("${SOURCE}/libunwind/src/mmix/SignalCancellation.cmake")
if(PROFILE STREQUAL "shared")
  include("${SOURCE}/libunwind/src/mmix/Shared.cmake")
endif()

# Match upstream: targets are created in a child directory after the hook;
# static objects exist even when the selected profile is shared-only.
add_subdirectory(objects)
function(report)
  foreach(kind static shared)
    foreach(property SOURCES COMPILE_DEFINITIONS INTERFACE_COMPILE_DEFINITIONS COMPILE_OPTIONS)
      get_target_property(value unwind_${kind}_objects ${property})
      if(NOT value)
        set(value "")
      endif()
      file(WRITE "${CMAKE_BINARY_DIR}/${kind}-${property}.txt" "${value}")
    endforeach()
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/flags.txt" "${LIBUNWIND_ADDITIONAL_COMPILE_FLAGS}")
  file(WRITE "${CMAKE_BINARY_DIR}/original-flags.txt" "${original_flags}")
  get_property(value CACHE LIBUNWIND_MMIX_SIGNAL_CANCELLATION PROPERTY VALUE)
  file(WRITE "${CMAKE_BINARY_DIR}/option.txt" "${value}")
endfunction()
cmake_language(DEFER CALL report)

#--- objects/CMakeLists.txt
foreach(kind static shared)
  if(NOT OMIT_TARGET STREQUAL "unwind_${kind}_objects")
    add_library(unwind_${kind}_objects OBJECT dummy.cpp)
    target_compile_definitions(unwind_${kind}_objects PRIVATE SENTINEL)
    target_compile_options(unwind_${kind}_objects PUBLIC "${LIBUNWIND_ADDITIONAL_COMPILE_FLAGS}")
  endif()
  if(NOT OMIT_TARGET STREQUAL "unwind_${kind}")
    string(TOUPPER "${kind}" type)
    add_library(unwind_${kind} ${type} IMPORTED GLOBAL)
  endif()
endforeach()

#--- objects/dummy.cpp
int sentinel;

#--- check.py
from pathlib import Path
import shlex
import subprocess
import sys

source, root = (Path(p).resolve() for p in sys.argv[1:3])
compiler = ";".join(shlex.split(sys.argv[3]))
cursor = "-D_LIBUNWIND_MMIX_CURSOR_LIFETIME"
policy = "-D_LIBUNWIND_USE_METADATA_POLICY"
threads = "-D_LIBUNWIND_MMIX_LINUX_THREADS"
startup = "-D_LIBUNWIND_MMIX_STARTUP_IMAGES"
counter = 0


def configure(profile, enabled=None, legacy=(), lifetime=False, metadata=False,
              error=None, option=None, value=None, omit=None, build=None):
    global counter
    counter += 1
    build = build or root / str(counter)
    args = ["cmake", "-S", str(root), "-B", str(build),
            "-DCMAKE_CXX_COMPILER=" + compiler, "-DSOURCE=" + str(source),
            "-DPROFILE=" + profile, "-DLEGACY_FLAGS=" + ";".join(legacy)]
    if enabled is not None:
        args += ["-DLIBUNWIND_MMIX_SIGNAL_CANCELLATION=" + enabled]
    if option:
        args += ["-DOPTION=" + option, "-DVALUE=" + value]
    if omit:
        args += ["-DOMIT_TARGET=" + omit]
    result = subprocess.run(args, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT)
    output = " ".join(result.stdout.split())
    if error:
        assert result.returncode and error in output, output
        return
    assert result.returncode == 0, output

    def values(name):
        return [v for v in (build / (name + ".txt")).read_text().split(";") if v]

    assert values("option") == [enabled or "OFF"]
    flags = values("original-flags")
    if profile == "shared" and enabled == "ON" and policy not in flags:
        flags.append(policy)
    assert values("flags") == flags
    for kind in ("static", "shared"):
        selected = kind == profile
        expected = ["dummy.cpp"]
        if kind == "shared" and selected:
            expected += ["StartupImages.cpp", "CursorLifetime.cpp"]
        elif selected and lifetime:
            expected += ["CursorLifetime.cpp"]
        if selected and metadata:
            expected += ["ForcedContext.cpp", "UnwindMetadataPolicy.cpp"]
        actual = values(kind + "-SOURCES")
        assert sorted(Path(p).name for p in actual) == sorted(expected), actual
        for path in actual:
            if path != "dummy.cpp":
                assert Path(path).is_absolute() and Path(path).is_file(), path
        definitions = ["SENTINEL"]
        if kind == "static" and selected:
            if lifetime:
                definitions.append(cursor[2:])
            if metadata:
                definitions.append(policy[2:])
        assert values(kind + "-COMPILE_DEFINITIONS") == definitions
        assert values(kind + "-INTERFACE_COMPILE_DEFINITIONS") == []
        assert values(kind + "-COMPILE_OPTIONS") == flags
    exports = build / "mmix-shared-unwind.exports"
    assert exports.exists() == (profile == "shared")
    if exports.exists():
        exports = exports.read_text()
        assert "__libunwind_mmix_adopt_startup_images;" in exports
        for name in ("enter", "commit", "leave", "current"):
            assert ("__unw_metadata_policy_" + name + ";" in exports) == metadata
        for name in ("cursor_checkpoint", "cursor_at_checkpoint", "cursor_finish_at",
                     "init_saved_cursor", "forcedunwind_from_context"):
            assert ("__libunwind_mmix_" + name + ";" in exports) == metadata
        assert "__unw_init_local_current;" not in exports
    return build


for profile in ("static", "shared"):
    configure(profile)
    configure(profile, "OFF")
    build = configure(profile, "ON", lifetime=True, metadata=True)
    configure(profile, "OFF", build=build)
    configure(profile, "OFF", legacy=[policy], lifetime=True, metadata=True)
    configure(profile, "OFF", legacy=[cursor, policy], lifetime=True, metadata=True)
    configure(profile, "ON", legacy=[cursor, policy], lifetime=True, metadata=True)
    configure(profile, "OFF", legacy=[cursor], lifetime=True)
    for target in ("unwind_" + profile, "unwind_" + profile + "_objects"):
        configure(profile, "ON", omit=target,
                  error="requires the upstream " + profile + " targets")
    for option, value in (("CMAKE_SYSTEM_NAME", "Generic"),
                          ("CMAKE_SYSTEM_PROCESSOR", "x86_64"),
                          ("CMAKE_CXX_COMPILER_TARGET", "mmix-unknown-unknown")):
        configure(profile, "ON", option=option, value=value,
                  error="requires the MMIX Linux target")
    for option in ("LIBUNWIND_ENABLE_THREADS", "LIBUNWIND_IS_NATIVE_ONLY",
                   "LIBUNWIND_REMEMBER_HEAP_ALLOC"):
        configure(profile, "ON", option=option, value="OFF",
                  error="requires " + option + "=ON")
    for option in ("LIBUNWIND_IS_BAREMETAL", "LIBUNWIND_USE_FRAME_HEADER_CACHE"):
        configure(profile, "ON", option=option, value="ON", error="rejects " + option)
    for option, value in (("MMIX_LINUX_" + ("THREADED" if profile == "static" else "SHARED") +
                           "_RUNTIME_VALIDATED", "OFF"),
                          ("LIBUNWIND_ENABLE_" + profile.upper(), "OFF"),
                          ("LIBUNWIND_ENABLE_" + ("SHARED" if profile == "static" else "STATIC"), "ON"),
                          ("MMIX_LINUX_" + ("SHARED" if profile == "static" else "THREADED") +
                           "_RUNTIME_VALIDATED", "ON")):
        configure(profile, "ON", option=option, value=value,
                  error="requires a validated static pthread or shared-only runtime profile")
    configure(profile, "ON", option="LIBUNWIND_ADDITIONAL_COMPILE_FLAGS", value="",
              error="requires " + threads)

configure("static", "ON", legacy=[startup], error="static signal cancellation rejects startup images")
configure("shared", "ON", option="LIBUNWIND_ADDITIONAL_COMPILE_FLAGS", value=threads,
          error="shared signal cancellation requires startup images")
# Legacy selectors are validated too; default OFF remains inert on other targets.
configure("static", "OFF", legacy=[policy], option="CMAKE_SYSTEM_PROCESSOR", value="x86_64",
          error="requires the MMIX Linux target")
configure("static", option="CMAKE_SYSTEM_PROCESSOR", value="x86_64")
