# REQUIRES: mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libunwind %t %mmix_host_cxx

#--- run.py
import pathlib
import shlex
import subprocess
import sys

root, out = map(pathlib.Path, sys.argv[1:3])
for mode in ("STARTUP_IMAGES", "CURSOR_LIFETIME"):
    for opt in ("0", "2"):
        image = out / (mode + "-O" + opt)
        subprocess.run([*shlex.split(sys.argv[3]), "-std=c++17", "-UNDEBUG",
                        "-pthread", "-O" + opt, "-I", str(root / "src"),
                        "-D_LIBUNWIND_MMIX_" + mode,
                        str(root / "test/mmix/forced-continuation.cpp"),
                        "-o", str(image)], check=True)
        subprocess.run([str(image)], check=True, timeout=30)
