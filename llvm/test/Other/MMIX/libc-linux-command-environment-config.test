# REQUIRES: mmix-registered-target
# RUN: rm -rf %t
# RUN: split-file %S/libc-linux-c-runtime-config.test %t
# RUN: split-file %s %t
# RUN: %python %t/command-environment.py %S/../../../../libc %t

#--- command-environment.py
import pathlib
import runpy
import subprocess
import sys

source, root = (pathlib.Path(arg).resolve() for arg in sys.argv[1:])
base = runpy.run_path(str(root / "check.py"))["base"]
assert not (root / "0/mmix-command-environment-runtime/Inputs.cmake").exists()
for name in ("rstack", "sigcontext", "ucontext", "ptrace"):
    (root / "sysroot/usr/include/asm" / (name + ".h")).touch()
with (root / "CMakeLists.txt").open("a") as output:
    output.write('\ninclude(${LIBC_SOURCE}/config/linux/mmix/CommandEnvironmentRuntime.cmake)\n')
components = ("SIGNAL_RUNTIME", "WIDE", "MATH", "IOCTL", "TERMIOS", "JOB_CONTROL",
              "EXEC_SEARCH", "SIGNAL_SUSPEND", "POLL", "PROCESS_TIMING",
              "FILE_METADATA", "OPTION_PARSING", "REGEX", "FNMATCH",
              "ACCOUNT_LOOKUP", "MOUNT_TABLE", "SYSTEM_ADMINISTRATION", "TEXT_EXTENSIONS",
              "PROCESS_CONTROL")
cases = [([], None), (["-DLIBC_MMIX_ENABLE_UNIX_HEADERS=OFF"], "requires Unix headers")]
cases += [(["-DLIBC_MMIX_BUILD_" + c + "=OFF"], "requires " + c) for c in components]
for i, (options, error) in enumerate(cases):
    build = root / ("command-environment-" + str(i))
    result = subprocess.run(base + ["-DPROFILE=mmix-linux-command-environment", "-B", str(build)] + options,
                            capture_output=True, text=True)
    log = " ".join((result.stdout + result.stderr).split())
    if error:
        assert result.returncode and error in log, log
    else:
        assert result.returncode == 0, log
        manifest = (build / "mmix-command-environment-runtime/Inputs.cmake").read_text()
        for value in ("mmix-signal-runtime/Inputs.cmake", "LIBC_THREAD_MODE_SINGLE",
                      "LIBC_ERRNO_MODE_SHARED", "configured-caller-closure-pending",
                      "local-logging-not-provided", "not-qualified", "pthread;ELF-TLS;dynamic-linking"):
            assert value in manifest, value
