# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-synchronization.test %t/headers
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import re
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
base = ["clang", "-cc1", "-std=c++17", "-ffreestanding", "-mrelocation-model", "static",
        "-internal-isystem", resource + "/include", "-I", str(root / "headers"),
        "-I", str(libc), "-DLIBC_FULL_BUILD", "-DLIBC_NAMESPACE=lifetime_test",
        "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM"]
source = libc / "src/__support/threads/linux/mmix/lifecycle.cpp"
layout = str(root / "layout.o")
subprocess.run(base + ["-triple", "mmix-unknown-linux", "-emit-obj",
    str(root / "layout.cpp"), "-o", layout], check=True)
dump = subprocess.check_output(["llvm-readobj", "--hex-dump=.lifecycle_layout", layout], text=True)
assert "12345678 00000000" in dump, dump
for opt in ("0", "2"):
    files = []
    for index, src in enumerate((source, root / "test.cpp")):
        path = str(root / (str(index) + "-O" + opt))
        subprocess.run(base + ["-triple", "mmix-unknown-linux", "-O" + opt,
            "-emit-obj", str(src), "-o", path + ".o"], check=True)
        symbols = subprocess.check_output(["llvm-nm", "-u", path + ".o"], text=True)
        for forbidden in ("__atomic_", "__sync_", "pthread_", "__tls_get_addr",
                          "malloc", "free", "clock_gettime"):
            assert not any(line.split()[-1].startswith(forbidden)
                           for line in symbols.splitlines()), symbols
        if index == 0:
            assert {line.split()[-1] for line in symbols.splitlines()} == {
                "__llvm_libc_mmix_syscall"}, symbols
            ir = path + ".ll"
            subprocess.run(base + ["-triple", "mmix-unknown-linux", "-O" + opt,
                "-emit-llvm", str(src), "-o", ir], check=True)
            text = pathlib.Path(ir).read_text()
            assert "acquire" in text and "release" in text
            sections = subprocess.check_output(["llvm-readobj", "--sections", path + ".o"], text=True)
            assert ".init_array" not in sections, sections
        else:
            ir = path + ".ll"
            subprocess.run(base + ["-triple", "mmix-unknown-linux", "-O" + opt,
                "-emit-llvm", str(root / "layout.cpp"), "-o", ir], check=True)
            text = pathlib.Path(ir).read_text()
            assert re.search(r"store atomic i32 .* release", text), text
            assert re.search(r"load atomic i32, .* acquire", text), text
        subprocess.run(base + ["-include", str(root / "fake-syscall.h"), "-triple", "x86_64-unknown-linux-gnu",
            "-disable-O0-optnone", "-O" + opt, "-emit-llvm-bc", str(src),
            "-o", path + ".bc"], check=True)
        files.append(path + ".bc")
    linked = str(root / ("host-O" + opt + ".bc"))
    subprocess.run(["llvm-link", *files, "-o", linked], check=True)
    # This sequential host ownership harness is not an atomic concurrency test.
    # Only interpreter input lowers atomics/inline copies; target objects above
    # retain the production futex transport and memory ordering.
    lowered = linked + ".lowered.bc"
    subprocess.run(["opt", "-passes=function(sroa,instcombine,lower-atomic)",
                    linked, "-o", lowered], check=True)
    subprocess.run(["lli", "-force-interpreter=true", lowered], check=True)
    if len(sys.argv) == 4:
        native = str(root / ("native-O" + opt))
        subprocess.run([sys.argv[3], "-std=c++17", "-O" + opt, "-pthread",
            "-DLIBC_FULL_BUILD", "-DLIBC_NAMESPACE=lifetime_test",
            "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM", "-DNATIVE_CONCURRENCY",
            "-I", str(root / "headers"), "-I", str(libc),
            "-include", str(root / "fake-syscall.h"),
            str(source), str(root / "test.cpp"), "-o", native], check=True)
        subprocess.run([native], check=True, timeout=60)

#--- fake-syscall.h
#define LLVM_LIBC_SRC___SUPPORT_OSUTIL_LINUX_SYSCALL_H
#include "src/__support/macros/config.h"
extern "C" long test_syscall(long, long, long, long, long, long, long);
namespace LIBC_NAMESPACE_DECL {
template <typename R, typename... Ts> R syscall_impl(long n, Ts... args) {
  long values[6] = {(long)args...};
  return R(test_syscall(n, values[0], values[1], values[2], values[3], values[4], values[5]));
}
}

#--- layout.cpp
#include "src/__support/threads/linux/mmix/lifecycle.h"
using namespace lifetime_test::mmix;
__attribute__((used, section(".lifecycle_layout")))
const LifecycleWord layout_word{0x12345678};
extern "C" void publish(ThreadControl *c) {
  c->publish_prepared();
  c->publish_child(ChildStatus::Ready);
  c->publish_decision(CreatorDecision::Go);
}
extern "C" bool acquire(ThreadControl *c) {
  return c->is_prepared() && c->acquire_child() == ChildStatus::Ready &&
         c->acquire_decision() == CreatorDecision::Go;
}

#--- test.cpp
#include "hdr/errno_macros.h"
#include "src/__support/threads/linux/mmix/lifecycle.h"
#include <linux/futex.h>
#include <sys/syscall.h>
using namespace lifetime_test;
using namespace lifetime_test::mmix;

static unsigned wakes, waits;
static long event_address;
static void require(bool value) { if (!value) __builtin_trap(); }
#ifdef NATIVE_CONCURRENCY
extern "C" int pthread_create(unsigned long *, const void *, void *(*)(void *), void *);
extern "C" int pthread_join(unsigned long, void **);
extern "C" long syscall(long, ...);
extern "C" int *__errno_location();
static bool concurrent;
#endif
extern "C" long test_syscall(long n, long address, long op, long value,
                             long timeout, long ignored, long bitset) {
  require(n == SYS_futex && address && !ignored);
#ifdef NATIVE_CONCURRENCY
  if (concurrent) {
    // This optional native harness is explicitly Linux x86-64. Production MMIX
    // objects use the real target transport, never this syscall translation.
    long ret = syscall(202, address, op, value, timeout, ignored, bitset);
    return ret < 0 ? -*__errno_location() : ret;
  }
#endif
  if (op == FUTEX_WAKE_PRIVATE) {
    require(value == 2147483647 && !timeout && !bitset);
    if (event_address) require(address == event_address);
    event_address = address;
    ++wakes;
    return 0;
  }
  require(op == FUTEX_WAIT_BITSET_PRIVATE && timeout && bitset == 0xffffffffu);
  ++waits;
  return -110;
}

static void layout_and_publication() {
  LifecycleWord word{0x12345678};
  require(word.reserved == 0);
  unsigned char *bytes = reinterpret_cast<unsigned char *>(&word);
#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
  require(bytes[0] == 0x12 && bytes[3] == 0x78);
#else
  require(bytes[0] == 0x78 && bytes[3] == 0x12);
#endif
  for (unsigned i = 4; i != 8; ++i) require(bytes[i] == 0);
  ThreadControl c;
  require(c.clear_tid.value.load() == UINT32_MAX && !c.parent_tid.value.load());
  require(!c.is_prepared() && c.acquire_child() == ChildStatus::Starting);
  require(c.acquire_decision() == CreatorDecision::Hold);
  c.argument = &word;
  c.publish_prepared();
  require(c.is_prepared() && c.argument == &word);
  c.publish_child(ChildStatus::Failed, 17);
  require(c.acquire_child() == ChildStatus::Failed && c.child_error == 17);
  c.publish_decision(CreatorDecision::Abort);
  require(c.acquire_decision() == CreatorDecision::Abort);
}

static void ownership() {
  ThreadRegistry registry;
  ThreadControl c;
  event_address = 0;
  unsigned before = wakes;
  uint32_t sequence;
  {
    ThreadRegistryLock lock(registry);
    require(!lock.pin(reinterpret_cast<ThreadAttributes *>(1)));
    require(!lock.insert(c, false));
    require(lock.reserve() && lock.insert(c, false));
    require(!lock.insert(c, false) && lock.live_threads() == 1);
    require(!lock.claim_process_exit() && !lock.claim_join(c));
    require(lock.pin(&c.attributes) == &c);
    require(lock.claim_join(c) && !lock.claim_join(c) && !lock.detach(c));
    require(lock.release_join(c) && !lock.release_join(c));
    require(lock.detach(c) && !lock.detach(c) && !lock.claim_join(c));
    require(lock.start(c) && !lock.start(c));
    require(lock.acquire_lease(c));
    require(lock.begin_cleanup(c) && !lock.exit_ready(c, 42));
    require(lock.close_leases(c) && !lock.acquire_lease(c));
    require(!lock.exit_ready(c, 42));
    require(lock.release_lease(c) && !lock.release_lease(c));
    require(lock.exit_ready(c, 42) && !lock.exit_ready(c, 9));
    require(c.attributes.retval.stdc_retval == 42);
    require(!lock.begin_reaping(c));
    // A test kernel zero is distinct from EXIT_READY and ownership.
    c.clear_tid.value.store(0);
    require(lock.begin_reaping(c) && !lock.begin_reaping(c));
    require(!lock.pin(&c.attributes) && !lock.finish_reaping(c));
    require(lock.drop_creator(c) && !lock.drop_creator(c));
    require(!lock.finish_reaping(c));
    sequence = lock.sequence();
  }
  require(wakes == before + 1);
  {
    ThreadRegistryLock lock(registry);
    require(lock.sequence() == sequence + 1);
    sequence = lock.sequence();
    require(lock.unpin(c) && !lock.unpin(c));
  }
  require(wakes == before + 2);
  {
    ThreadRegistryLock lock(registry);
    require(lock.sequence() == sequence + 1);
    require(lock.finish_reaping(c) && !lock.finish_reaping(c));
    require(lock.owner(c) == ThreadOwner::Reaped);
    require(lock.reserve() && !lock.claim_process_exit());
    require(lock.cancel_reservation() && !lock.cancel_reservation());
    require(lock.claim_process_exit() && !lock.claim_process_exit());
    require(!lock.reserve());
    sequence = lock.sequence() + 1;
  }
  auto deadline = Futex::Timeout::from_timespec({1, 0}, false);
  auto result = registry.wait(sequence, *deadline);
  require(!result && result.error() == 110 && waits);
  require(registry.wait(sequence - 1, *deadline).has_value());
}

static void callback_waiters() {
  for (unsigned activate = 0; activate != 2; ++activate) {
    event_address = 0;
    ThreadRegistry registry;
    ThreadControl main, callback, foreign;
    main.attributes.tid = 1;
    {
      ThreadRegistryLock lock(registry);
      require(lock.register_main(main));
      require(!lock.insert_callback_waiter(callback));
      require(lock.reserve() && lock.insert_callback_waiter(callback));
      require(!lock.insert_callback_waiter(callback));
      require(lock.live_threads() == 1 && !lock.pending_creations());
      require(!lock.pin(&callback.attributes));
      require(!lock.activate_callback(callback)); // Not started yet.
      require(lock.start(callback));
      require(lock.callback_phase(callback) == CallbackPhase::Waiting);
      require(!callback.cancellation.enabled());
      require(!lock.begin_cleanup(callback));
      require(lock.request_cancellation(callback, true) != 0);
      require(!lock.activate_callback(foreign) && !lock.discard_callback(foreign));
      require(!lock.sole_fork_caller(main) && !lock.begin_vfork(main));
    }
    bool single = true;
    require(registry.freeze_for_fork(main, 0, &single, true) && !single);
    registry.release_after_fork();
    {
      ThreadRegistryLock lock(registry);
      if (activate) {
        require(lock.activate_callback(callback));
        require(!lock.activate_callback(callback) && !lock.discard_callback(callback));
        require(lock.live_threads() == 2);
        require(lock.pin(&callback.attributes) == &callback);
        require(lock.request_cancellation(callback, true) == 0);
        require(!callback.cancellation.enabled());
        require(lock.unpin(callback));
      } else {
        require(lock.discard_callback(callback));
        require(!lock.discard_callback(callback) && !lock.activate_callback(callback));
        require(lock.live_threads() == 1 && !lock.pin(&callback.attributes));
      }
      require(lock.begin_cleanup(callback) && lock.close_leases(callback));
      require(lock.exit_ready(callback, 0));
      require(lock.queued_reclaims() == 1 && !lock.sole_fork_caller(main));
      require(!lock.begin_reaping(callback));
      callback.clear_tid.value.store(0);
      require(lock.begin_reaping(callback) && !lock.finish_reaping(callback));
      require(lock.live_threads() == 1 && !lock.queued_reclaims());
      require(!lock.sole_fork_caller(main) && !lock.begin_vfork(main));
    }
    // Activation/exit and removal do not retire the callback's creator pin.
    require(registry.freeze_for_fork(main, 0, &single, true) && !single);
    registry.release_after_fork();
    {
      ThreadRegistryLock lock(registry);
      require(lock.drop_creator(callback) && lock.finish_reaping(callback));
      require(!lock.finish_reaping(callback));
      require(lock.sole_fork_caller(main));
    }
    require(registry.freeze_for_fork(main, 0, &single, true) && single);
    registry.release_after_fork();
  }
  // Last application exit and callback activation have one serialized winner.
  for (unsigned activate_first = 0; activate_first != 2; ++activate_first) {
    event_address = 0;
    ThreadRegistry registry;
    ThreadControl main, callback;
    main.attributes.tid = 1;
    ThreadRegistryLock lock(registry);
    require(lock.register_main(main) && lock.reserve());
    require(lock.insert_callback_waiter(callback) && lock.start(callback));
    if (activate_first) require(lock.activate_callback(callback));
    require(lock.begin_cleanup(main) && lock.close_leases(main));
    require(lock.exit_ready(main, 0));
    require(lock.termination_action(main) == (activate_first ?
        ThreadTermination::ThreadOnly : ThreadTermination::Process));
    if (!activate_first) {
      require(!lock.activate_callback(callback));
      require(lock.discard_callback(callback));
    }
    require(lock.begin_cleanup(callback) && lock.close_leases(callback));
    require(lock.exit_ready(callback, 0));
    require(lock.termination_action(callback) == (activate_first ?
        ThreadTermination::Process : ThreadTermination::ThreadOnly));
  }
  // Explicit signal-side process exit also wins over later activation.
  {
    event_address = 0;
    ThreadRegistry registry;
    ThreadControl main, callback;
    main.attributes.tid = 1;
    ThreadRegistryLock lock(registry);
    require(lock.register_main(main) && lock.reserve());
    require(lock.insert_callback_waiter(callback) && lock.start(callback));
    require(registry.claim_process_cleanup());
    require(!lock.activate_callback(callback) && lock.discard_callback(callback));
  }
}

static void helper_fork_admission() {
  event_address = 0;
  ThreadRegistry registry;
  ThreadControl main, reaper, service;
  main.attributes.tid = 1;
  {
    ThreadRegistryLock lock(registry);
    require(lock.register_main(main));
    require(!lock.insert(reaper, true, true));
    require(!lock.cancel_helper_reservation());
    require(lock.reserve() && !lock.insert(reaper, true, true));
    require(lock.begin_helper_creation() && lock.begin_helper_creation());
    require(lock.pending_helper_creations() == 2 && lock.pending_creations() == 1);
    require(lock.cancel_helper_reservation() && lock.pending_creations() == 1);
    require(lock.cancel_reservation() && lock.pending_helper_creations() == 1);
    require(!lock.sole_fork_caller(main) && !lock.begin_vfork(main));
  }
  bool single = true;
  require(!registry.freeze_for_fork(main, 0, &single, true) && !single);
  require(!registry.freeze_for_fork(main));
  {
    ThreadRegistryLock lock(registry);
    require(lock.cancel_helper_reservation() && !lock.cancel_helper_reservation());
    require(lock.sole_fork_caller(main));
    require(lock.begin_vfork(main));
    require(!lock.begin_helper_creation());
    require(lock.end_process_operation());
  }
  // A rolled-back reservation preserves history; census is not a release witness.
  require(registry.freeze_for_fork(main, 0, &single) && !single);
  registry.release_after_fork();
  require(registry.freeze_for_fork(main, 0, &single, true) && single);
  registry.release_after_fork();
  {
    ThreadRegistryLock lock(registry);
    require(lock.begin_helper_creation() && lock.insert(reaper, true, true));
    require(lock.begin_helper_creation() && lock.insert(service, true, true));
    require(lock.start(reaper) && lock.start(service));
    require(!lock.pending_helper_creations() && lock.live_threads() == 1);
    require(!lock.pin(&reaper.attributes) && !lock.pin(&service.attributes));
    require(lock.sole_fork_caller(main) && !lock.begin_vfork(main));
  }
  require(registry.freeze_for_fork(main, 0, &single, true) && !single);
  registry.release_after_fork();
  // Retire only the reaper first. The other service still excludes recovery.
  ThreadControl *helpers[] = {&reaper, &service};
  for (ThreadControl *helper : helpers) {
    {
      ThreadRegistryLock lock(registry);
      require(lock.begin_cleanup(*helper) && lock.close_leases(*helper));
      require(lock.exit_ready(*helper, 0));
      require(lock.termination_action(*helper) == ThreadTermination::ThreadOnly);
      require(lock.live_threads() == 1 && !lock.queued_reclaims());
      require(!lock.begin_reaping(*helper));
      helper->clear_tid.value.store(0);
      require(lock.begin_reaping(*helper) && !lock.finish_reaping(*helper));
      require(lock.sole_fork_caller(main) && !lock.begin_vfork(main));
    }
    require(registry.freeze_for_fork(main, 0, &single, true) && !single);
    registry.release_after_fork();
    {
      ThreadRegistryLock lock(registry);
      require(lock.drop_creator(*helper) && lock.finish_reaping(*helper));
      require(!lock.finish_reaping(*helper));
      require(lock.sole_fork_caller(main));
      if (helper == &reaper) require(!lock.begin_vfork(main));
      else require(lock.begin_vfork(main) && lock.end_process_operation());
    }
    require(registry.freeze_for_fork(main, 0, &single, true));
    require(single == (helper == &service));
    registry.release_after_fork();
  }
  // Final resource release is outside finish_reaping and remains mandatory.
  require(registry.freeze_for_fork(main, 0, &single) && !single);
  registry.release_after_fork();
}

static void worker_exit_fork_admission() {
  // Inject only the private normal-exit certificate. The exit-hook fixture
  // proves worker drain provenance; ordinary-root/loader proof is separate.
  for (unsigned blocker = 0; blocker != 10; ++blocker) {
    event_address = 0;
    ThreadRegistry registry;
    ThreadControl main, worker, other;
    main.attributes.tid = 321;
    worker.attributes.tid = 322;
    {
      ThreadRegistryLock lock(registry);
      require(lock.register_main(main) && lock.reserve());
      if (blocker == 9)
        require(lock.insert_callback_waiter(worker) && lock.start(worker) &&
                lock.activate_callback(worker));
      else
        require(lock.insert(worker, false) && lock.start(worker));
      require(lock.drop_creator(worker));
      require(lock.pin(&main.attributes) == &main && lock.claim_join(main));
      require(lock.begin_cleanup(main) && lock.close_leases(main));
      require(lock.exit_ready(main, 0));
      main.clear_tid.value.store(0);
      require(lock.begin_reaping(main) && lock.unpin(main) &&
              lock.finish_reaping(main));
      if (blocker == 1 || blocker == 5) {
        require(lock.reserve() && lock.insert(other, true) && lock.start(other));
        require(lock.drop_creator(other));
        if (blocker == 5)
          require(lock.begin_cleanup(other) && lock.close_leases(other) &&
                  lock.exit_ready(other, 0) && lock.queued_reclaims() == 1);
      } else if (blocker == 2) {
        require(lock.begin_helper_creation() && lock.insert(other, true, true));
        require(lock.start(other) && lock.drop_creator(other));
      } else if (blocker == 3) {
        require(lock.begin_helper_creation());
      } else if (blocker == 4) {
        require(lock.reserve());
      } else if (blocker == 6) {
        require(lock.reserve() && lock.insert_callback_waiter(other));
        require(lock.start(other));
      }
    }
    require(!worker.retains_resources_until_process_exit());
    bool single = true;
    worker.cancellation_suppression.store(1);
    require(!registry.freeze_for_fork(worker, 1, &single, true, ForkContinuation::NormalAfter) && !single);
    require(registry.claim_process_cleanup());
    require(!registry.freeze_for_fork(worker, 1, &single, true, ForkContinuation::NormalAfter));
    require(worker.begin_callback_cleanup());
    require(!registry.freeze_for_fork(worker, 1, &single, true, ForkContinuation::Ordinary));
    require(!registry.freeze_for_fork(worker, 0, &single, true, ForkContinuation::NormalAfter));
    if (blocker == 7)
      require(worker.cancellation.claim(false));
    if (blocker == 8) {
      ThreadRegistryLock lock(registry);
      require(lock.begin_cleanup(worker) && lock.close_leases(worker) &&
              lock.exit_ready(worker, 0));
    }
    bool frozen = registry.freeze_for_fork(worker, 1, &single, true, ForkContinuation::NormalAfter);
    require(frozen == (blocker != 3 && blocker != 4 && blocker != 7 &&
                       blocker != 8 && blocker != 9));
    require(single == (blocker == 0));
    if (frozen)
      registry.release_after_fork();
    require(!worker.retains_resources_until_process_exit());
    require(!worker.begin_callback_cleanup() && !registry.claim_process_cleanup());
    {
      ThreadRegistryLock lock(registry);
      require(!lock.sole_fork_caller(worker) && !lock.begin_vfork(worker));
      require(!lock.reserve() && !lock.begin_helper_creation());
    }
    if (blocker)
      continue;
    // Creation history survives rollback and requires a resource witness.
    require(registry.freeze_for_fork(worker, 1, &single, false, ForkContinuation::NormalAfter) && !single);
    registry.release_after_fork();
    for (unsigned child = 0; child != 2; ++child) {
      require(registry.freeze_for_fork(worker, 1, &single, true, ForkContinuation::NormalAfter) && single);
      registry.restore_fork_child(worker, internal::ForkRecovery::child(true, true), ForkContinuation::NormalAfter);
      require(worker.retains_resources_until_process_exit());
      require(!worker.begin_callback_cleanup() && !registry.claim_process_cleanup());
      require(worker.cancellation_suppression.load() == 1);
      ThreadRegistryLock lock(registry);
      require(!lock.reserve() && !lock.begin_helper_creation());
    }
  }
}

static void main_registration() {
  ThreadRegistry registry;
  ThreadControl main, other;
  event_address = 0;
  ThreadRegistryLock lock(registry);
  require(!lock.register_main(main)); // Missing identity.
  main.attributes.tid = 321;
  require(lock.reserve() && !lock.register_main(main));
  require(lock.cancel_reservation());
  main.owns_stack = true;
  require(!lock.register_main(main));
  main.owns_stack = false;
  main.control_mapping = {8192, 8192};
  require(!lock.register_main(main));
  main.control_mapping = {};
  require(lock.register_main(main));
  require(main.retains_resources_until_process_exit());
  require(lock.live_threads() == 1 && !lock.pending_creations());
  require(!lock.register_main(main) && !lock.register_main(other));
  require(!lock.claim_process_exit() && !lock.drop_creator(main));
  require(lock.pin(&main.attributes) == &main);
  require(lock.acquire_lease(main) && lock.release_lease(main));
  require(lock.claim_join(main) && lock.begin_cleanup(main));
  require(lock.close_leases(main) && lock.exit_ready(main, 0));
  require(!lock.begin_reaping(main));
  main.clear_tid.value.store(0);
  require(lock.begin_reaping(main) && !lock.finish_reaping(main));
  require(!lock.pin(&main.attributes));
  require(lock.unpin(main) && !lock.live_threads());
  require(lock.finish_reaping(main) && !lock.finish_reaping(main));
  require(main.retains_resources_until_process_exit());
}

static void detached_main() {
  for (unsigned detach_late = 0; detach_late != 2; ++detach_late) {
    ThreadRegistry registry;
    ThreadControl main;
    main.attributes.tid = 321;
    event_address = 0;
    ThreadRegistryLock lock(registry);
    require(lock.register_main(main) && lock.pin(&main.attributes) == &main);
    if (!detach_late) require(lock.detach(main));
    require(lock.begin_cleanup(main) && lock.close_leases(main));
    require(lock.exit_ready(main, 17));
    if (detach_late) require(lock.detach(main));
    require(lock.queued_reclaims() == 1 && !lock.begin_reaping(main));
    require(!lock.claim_join(main) && !lock.detach(main));
    require(lock.take_reap_candidate() == &main);
    require(lock.requeue_candidate(main));
    main.clear_tid.value.store(0);
    require(lock.begin_reaping(main) && !lock.queued_reclaims());
    require(!lock.pin(&main.attributes) && !lock.finish_reaping(main));
    require(lock.unpin(main) && lock.finish_reaping(main));
    require(main.retains_resources_until_process_exit());
  }
}

// Enumerate the model's independent creator/reader drops around terminal clear
// and removal for each ownership family. Every permutation tests production
// rejection predicates rather than replacing them with the abstract model.
static void schedule(unsigned owner, unsigned creator_at, unsigned reader_at) {
  ThreadRegistry registry;
  ThreadControl c;
  event_address = 0;
  {
    ThreadRegistryLock lock(registry);
    if (owner == 2) {
      require(lock.adopt_abort(c) && !lock.adopt_abort(c));
      require(!lock.pin(&c.attributes));
    } else {
      require(lock.reserve() && lock.insert(c, owner == 1));
      require(lock.pin(&c.attributes) == &c);
      if (owner == 0) require(lock.claim_join(c));
      require(lock.start(c) && lock.begin_cleanup(c));
      require(lock.close_leases(c) && lock.exit_ready(c, 19));
    }
  }
  for (unsigned step = 0; step != 4; ++step) {
    ThreadRegistryLock lock(registry);
    if (step == creator_at) require(lock.drop_creator(c));
    if (step == reader_at && owner != 2) require(lock.unpin(c));
    if (step == 1) c.clear_tid.value.store(0);
    if (step < 1) require(!lock.begin_reaping(c));
    if (step == 2) require(lock.begin_reaping(c));
    if (step < 2 || step < creator_at || (owner != 2 && step < reader_at))
      require(!lock.finish_reaping(c));
  }
  ThreadRegistryLock lock(registry);
  require(lock.finish_reaping(c));
}

#ifdef NATIVE_CONCURRENCY
struct ConcurrentState {
  ThreadRegistry registry;
  ThreadControl control;
  LifecycleWord acknowledged;
  unsigned payload = 0;
};
static void *producer(void *arg) {
  auto &state = *static_cast<ConcurrentState *>(arg);
  for (unsigned i = 1; i != 10001; ++i) {
    while (state.acknowledged.value.load(cpp::MemoryOrder::ACQUIRE) != i - 1) {}
    state.payload = i;
    state.control.publish_child(ChildStatus::Ready, int(i));
    state.control.prepared.value.store(i, cpp::MemoryOrder::RELEASE);
    ThreadRegistryLock lock(state.registry);
    require(lock.pin(&state.control.attributes) == &state.control);
    require(lock.unpin(state.control));
  }
  return nullptr;
}
static void concurrency() {
  ConcurrentState state;
  concurrent = true;
  {
    ThreadRegistryLock lock(state.registry);
    require(lock.reserve() && lock.insert(state.control, false));
  }
  unsigned long worker;
  require(pthread_create(&worker, nullptr, producer, &state) == 0);
  for (unsigned i = 1; i != 10001; ++i) {
    while (state.control.prepared.value.load(cpp::MemoryOrder::ACQUIRE) != i) {}
    require(state.payload == i && state.control.acquire_child() == ChildStatus::Ready);
    require(state.control.child_error == int(i));
    state.acknowledged.value.store(i, cpp::MemoryOrder::RELEASE);
    ThreadRegistryLock lock(state.registry);
    require(lock.pin(&state.control.attributes) == &state.control);
    require(lock.claim_join(state.control) && lock.release_join(state.control));
    require(lock.unpin(state.control));
  }
  require(pthread_join(worker, nullptr) == 0);
  concurrent = false;
}

struct AdmissionState {
  ThreadRegistry registry;
  ThreadControl main;
  LifecycleWord start, finished;
  bool reserved = false;
};
static void *admission_creator(void *arg) {
  auto &state = *static_cast<AdmissionState *>(arg);
  while (!state.start.value.load(cpp::MemoryOrder::ACQUIRE)) {}
  {
    ThreadRegistryLock lock(state.registry);
    state.reserved = lock.reserve();
    if (state.reserved) require(lock.cancel_reservation());
  }
  state.finished.value.store(1, cpp::MemoryOrder::RELEASE);
  return nullptr;
}
static void admission_concurrency() {
  concurrent = true;
  for (unsigned reserve_first = 0; reserve_first != 2; ++reserve_first) {
    AdmissionState state;
    state.main.attributes.tid = 41;
    {
      ThreadRegistryLock lock(state.registry);
      require(lock.register_main(state.main));
      if (!reserve_first) require(lock.begin_process_operation(state.main));
    }
    unsigned long worker;
    require(pthread_create(&worker, nullptr, admission_creator, &state) == 0);
    state.start.value.store(1, cpp::MemoryOrder::RELEASE);
    while (!state.finished.value.load(cpp::MemoryOrder::ACQUIRE)) {}
    require(pthread_join(worker, nullptr) == 0);
    {
      ThreadRegistryLock lock(state.registry);
      require(state.reserved == reserve_first);
      if (reserve_first) {
        require(!lock.begin_process_operation(state.main));
      } else {
        require(lock.end_process_operation());
        require(lock.begin_process_operation(state.main));
        require(lock.end_process_operation());
        require(lock.reserve() && lock.cancel_reservation());
        require(!lock.begin_process_operation(state.main));
      }
    }
  }
  concurrent = false;
}
#endif

static void terminal_during_fork_admission() {
  constexpr auto kind = ForkContinuation::InitialThreadDuring;
  // Each rejection starts from a separately constructed, deterministic census.
  for (unsigned blocker = 0; blocker != 29; ++blocker) {
    event_address = 0;
    ThreadRegistry process;
    ThreadControl caller, other;
    caller.attributes.tid = 1;
    {
      ThreadRegistryLock lock(process);
      require(lock.register_main(caller));
      if (blocker == 1 || blocker == 5 || blocker == 26) {
        require(lock.reserve() && lock.insert(other, blocker == 5));
        require(lock.start(other) && lock.drop_creator(other));
        if (blocker != 1)
          require(lock.begin_cleanup(other) && lock.close_leases(other) &&
                  lock.exit_ready(other, 0));
      } else if (blocker == 2 || blocker == 27) {
        require(lock.begin_helper_creation() && lock.insert(other, true, true));
        require(lock.start(other) && lock.drop_creator(other));
        if (blocker == 27)
          require(lock.begin_cleanup(other) && lock.close_leases(other) &&
                  lock.exit_ready(other, 0));
      } else if (blocker == 3) {
        require(lock.reserve());
      } else if (blocker == 4) {
        require(lock.begin_helper_creation());
      } else if (blocker == 6 || blocker == 28) {
        require(lock.reserve() && lock.insert_callback_waiter(other));
        require(lock.start(other) && lock.drop_creator(other));
        if (blocker == 28) require(lock.discard_callback(other));
      } else if (blocker == 7 || blocker == 13 || blocker == 14 || blocker == 16) {
        require(lock.pin(&caller.attributes) == &caller);
        if (blocker == 7) require(lock.detach(caller) && lock.unpin(caller));
        if (blocker == 14) require(lock.acquire_lease(caller) && lock.unpin(caller));
        if (blocker == 16) require(lock.claim_join(caller) && lock.unpin(caller));
      } else if (blocker == 15) {
        require(lock.begin_process_operation(caller));
      }
      if (blocker != 8) require(lock.begin_cleanup(caller));
      if (blocker == 10 || blocker == 12) require(lock.close_leases(caller));
      if (blocker == 10) require(lock.exit_ready(caller, 17));
    }
    if (blocker != 9) require(caller.begin_callback_cleanup());
    if (blocker == 11) require(process.claim_process_cleanup());
    caller.unwind_root = {&caller, 8, 16, 24, 4, 6, true,
                          UnwindRootKind::TerminalThreadCleanup};
    if (blocker == 17) caller.unwind_root.active = false;
    if (blocker == 18) caller.unwind_root.generation = 0;
    if (blocker == 19) caller.unwind_root.kind = UnwindRootKind::LastThreadProcess;
    if (blocker == 20) caller.unwind_root.owner = &other;
    if (blocker == 21) caller.unwind_root.chain = 0;
    if (blocker == 22) caller.cancellation_transfer.store(1);
    if (blocker == 23)
      caller.cancellation_point.store(reinterpret_cast<CancellationPoint *>(8));
    caller.cancellation_suppression.store(blocker == 24 ? 0 : 1);
    bool single = true;
    bool frozen = process.freeze_for_fork(caller, 1, &single, blocker != 25, kind);
    require(frozen == (blocker == 0) && single == (blocker == 0));
    if (!frozen) continue;
    const auto root = caller.unwind_root;
    process.release_after_fork(); // Failed clone: no progress/election mutation.
    for (unsigned child = 0; child != 2; ++child) {
      require(caller.terminal_cleanup_in_progress() &&
              !caller.terminal_cleanup_finished());
      require(process.admit_signal_notification());
      require(!process.freeze_for_fork(caller, 1, &single, true,
                                       ForkContinuation::LastThreadAfter));
      require(process.freeze_for_fork(caller, 1, &single, true, kind) && single);
      process.restore_fork_child(caller, internal::ForkRecovery::child(true, true), kind);
      require(root.matches(caller.unwind_root));
      // claim() need not clear ENABLED. TERMINAL alone prevents delivery.
      require(caller.cancellation.terminal() && caller.cancellation.enabled() &&
              !caller.cancellation.ready() && !caller.cancellation.request());
      ThreadRegistryLock lock(process);
      require(lock.live_threads() == 1 && !lock.process_exiting());
      require(!caller.begin_callback_cleanup() && !lock.begin_cleanup(caller));
      require(!lock.exit_ready(caller, 0)); // Leases remain open.
      require(lock.pin(&caller.attributes) == &caller);
      require(lock.acquire_lease(caller) && lock.release_lease(caller));
      require(lock.unpin(caller) && lock.owner(caller) == ThreadOwner::Joinable);
      require(lock.reserve() && lock.cancel_reservation());
    }
    ThreadRegistryLock lock(process);
    require(lock.close_leases(caller) && lock.exit_ready(caller, 17));
    require(lock.live_threads() == 0 && !lock.exit_ready(caller, 99));
    require(caller.terminal_cleanup_finished()); // Initial identity survived.
    require(lock.termination_action(caller) == ThreadTermination::Process);
    require(lock.termination_action(caller) == ThreadTermination::ThreadOnly);
    require(lock.claim_process_cleanup() && !lock.claim_process_cleanup());
  }
  // A promoted worker owns process-lifetime backing, but is never initial.
  {
    event_address = 0;
    ThreadRegistry process;
    ThreadControl main, worker;
    main.attributes.tid = 1;
    {
      ThreadRegistryLock lock(process);
      require(lock.register_main(main));
      require(lock.reserve() && lock.insert(worker, false) && lock.start(worker));
      require(lock.drop_creator(worker));
    }
    require(process.freeze_for_fork(worker));
    process.restore_fork_child(worker, internal::ForkRecovery::child(true, true));
    {
      ThreadRegistryLock lock(process);
      require(lock.begin_cleanup(worker) && worker.begin_callback_cleanup());
      require(lock.live_threads() == 1);
    }
    worker.unwind_root = {&worker, 8, 16, 24, 4, 6, true,
                          UnwindRootKind::TerminalThreadCleanup};
    require(worker.retains_resources_until_process_exit());
    require(!worker.terminal_cleanup_pending());
    require(!process.freeze_for_fork(worker, 0, nullptr, true, kind));
  }
  // Sole at snapshot is not an early last-thread election. Creation stays open.
  for (unsigned commit = 0; commit != 2; ++commit) {
    event_address = 0;
    ThreadRegistry process;
    ThreadControl caller, peer;
    caller.attributes.tid = 1;
    {
      ThreadRegistryLock lock(process);
      require(lock.register_main(caller) && lock.begin_cleanup(caller));
      require(caller.begin_callback_cleanup());
    }
    caller.unwind_root = {&caller, 8, 16, 24, 4, 6, true,
                          UnwindRootKind::TerminalThreadCleanup};
    require(process.freeze_for_fork(caller, 0, nullptr, true, kind));
    process.restore_fork_child(caller, internal::ForkRecovery::child(true, true), kind);
    {
      ThreadRegistryLock lock(process);
      require(lock.reserve());
    }
    require(!process.freeze_for_fork(caller, 0, nullptr, true, kind));
    ThreadRegistryLock lock(process);
    require(lock.close_leases(caller) && lock.exit_ready(caller, 17));
    require(lock.termination_action(caller) == ThreadTermination::WaitForCreation);
    if (commit) {
      require(lock.insert(peer, false) && lock.start(peer));
      require(lock.termination_action(caller) == ThreadTermination::ThreadOnly);
      require(!lock.process_exiting() && lock.live_threads() == 1);
    } else {
      require(lock.cancel_reservation());
      require(lock.termination_action(caller) == ThreadTermination::Process);
    }
  }
}

static void terminal_exit_fork_admission() {
  constexpr auto kind = ForkContinuation::LastThreadAfter;
  for (unsigned blocker = 0; blocker != 24; ++blocker) {
    event_address = 0;
    ThreadRegistry process;
    ThreadControl caller, other;
    caller.attributes.tid = 1;
    caller.cancellation.set_enabled(false);
    caller.cancellation.set_async(true);
    {
      ThreadRegistryLock lock(process);
      require(lock.register_main(caller));
      if (blocker == 1 || blocker == 5 || blocker == 19) {
        require(lock.reserve() && lock.insert(other, blocker == 5));
        require(lock.start(other) && lock.drop_creator(other));
        if (blocker != 1)
          require(lock.begin_cleanup(other) && lock.close_leases(other) &&
                  lock.exit_ready(other, 0));
      } else if (blocker == 2) {
        require(lock.begin_helper_creation() && lock.insert(other, true, true));
        require(lock.start(other) && lock.drop_creator(other));
      } else if (blocker == 3) {
        require(lock.reserve());
      } else if (blocker == 4) {
        require(lock.begin_helper_creation());
      } else if (blocker == 6) {
        require(lock.reserve() && lock.insert_callback_waiter(other));
        require(lock.start(other) && lock.drop_creator(other));
      } else if (blocker == 7 || blocker == 20 || blocker == 21) {
        require(lock.pin(&caller.attributes) == &caller);
        if (blocker == 7)
          require(lock.detach(caller) && lock.unpin(caller));
        if (blocker == 21)
          require(lock.claim_join(caller) && lock.unpin(caller));
      } else if (blocker == 18) {
        require(lock.begin_process_operation(caller));
      }
      require(lock.begin_cleanup(caller));
      if (blocker != 9)
        require(lock.close_leases(caller));
      if (blocker != 8 && blocker != 9)
        require(lock.exit_ready(caller, 17));
    }
    if (blocker != 10)
      require(caller.begin_callback_cleanup());
    if (blocker != 23)
      require(process.claim_process_cleanup());
    caller.unwind_root = {&caller, 8, 16, 24, 4, 6, true,
                          UnwindRootKind::LastThreadProcess};
    if (blocker == 11) caller.unwind_root.active = false;
    if (blocker == 12) caller.unwind_root.generation = 0;
    if (blocker == 13) caller.unwind_root.kind = UnwindRootKind::Thread;
    if (blocker == 14) caller.unwind_root.owner = &other;
    if (blocker == 15) caller.cancellation_transfer.store(1);
    if (blocker == 16)
      caller.cancellation_point.store(reinterpret_cast<CancellationPoint *>(8));
    if (blocker == 22) caller.unwind_root.chain = 0;
    caller.cancellation_suppression.store(blocker == 17 ? 0 : 1);
    bool single = true;
    bool frozen = process.freeze_for_fork(caller, 1, &single, true, kind);
    require(frozen == (blocker == 0) && single == (blocker == 0));
    if (!frozen)
      continue;
    process.release_after_fork(); // No-child rollback preserves all progress.
    const auto root = caller.unwind_root;
    for (unsigned child = 0; child != 2; ++child) {
      require(caller.terminal_cleanup_finished());
      require(!process.admit_signal_notification());
      require(!caller.begin_callback_cleanup() && !process.claim_process_cleanup());
      require(!process.freeze_for_fork(caller, 1, &single, true,
                                       ForkContinuation::NormalAfter));
      require(!process.freeze_for_fork(caller, 1, &single, false, kind));
      require(process.freeze_for_fork(caller, 1, &single, true, kind) && single);
      process.restore_fork_child(caller, internal::ForkRecovery::child(true, true), kind);
      require(root.matches(caller.unwind_root));
      require(caller.terminal_cleanup_finished() && caller.cancellation.terminal());
      require(!caller.cancellation.enabled() && !caller.cancellation.ready());
      require(caller.cancellation.asynchronous() && !caller.cancellation.request());
      ThreadRegistryLock lock(process);
      require(lock.live_threads() == 0 && lock.leases_drained(caller));
      require(!lock.reserve() && !lock.begin_helper_creation());
      require(!lock.begin_cleanup(caller) && !lock.exit_ready(caller, 0));
      require(lock.request_cancellation(caller, true) == ESRCH);
      require(lock.pin(&caller.attributes) == &caller);
      require(!lock.acquire_lease(caller) && lock.unpin(caller));
      require(lock.owner(caller) == ThreadOwner::Joinable);
    }
  }
}

static void last_worker_after_fork_admission() {
  constexpr auto kind = ForkContinuation::LastWorkerAfter;
  enum Blocker {
    None, UnjoinedInitial, Peer, Reservation, HelperReservation, LiveHelper,
    DeadHelper, WaitingCallback, DiscardedCallback, DeadCallback, Detached,
    CreatorPin, ApiPin, JoinClaim, Lease, OpenLeases, NoDrainReturn, NoCleanup,
    NoCallbacks, StillCleaning, NoElection, NoProcessClaim, ResourceOwner,
    InvalidResourceOwner, ChangedManager, InactiveRoot, RootGeneration, RootKind,
    RootOwner, RootChain, Transfer, Point, Suppression, NoHelperWitness,
    LostTerminal, PromotedWorker, BlockerCount
  };
  for (unsigned cancel = 0; cancel != 2; ++cancel) {
    for (unsigned blocker = None; blocker != BlockerCount; ++blocker) {
      event_address = 0;
      ThreadRegistry process;
      ThreadControl initial, caller, other;
      initial.attributes.tid = 1;
      caller.attributes.tid = 2;
      caller.attributes.atexit_callback_mgr =
          reinterpret_cast<ThreadAtExitCallbackMgr *>(0x1000);
      caller.control_mapping = {0x2000, 8192};
      caller.stack_mapping = {0x4000, 8192};
      caller.stack_bottom = 0x4000;
      caller.stack_top = 0x6000;
      caller.owns_stack = true;
      caller.tls = {8192, 0x6000, 0x7000};
      {
        ThreadRegistryLock lock(process);
        require(lock.register_main(initial));
        require(lock.reserve() && lock.insert(caller, blocker == Detached));
        require(lock.start(caller));
        if (blocker != CreatorPin) require(lock.drop_creator(caller));
        require(!caller.record_worker_cleanup_finished());
        require(lock.begin_cleanup(initial) && lock.close_leases(initial) &&
                lock.exit_ready(initial, 42));
        initial.clear_tid.value.store(0);
        if (blocker != UnjoinedInitial) {
          require(lock.pin(&initial.attributes) == &initial);
          require(lock.claim_join(initial) && lock.begin_reaping(initial));
          require(lock.unpin(initial) && lock.finish_reaping(initial));
        }
        if (blocker == Peer) {
          require(lock.reserve() && lock.insert(other, false) &&
                  lock.start(other) && lock.drop_creator(other));
        }
        if (blocker == Reservation) require(lock.reserve());
        if (blocker == HelperReservation) require(lock.begin_helper_creation());
        if (blocker == LiveHelper || blocker == DeadHelper) {
          require(lock.begin_helper_creation() && lock.insert(other, true, true));
          require(lock.start(other) && lock.drop_creator(other));
          if (blocker == DeadHelper)
            require(lock.begin_cleanup(other) && lock.close_leases(other) &&
                    lock.exit_ready(other, 0));
        }
        if (blocker == WaitingCallback || blocker == DiscardedCallback ||
            blocker == DeadCallback) {
          require(lock.reserve() && lock.insert_callback_waiter(other) &&
                  lock.start(other) && lock.drop_creator(other));
          if (blocker == DiscardedCallback) require(lock.discard_callback(other));
          if (blocker == DeadCallback)
            require(lock.activate_callback(other) && lock.begin_cleanup(other) &&
                    lock.close_leases(other) && lock.exit_ready(other, 0));
        }
        if (blocker == ApiPin || blocker == JoinClaim || blocker == Lease) {
          require(lock.pin(&caller.attributes) == &caller);
          if (blocker == JoinClaim)
            require(lock.claim_join(caller) && lock.unpin(caller));
          if (blocker == Lease)
            require(lock.acquire_lease(caller) && lock.unpin(caller));
        }
      }
      if (blocker == PromotedWorker) {
        require(process.freeze_for_fork(caller));
        process.restore_fork_child(caller, internal::ForkRecovery::child(true, true));
      }
      {
        ThreadRegistryLock lock(process);
        if (cancel) require(!lock.request_cancellation(caller, true));
        if (blocker != NoCleanup) require(lock.begin_cleanup(caller, cancel));
      }
      require(!caller.record_worker_cleanup_finished()); // Not yet drained.
      if (blocker != NoCallbacks) require(caller.begin_callback_cleanup());
      if (blocker != NoDrainReturn) {
        bool recorded = caller.record_worker_cleanup_finished();
        require(recorded == (blocker != NoCallbacks && blocker != NoCleanup &&
                             blocker != PromotedWorker));
        require(!caller.record_worker_cleanup_finished());
      }
      require(!caller.last_worker_cleanup_finished()); // Not elected.
      const bool exit_ready = blocker != NoCleanup && blocker != StillCleaning &&
                              blocker != Lease && blocker != OpenLeases;
      {
        ThreadRegistryLock lock(process);
        if (blocker != OpenLeases) require(lock.close_leases(caller));
        if (exit_ready) {
          require(lock.exit_ready(caller, 17));
          require(!caller.last_worker_cleanup_finished());
          if (blocker != NoElection) {
            auto action = lock.termination_action(caller);
            if (blocker == None) require(action == ThreadTermination::Process);
          }
        }
      }
      if (blocker != NoProcessClaim) require(process.claim_process_cleanup());
      if (blocker == ResourceOwner)
        caller.resource_owner = {&caller, +[](void *) -> long { return 0; },
                                 +[](void *) -> long { return 0; }};
      if (blocker == InvalidResourceOwner)
        caller.resource_owner.retain = +[](void *) -> long { return 0; };
      if (blocker == ChangedManager) caller.attributes.atexit_callback_mgr = nullptr;
      caller.unwind_root = {&caller, 8, 16, 24, 4, 6, true,
                            UnwindRootKind::LastThreadProcess};
      if (blocker == InactiveRoot) caller.unwind_root.active = false;
      if (blocker == RootGeneration) caller.unwind_root.generation = 0;
      if (blocker == RootKind) caller.unwind_root.kind = UnwindRootKind::Thread;
      if (blocker == RootOwner) caller.unwind_root.owner = &initial;
      if (blocker == RootChain) caller.unwind_root.chain = 0;
      if (blocker == Transfer) caller.cancellation_transfer.store(1);
      if (blocker == Point)
        caller.cancellation_point.store(reinterpret_cast<CancellationPoint *>(8));
      if (blocker == LostTerminal) caller.cancellation.restore_after_fork();
      caller.cancellation_suppression.store(blocker == Suppression ? 0 : 1);
      bool single = true;
      bool frozen = process.freeze_for_fork(caller, 1, &single,
                                             blocker != NoHelperWitness, kind);
      require(frozen == (blocker == None) && single == (blocker == None));
      require(!caller.terminal_cleanup_finished());
      require(caller.retains_resources_until_process_exit() ==
              (blocker == PromotedWorker));
      require(caller.control_mapping.base == 0x2000 &&
              caller.stack_mapping.base == 0x4000 && caller.tls.addr == 0x6000);
      if (!frozen) continue;
      const auto root = caller.unwind_root;
      process.release_after_fork(); // Failed-clone rollback is not restoration.
      for (unsigned child = 0; child != 2; ++child) {
        require(caller.last_worker_cleanup_finished());
        require(!process.freeze_for_fork(caller, 1, nullptr, true,
                                         ForkContinuation::LastThreadAfter));
        require(!process.freeze_for_fork(caller, 1, nullptr, true,
                                         ForkContinuation::InitialThreadDuring));
        require(process.freeze_for_fork(caller, 1, &single, true, kind) && single);
        process.restore_fork_child(caller, internal::ForkRecovery::child(true, true), kind);
        require(root.matches(caller.unwind_root));
        require(caller.last_worker_cleanup_finished() &&
                !caller.retains_resources_until_process_exit() &&
                !caller.terminal_cleanup_pending() &&
                !caller.terminal_cleanup_finished());
        require(caller.cancellation.terminal() && caller.cancellation.enabled() &&
                !caller.cancellation.ready() && !caller.cancellation.request());
        require(caller.control_mapping.base == 0x2000 &&
                caller.stack_mapping.base == 0x4000 && caller.tls.addr == 0x6000 &&
                caller.owns_stack && caller.clear_tid.value.load() == UINT32_MAX);
        require(!caller.begin_callback_cleanup() && !process.claim_process_cleanup());
        ThreadRegistryLock lock(process);
        require(lock.live_threads() == 0 && lock.process_exiting());
        require(lock.owner(caller) == ThreadOwner::Joinable &&
                !lock.queued_reclaims() && !lock.begin_reaping(caller));
        require(!lock.pin(&initial.attributes));
        require(lock.pin(&caller.attributes) == &caller);
        require(!lock.acquire_lease(caller) && lock.unpin(caller));
        require(!lock.reserve() && !lock.begin_helper_creation());
        require(!lock.begin_cleanup(caller) && !lock.exit_ready(caller, 99));
        require(lock.request_cancellation(caller, true) == ESRCH);
        require(caller.attributes.retval.stdc_retval == 17);
      }
    }
  }
}

static void worker_during_fork_admission() {
  constexpr auto kind = ForkContinuation::WorkerThreadDuring;
  enum Blocker {
    None, UnjoinedInitial, Peer, Reservation, HelperReservation, LiveHelper,
    DeadHelper, WaitingCallback, DiscardedCallback, Detached, CreatorPin,
    ApiPin, JoinClaim, Lease, ClosedLeases, NoCleanup, NoCallbacks, ExitReady,
    ProcessClaim, ResourceOwner, InvalidResourceOwner, CompletedDrain,
    InactiveRoot, RootGeneration, RootKind, RootOwner, RootChain, Transfer,
    Point, Suppression, NoHelperWitness, LostTerminal, PromotedWorker,
    ProcessOperation, DeadPeer, ManagedCaller, BlockerCount
  };
  for (unsigned cancel = 0; cancel != 2; ++cancel) {
    for (unsigned blocker = None; blocker != BlockerCount; ++blocker) {
      event_address = 0;
      ThreadRegistry process;
      ThreadControl initial, caller, other;
      initial.attributes.tid = 1;
      caller.attributes.tid = 2;
      caller.attributes.atexit_callback_mgr =
          reinterpret_cast<ThreadAtExitCallbackMgr *>(0x1000);
      caller.control_mapping = {0x2000, 8192};
      caller.stack_mapping = {0x4000, 8192};
      caller.tls = {8192, 0x6000, 0x7000};
      caller.owns_stack = true;
      {
        ThreadRegistryLock lock(process);
        require(lock.register_main(initial) && lock.reserve());
        if (blocker == ManagedCaller) {
          require(lock.insert_callback_waiter(caller) && lock.start(caller));
          require(lock.activate_callback(caller));
          caller.cancellation.set_enabled(true);
        } else {
          require(lock.insert(caller, blocker == Detached) && lock.start(caller));
        }
        if (blocker != CreatorPin) require(lock.drop_creator(caller));
        require(lock.begin_cleanup(initial) && lock.close_leases(initial) &&
                lock.exit_ready(initial, 42));
        initial.clear_tid.value.store(0);
        if (blocker != UnjoinedInitial) {
          require(lock.pin(&initial.attributes) == &initial);
          require(lock.claim_join(initial) && lock.begin_reaping(initial));
          require(lock.unpin(initial) && lock.finish_reaping(initial));
        }
        if (blocker == Peer || blocker == DeadPeer) {
          require(lock.reserve() && lock.insert(other, false) &&
                  lock.start(other) && lock.drop_creator(other));
          if (blocker == DeadPeer)
            require(lock.begin_cleanup(other) && lock.close_leases(other) &&
                    lock.exit_ready(other, 0));
        }
        if (blocker == Reservation) require(lock.reserve());
        if (blocker == HelperReservation) require(lock.begin_helper_creation());
        if (blocker == LiveHelper || blocker == DeadHelper) {
          require(lock.begin_helper_creation() && lock.insert(other, true, true));
          require(lock.start(other) && lock.drop_creator(other));
          if (blocker == DeadHelper)
            require(lock.begin_cleanup(other) && lock.close_leases(other) &&
                    lock.exit_ready(other, 0));
        }
        if (blocker == WaitingCallback || blocker == DiscardedCallback) {
          require(lock.reserve() && lock.insert_callback_waiter(other) &&
                  lock.start(other) && lock.drop_creator(other));
          if (blocker == DiscardedCallback) require(lock.discard_callback(other));
        }
        if (blocker == ApiPin || blocker == JoinClaim || blocker == Lease) {
          require(lock.pin(&caller.attributes) == &caller);
          if (blocker == JoinClaim)
            require(lock.claim_join(caller) && lock.unpin(caller));
          if (blocker == Lease)
            require(lock.acquire_lease(caller) && lock.unpin(caller));
        }
      }
      if (blocker == PromotedWorker) {
        require(process.freeze_for_fork(caller));
        process.restore_fork_child(caller, internal::ForkRecovery::child(true, true));
      }
      {
        ThreadRegistryLock lock(process);
        if (cancel) require(!lock.request_cancellation(caller, true));
        if (blocker == ProcessOperation) require(lock.begin_vfork(caller));
        if (blocker != NoCleanup) require(lock.begin_cleanup(caller, cancel));
        if (blocker == ClosedLeases || blocker == ExitReady)
          require(lock.close_leases(caller));
        if (blocker == ExitReady) require(lock.exit_ready(caller, 17));
      }
      if (blocker != NoCallbacks) require(caller.begin_callback_cleanup());
      if (blocker == CompletedDrain) require(caller.record_worker_cleanup_finished());
      if (blocker == ProcessClaim) require(process.claim_process_cleanup());
      if (blocker == ResourceOwner)
        caller.resource_owner = {&caller, +[](void *) -> long { return 0; },
                                 +[](void *) -> long { return 0; }};
      if (blocker == InvalidResourceOwner)
        caller.resource_owner.release = +[](void *) -> long { return 0; };
      caller.unwind_root = {&caller, 8, 16, 24, 4, 6, true,
                            UnwindRootKind::TerminalThreadCleanup};
      if (blocker == InactiveRoot) caller.unwind_root.active = false;
      if (blocker == RootGeneration) caller.unwind_root.generation = 0;
      if (blocker == RootKind) caller.unwind_root.kind = UnwindRootKind::Thread;
      if (blocker == RootOwner) caller.unwind_root.owner = &initial;
      if (blocker == RootChain) caller.unwind_root.chain = 0;
      if (blocker == Transfer) caller.cancellation_transfer.store(1);
      if (blocker == Point)
        caller.cancellation_point.store(reinterpret_cast<CancellationPoint *>(8));
      if (blocker == LostTerminal) caller.cancellation.restore_after_fork();
      caller.cancellation_suppression.store(blocker == Suppression ? 0 : 1);
      bool single = true;
      bool frozen = process.freeze_for_fork(caller, 1, &single,
                                             blocker != NoHelperWitness, kind);
      require(frozen == (blocker == None) && single == (blocker == None));
      if (!frozen) continue;
      const auto root = caller.unwind_root;
      process.release_after_fork(); // Failed clone must not elect or finish.
      for (unsigned child = 0; child != 2; ++child) {
        require(caller.worker_cleanup_in_progress() &&
                !caller.last_worker_cleanup_finished());
        require(process.admit_signal_notification());
        require(!process.freeze_for_fork(caller, 1, nullptr, true,
                                         ForkContinuation::InitialThreadDuring));
        require(!process.freeze_for_fork(caller, 1, nullptr, true,
                                         ForkContinuation::LastWorkerAfter));
        require(process.freeze_for_fork(caller, 1, &single, true, kind) && single);
        process.restore_fork_child(caller, internal::ForkRecovery::child(true, true), kind);
        require(root.matches(caller.unwind_root));
        require(caller.worker_cleanup_in_progress() &&
                !caller.retains_resources_until_process_exit() &&
                !caller.terminal_cleanup_pending());
        require(caller.cancellation.terminal() && !caller.cancellation.ready());
        require(caller.control_mapping.base == 0x2000 &&
                caller.stack_mapping.base == 0x4000 && caller.tls.addr == 0x6000 &&
                caller.tls.tp == 0x7000 && caller.owns_stack);
        ThreadRegistryLock lock(process);
        require(lock.live_threads() == 1 && !lock.process_exiting());
        require(lock.owner(caller) == ThreadOwner::Joinable && !lock.queued_reclaims());
        require(!lock.begin_reaping(caller) && !lock.pin(&initial.attributes));
        require(lock.pin(&caller.attributes) == &caller);
        require(lock.acquire_lease(caller) && lock.release_lease(caller) && lock.unpin(caller));
        require(!lock.exit_ready(caller, 99) && !caller.begin_callback_cleanup());
        // termination_action is only valid after ExitReady. Live census and
        // process_exiting above establish that DURING did not elect exit.
      }
      caller.unwind_root.active = false;
      require(caller.record_worker_cleanup_finished());
      require(!caller.worker_cleanup_in_progress());
      {
        ThreadRegistryLock lock(process);
        require(lock.close_leases(caller) && lock.exit_ready(caller, 17));
        require(lock.termination_action(caller) == ThreadTermination::Process);
        require(lock.claim_process_cleanup() && caller.last_worker_cleanup_finished());
      }
      caller.unwind_root = {&caller, 8, 16, 24, 4, 7, true,
                            UnwindRootKind::LastThreadProcess};
      require(!process.freeze_for_fork(caller, 1, nullptr, true, kind));
      require(process.freeze_for_fork(caller, 1, &single, true,
                                      ForkContinuation::LastWorkerAfter) && single);
      process.release_after_fork();
    }
  }
}

extern "C" int main() {
  layout_and_publication();
  ownership();
  callback_waiters();
  helper_fork_admission();
  worker_exit_fork_admission();
  terminal_exit_fork_admission();
  terminal_during_fork_admission();
  last_worker_after_fork_admission();
  worker_during_fork_admission();
  main_registration();
  detached_main();
  {
    event_address = 0;
    ThreadRegistry process;
    ThreadControl caller;
    caller.attributes.tid = 1;
    {
      ThreadRegistryLock lock(process);
      require(lock.register_main(caller));
    }
    bool single = false;
    // A certificate cannot bypass the actual claim and completed drain state.
    require(!process.freeze_for_fork(caller, 0, &single, false, ForkContinuation::NormalAfter));
    require(process.claim_process_cleanup());
    require(!process.freeze_for_fork(caller, 0, &single, false, ForkContinuation::NormalAfter));
    require(caller.begin_callback_cleanup());
    require(!process.freeze_for_fork(caller));
    require(process.freeze_for_fork(caller, 0, &single, false, ForkContinuation::NormalAfter) && single);
    process.release_after_fork(); // A failed clone must not erase parent state.
    require(!caller.begin_callback_cleanup() && !process.claim_process_cleanup());
    require(process.freeze_for_fork(caller, 0, &single, false, ForkContinuation::NormalAfter) && single);
    process.restore_fork_child(caller, internal::ForkRecovery::child(true, true), ForkContinuation::NormalAfter);
    require(!caller.begin_callback_cleanup() && !process.claim_process_cleanup());
    {
      ThreadRegistryLock lock(process);
      require(!lock.reserve() && !lock.begin_helper_creation());
    }
    require(process.freeze_for_fork(caller, 0, &single, false, ForkContinuation::NormalAfter) && single);
    process.release_after_fork();
  }
  {
    event_address = 0;
    ThreadRegistry process;
    ThreadControl caller;
    caller.attributes.tid = 1;
    require(!process.quiescent_fork_caller(caller));
    {
      ThreadRegistryLock lock(process);
      require(lock.register_main(caller));
      require(!process.quiescent_fork_caller(caller)); // Never wait on an owner.
    }
    require(process.quiescent_fork_caller(caller));
    {
      ThreadRegistryLock lock(process);
      require(lock.reserve() && lock.cancel_reservation());
    }
    require(process.quiescent_fork_caller(caller)); // Rolled-back history is not a peer.
  }
  {
    event_address = 0;
    ThreadRegistry process;
    ThreadControl caller;
    caller.attributes.tid = 1;
    {
      ThreadRegistryLock lock(process);
      require(lock.register_main(caller));
    }
    require(process.freeze_for_fork(caller));
    process.restore_fork_child(caller, internal::ForkRecovery::child(true, true));
    require(process.quiescent_fork_caller(caller)); // Coordinated child is quiescent.
    {
      ThreadRegistryLock lock(process);
      require(lock.begin_helper_creation());
    }
    require(!process.quiescent_fork_caller(caller));
    {
      ThreadRegistryLock lock(process);
      require(lock.cancel_helper_reservation());
    }
    require(process.quiescent_fork_caller(caller)); // A cancelled helper is absent.
  }
  {
    event_address = 0;
    ThreadRegistry process;
    ThreadControl caller;
    caller.attributes.tid = 1;
    {
      ThreadRegistryLock lock(process);
      require(lock.register_main(caller));
    }
    require(process.freeze_for_fork(caller));
    process.restore_fork_child(caller, internal::ForkRecovery::child());
    require(!process.quiescent_fork_caller(caller)); // Exec-only is never recovered.
  }
  // History alone neither proves nor disproves a recoverable snapshot. The
  // bootstrap must drain the helper, and registry ownership must agree.
  for (unsigned detached = 0; detached != 2; ++detached) {
    event_address = 0;
    ThreadRegistry process;
    ThreadControl caller, peer, helper;
    caller.attributes.tid = 1;
    {
      ThreadRegistryLock lock(process);
      require(lock.register_main(caller) && lock.sole_fork_caller(caller));
      require(lock.reserve() && !lock.sole_fork_caller(caller));
      require(lock.cancel_reservation() && lock.sole_fork_caller(caller));
    }
    bool single = true;
    require(process.freeze_for_fork(caller, 0, &single) && !single);
    process.release_after_fork();
    require(process.freeze_for_fork(caller, 0, &single, true) && single);
    process.release_after_fork();
    {
      ThreadRegistryLock lock(process);
      require(lock.reserve() && lock.insert(peer, detached));
      require(lock.start(peer) && lock.drop_creator(peer));
      require(!lock.sole_fork_caller(caller));
      require(lock.begin_cleanup(peer) && lock.close_leases(peer));
      require(lock.exit_ready(peer, 0) && !lock.sole_fork_caller(caller));
      peer.clear_tid.value.store(0);
      if (!detached) {
        require(lock.pin(&peer.attributes) == &peer && lock.claim_join(peer));
        require(lock.unpin(peer));
      }
      require(lock.begin_reaping(peer) && lock.finish_reaping(peer));
      require(lock.sole_fork_caller(caller));
      require(lock.begin_helper_creation());
      require(lock.insert(helper, true, true) && lock.start(helper));
      require(lock.drop_creator(helper) && lock.begin_cleanup(helper));
      require(lock.close_leases(helper) && lock.exit_ready(helper, 0));
      require(lock.termination_action(helper) == ThreadTermination::ThreadOnly);
      require(!lock.queued_reclaims());
      helper.clear_tid.value.store(0);
      require(lock.begin_reaping(helper) && lock.finish_reaping(helper));
    }
    require(process.freeze_for_fork(caller, 0, &single, true) && single);
    process.restore_fork_child(caller, internal::ForkRecovery::child(single, true));
    { ThreadRegistryLock lock(process); require(lock.reserve()); }
  }
  // Admission is exclusive with both ordinary and helper creation, and never
  // reopens after a creation reservation is cancelled.
  for (unsigned helper = 0; helper != 2; ++helper) {
    ThreadRegistry process;
    ThreadControl main, other;
    main.attributes.tid = 321;
    event_address = 0;
    ThreadRegistryLock lock(process);
    require(!lock.begin_process_operation(main));
    require(lock.register_main(main));
    require(!lock.begin_process_operation(other));
    require(lock.begin_process_operation(main));
    require(!lock.begin_process_operation(main));
    require(!lock.reserve() && !lock.begin_helper_creation());
    require(!lock.insert(other, true, true));
    require(lock.end_process_operation() && !lock.end_process_operation());
    require(lock.begin_process_operation(main) && lock.end_process_operation());
    if (helper) require(lock.begin_helper_creation() && lock.cancel_helper_reservation());
    else require(lock.reserve() && lock.cancel_reservation());
    require(!lock.begin_process_operation(main));
  }
  // Explicit finalization closes creation even with live threads/reservations.
  // Last-thread election and explicit exit share a single cleanup claim.
  for (unsigned elected = 0; elected != 2; ++elected) {
    ThreadRegistry process;
    ThreadControl main;
    main.attributes.tid = 321;
    event_address = 0;
    ThreadRegistryLock lock(process);
    if (elected) {
      require(lock.claim_process_exit());
    } else {
      require(lock.register_main(main) && lock.reserve());
    }
    require(lock.claim_process_cleanup());
    require(lock.process_exiting() && !lock.reserve());
    require(!lock.claim_process_cleanup() && !lock.claim_process_exit());
  }
  // Signal-side cleanup cannot acquire an interrupted registry lock. Both
  // entry paths share ownership, while the locked wrapper retains its event.
  for (unsigned locked_first = 0; locked_first != 2; ++locked_first) {
    ThreadRegistry process;
    ThreadControl main, pending, helper;
    main.attributes.tid = 321;
    event_address = 0;
    {
      ThreadRegistryLock lock(process);
      require(lock.register_main(main) && lock.reserve());
      require(lock.begin_helper_creation());
    }
    unsigned before = wakes;
    {
      ThreadRegistryLock lock(process);
      auto sequence = lock.sequence();
      if (locked_first) {
        require(lock.claim_process_cleanup());
        require(!process.claim_process_cleanup());
      } else {
        require(process.claim_process_cleanup());
        require(!lock.claim_process_cleanup());
      }
      require(lock.sequence() == sequence && lock.process_exiting());
      require(!lock.reserve() && !lock.begin_helper_creation());
      require(!lock.insert(pending, false) && !lock.insert(helper, true, true));
      require(!lock.claim_process_exit() && !process.claim_process_cleanup());
    }
    require(wakes == before + locked_first);
    // A restricted single-task child can inherit a claimed atomic and a held
    // mutex. Reclaim only process cleanup, never unlock copied runtime locks.
    {
      ThreadRegistryLock lock(process);
      require(process.claim_process_cleanup(true));
      require(!process.claim_process_cleanup() && !lock.claim_process_cleanup());
      require(lock.process_exiting() && !lock.reserve());
    }
    process.restore_fork_child(main, internal::ForkRecovery::child(true, true));
    {
      ThreadRegistryLock lock(process);
      require(!lock.pending_helper_creations());
      require(!lock.process_exiting() && lock.reserve());
      require(lock.cancel_reservation() && lock.claim_process_cleanup());
    }
  }
  for (unsigned owner = 0; owner != 3; ++owner)
    for (unsigned creator = 0; creator != 4; ++creator)
      for (unsigned reader = 0; reader != 4; ++reader)
        schedule(owner, creator, reader);
  ThreadRegistry registry, other;
  ThreadControl helper, early;
  event_address = 0;
  {
    ThreadRegistryLock lock(registry);
    require(lock.begin_helper_creation());
    require(lock.insert(helper, true, true) && lock.live_threads() == 0);
    require(!lock.pin(&helper.attributes) && lock.start(helper));
    require(lock.reserve());
    require(lock.insert(early, false));
    require(lock.pin(&early.attributes) == &early && lock.claim_join(early));
    early.clear_tid.value.store(0);
    require(lock.close_leases(early) && !lock.begin_reaping(early));
    require(lock.release_join(early) && lock.detach(early));
    require(!lock.begin_reaping(early)); // No cleanup/result publication.
  }
  event_address = 0;
  {
    ThreadRegistryLock lock(other);
    require(!lock.pin(&early.attributes) && !lock.unpin(early));
  }
#ifdef NATIVE_CONCURRENCY
  concurrency();
  admission_concurrency();
#endif
  return 0;
}
