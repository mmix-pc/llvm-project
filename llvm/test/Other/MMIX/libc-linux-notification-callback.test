# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-thread-create.test %t/base
# RUN: split-file %S/libc-linux-synchronization.test %t/sync
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
common = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
          "-DLIBC_NAMESPACE=callback_test", "-DLIBC_MMIX_PTHREAD_SCHEDULING",
          "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
          "-I", str(root / "base/headers"), "-I", str(root / "sync"), "-I", str(libc),
          "-I", str(libc / "include")]
source = libc / "src/__support/threads/linux/mmix/notification_callback.cpp"
for shared in (False, True):
    flags = common + (["-DLIBC_MMIX_SHARED_STARTUP"] if shared else [])
    for opt in ("0", "2"):
        stem = root / ("callback-" + str(shared) + "-O" + opt)
        obj = str(stem) + ".o"
        subprocess.run(["clang", "-cc1", "-triple", "mmix-unknown-linux",
            "-mrelocation-model", "pic" if shared else "static",
            "-internal-isystem", resource + "/include", *flags, "-O" + opt,
            "-emit-obj", str(source), "-o", obj], check=True)
        undefined = subprocess.check_output(["llvm-nm", "-u", obj], text=True)
        assert ('retain_shared_tls_destructor' in undefined) == shared
        assert ('release_shared_tls_destructor' in undefined) == shared
        assert all(x not in undefined for x in ('__atomic_', '__emutls', 'pthread_'))
        if len(sys.argv) == 4:
            subprocess.run([sys.argv[3], *flags, "-D__mmix__", "-O" + opt,
                str(source), str(root / "test.cpp"), "-o", str(stem)], check=True)
            subprocess.run([str(stem)], check=True, timeout=10)
            print(f'Callback ownership/attributes: O{opt} shared={shared} passed', flush=True)

#--- test.cpp
#include "src/__support/threads/linux/mmix/notification_callback.h"
#include "hdr/errno_macros.h"
#include "hdr/pthread_macros.h"
#include "hdr/signal_macros.h"
using namespace callback_test;
using namespace callback_test::mmix;

static void check(bool b) { if (!b) __builtin_abort(); }
alignas(16) static unsigned char storage[4096];
static bool allocated, allocation_failure;
static unsigned allocations, frees, retains, releases, invocations;
static long retain_error, release_error;
static int scheduling_error;
static void notify(sigval value) {
  check(allocated && value.sival_int == 73);
  ++invocations;
}
namespace callback_test {
void *malloc(size_t bytes) {
  check(!allocated && bytes <= sizeof(storage));
  ++allocations;
  if (allocation_failure) return nullptr;
  allocated = true;
  return storage;
}
void free(void *p) {
  check(allocated && p == storage);
  allocated = false;
  ++frees;
}
namespace mmix {
int scheduling_validate(int policy, int priority) {
  if (scheduling_error) return scheduling_error;
  return (policy == 0 && priority == 0) || (policy == 1 && priority == 8) ? 0 : EINVAL;
}
long retain_shared_tls_destructor(void *dso, uintptr_t code, uint64_t *out) {
  check(!dso && code == reinterpret_cast<uintptr_t>(notify) && *out == 0);
  ++retains;
  if (retain_error) return retain_error;
  *out = 17;
  return 0;
}
long release_shared_tls_destructor(uint64_t pin) {
  check(pin == 17 && allocated);
  ++releases;
  return release_error;
}
}}
static sigevent event() {
  sigevent value{};
  value.sigev_notify = SIGEV_THREAD;
  value.sigev_notify_function = notify;
  value.sigev_value.sival_int = 73;
  return value;
}
static pthread_attr_t attributes() {
  return {PTHREAD_CREATE_JOINABLE, nullptr, 65536, 8192, 1, 8,
          PTHREAD_EXPLICIT_SCHED, PTHREAD_SCOPE_SYSTEM};
}
static void rejected(sigevent e, long error, uintptr_t page_size = 8192) {
  auto *out = reinterpret_cast<NotificationCallback *>(1);
  unsigned before = allocations;
  check(NotificationCallback::create(e, {}, page_size, out) == error);
  check(out == reinterpret_cast<NotificationCallback *>(1) && !allocated);
  check(allocations == before);
}
extern "C" int main() {
  auto e = event();
  auto invalid = e;
  invalid.sigev_notify = SIGEV_SIGNAL;
  rejected(invalid, EINVAL);
  invalid = e;
  invalid.sigev_notify_function = nullptr;
  rejected(invalid, EINVAL);
  rejected(e, EINVAL, 4096);
  auto attr = attributes();
  e.sigev_notify_attributes = &attr;
  attr.__stacksize = 1;
  rejected(e, EINVAL);
  attr = attributes(); attr.__scope = PTHREAD_SCOPE_PROCESS;
  rejected(e, ENOTSUP);
  attr = attributes(); attr.__inheritsched = 99;
  rejected(e, EINVAL);
  attr = attributes(); attr.__detachstate = 99;
  rejected(e, EINVAL);
  attr = attributes(); attr.__guardsize = 1;
  NotificationCallback *rounded = nullptr;
  check(!NotificationCallback::create(e, {}, 8192, rounded));
  check(rounded->thread_preparation().guard_size == 1);
  check(!rounded->release() && !allocated);
  attr = attributes(); attr.__guardsize = SIZE_MAX;
  rejected(e, EOVERFLOW);
  attr = attributes(); attr.__stack = reinterpret_cast<void *>(0x10001);
  rejected(e, EINVAL);
  attr = attributes(); attr.__stack = reinterpret_cast<void *>(UINTPTR_MAX - 15);
  rejected(e, EOVERFLOW);
  attr = attributes(); attr.__stacksize = SIZE_MAX;
  rejected(e, EOVERFLOW);
  attr = attributes(); scheduling_error = EPERM;
  rejected(e, EPERM);
  scheduling_error = 0;
  attr = attributes(); attr.__schedpriority = 9;
  rejected(e, EINVAL);
  attr = attributes();
  NotificationCallback *out = reinterpret_cast<NotificationCallback *>(1);
  allocation_failure = true;
  check(NotificationCallback::create(e, {}, 8192, out) == ENOMEM);
  check(!allocated && out == reinterpret_cast<NotificationCallback *>(1));
  allocation_failure = false;
#ifdef LIBC_MMIX_SHARED_STARTUP
  retain_error = EBUSY;
  check(NotificationCallback::create(e, {}, 8192, out) == EBUSY);
  check(!allocated && out == reinterpret_cast<NotificationCallback *>(1));
  retain_error = 0;
#endif
  attr.__stack = reinterpret_cast<void *>(0x10000);
  check(!NotificationCallback::create(e, {}, 8192, out));
  check(allocated && out->supplied_stack());
  e.sigev_value.sival_int = 0;
  e.sigev_notify_function = nullptr;
  attr = {};
  auto request = out->thread_preparation();
  check(request.detached && request.stack == reinterpret_cast<void *>(0x10000));
  check(request.stack_size == 65536 && request.guard_size == 8192);
  check(request.apply_scheduling && request.scheduling_policy == 1 && request.scheduling_priority == 8);
  check(request.resource_owner.context == out && request.resource_owner.valid());
  check(request.resource_owner.terminal_runner == request.runner.posix_runner);
  check(request.argument == out);
  check(!request.resource_owner.retain(out)); // Thread preparation reference.
  check(!out->release() && allocated); // Registration removed before callback return.
  check(request.runner.posix_runner(request.argument) == nullptr && invocations == 1);
  check(allocated); // TLS/TSS cleanup and reaping still own the callback.
#ifdef LIBC_MMIX_SHARED_STARTUP
  unsigned before = releases;
  release_error = EBUSY;
  check(request.resource_owner.release(out) == EBUSY && allocated);
  check(releases == before + 1);
  release_error = 0;
#endif
  check(!request.resource_owner.release(out) && !allocated);
  e = event();
  check(!NotificationCallback::create(e, {}, 8192, out));
  request = out->thread_preparation();
  check(!out->supplied_stack() && !request.apply_scheduling && request.detached);
  check(request.stack_size == 2 * 1024 * 1024 && request.guard_size == 8192);
  check(!out->retain() && !out->retain());
  check(!out->release() && !out->release() && allocated);
  check(!out->release() && !allocated);
#ifndef LIBC_MMIX_SHARED_STARTUP
  check(!retains && !releases);
#endif
  check(frees + 1 == allocations); // One injected allocation failure.
  return 0;
}
