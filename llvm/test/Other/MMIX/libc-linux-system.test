# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../../libc %t

#--- check.py
import pathlib
import subprocess
import sys

libc, root = (pathlib.Path(p).resolve() for p in sys.argv[1:3])
config = root / "selection.cmake"
config.write_text('''
set(system_extra_deps "")
set(system_options "")
include("${LIBC_SOURCE}/src/stdlib/linux/mmix/System.cmake")
if(NOT system_source STREQUAL "mmix/system.cpp" OR system_platform_deps)
  message(FATAL_ERROR "system must use MMIX process and signal policy")
endif()
if(LIBC_MMIX_BUILD_COORDINATED_FORK)
  if(NOT "libc.src.__support.threads.linux.mmix.fork_runtime" IN_LIST system_extra_deps)
    message(FATAL_ERROR "missing fork coordination")
  endif()
endif()
if(LIBC_MMIX_BUILD_CANCELLATION_WINDOWS)
  if(NOT "-DLIBC_MMIX_SYSTEM_CANCELLATION" IN_LIST system_options OR
     NOT "libc.src.__support.threads.linux.mmix.cancellation_point" IN_LIST system_extra_deps)
    message(FATAL_ERROR "missing cancellation integration")
  endif()
endif()
''')
for enabled in ("OFF", "ON"):
    subprocess.run(["cmake", "-DCMAKE_POLICY_DEFAULT_CMP0057=NEW",
                    f"-DLIBC_SOURCE={libc}",
                    f"-DLIBC_MMIX_BUILD_COORDINATED_FORK={enabled}",
                    f"-DLIBC_MMIX_BUILD_CANCELLATION_WINDOWS={enabled}",
                    "-P", str(config)], check=True)

# Optional native policy validation uses an explicitly selected host compiler.
# Platform coordination is injected; this does not claim MMIX guest execution.
if len(sys.argv) == 4:
    for opt in ("0", "2"):
        exe = root / ("native-O" + opt)
        subprocess.run([sys.argv[3], "-std=c++17", "-pthread", "-O" + opt,
                        "-DLIBC_NAMESPACE=system_test", "-DLIBC_ERRNO_MODE=6",
                        "-I", str(libc),
                        str(libc / "test/src/stdlib/mmix_system_native.cpp"),
                        "-o", str(exe)], check=True)
        subprocess.run([str(exe)], check=True, timeout=30)
