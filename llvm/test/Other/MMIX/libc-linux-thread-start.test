# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-synchronization.test %t/sync
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import re
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
common = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
          "-DLIBC_NAMESPACE=entry_test", "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
          "-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL",
          "-I", str(root / "headers"), "-I", str(root / "sync"),
          "-I", str(libc), "-I", str(libc / "include")]
source = libc / "src/__support/threads/linux/mmix/thread_start.cpp"
errno = libc / "src/errno/libc_errno.cpp"
for opt in ("0", "2"):
    base = ["clang", "-cc1", "-triple", "mmix-unknown-linux",
            "-mrelocation-model", "static", "-internal-isystem", resource + "/include",
            "-ftls-model=local-exec", *common, "-O" + opt]
    obj, ir = root / ("entry-O" + opt + ".o"), root / ("entry-O" + opt + ".ll")
    subprocess.run(base + ["-emit-obj", str(source), "-o", str(obj)], check=True)
    subprocess.run(base + ["-emit-llvm", str(source), "-o", str(ir)], check=True)
    text = ir.read_text()
    assert 'define hidden' in text and '@__llvm_libc_mmix_thread_start' in text
    assert '"disable-tail-calls"="true"' in text and 'noinline' in text
    assert 'load atomic i32' in text and 'acquire' in text and 'release' in text
    assert not re.search(r'\b(?:musttail|tail) call.*@__llvm_libc_mmix_thread_(run|abort)', text)
    report = subprocess.check_output(["llvm-readobj", "--sections", "--relocations", str(obj)], text=True)
    assert "SHF_TLS" in report and "R_MMIX_TPREL" in report and ".init_array" not in report
    disasm = subprocess.check_output(["llvm-objdump", "-dr", str(obj)], text=True)
    assert "r230" in disasm and "PUSHGO r31" in disasm and "TRAP 0xff" in disasm
    assert not re.search(r'\bPUT r(?:A|O|S|L)\b|\bOR r230,', disasm)
    symbols = subprocess.check_output(["llvm-nm", "-u", str(obj)], text=True)
    assert '__llvm_libc_mmix_thread_run' in symbols and '__llvm_libc_mmix_thread_abort' in symbols
    for forbidden in ('__tls_get_addr', '__emutls', 'pthread_', 'feset', 'malloc', 'free'):
        assert forbidden not in symbols, symbols
    if len(sys.argv) == 4:
        import resource as limits
        limits.setrlimit(limits.RLIMIT_CORE, (0, 0))
        exe = root / ("host-O" + opt)
        subprocess.run([sys.argv[3], *common, "-D__mmix__", "-O" + opt,
            "-include", str(root / "transport.h"), str(source), str(errno),
            str(root / "test.cpp"), "-o", str(exe)], check=True)
        # Each scenario starts with fresh native TLS. Injection does not
        # execute MMIX clone/TP handoff or establish kernel thread support.
        for mode in range(16):
            subprocess.run([str(exe), str(mode)], check=True, timeout=10)
        print("Native child startup: 16 scenarios passed at O" + opt, flush=True)

#--- headers/sys/syscall.h
#define SYS_gettid 178
#define SYS_futex 98
#define SYS_write 64
#--- headers/linux/param.h
#define EXEC_PAGESIZE 8192
#--- transport.h
#define LLVM_LIBC_SRC___SUPPORT_OSUTIL_LINUX_X86_64_SYSCALL_H
#include "src/__support/OSUtil/linux/mmix/syscall.h"

#--- test.cpp
#include "src/__support/threads/linux/mmix/thread_start.h"
#include "src/__support/threads/linux/mmix/lifecycle.h"
#include "src/__support/threads/thread.h"
#include "src/__support/libc_errno.h"
#include "hdr/errno_macros.h"
#include <sys/syscall.h>
#include <linux/futex.h>
using namespace entry_test;
using namespace entry_test::mmix;
namespace entry_test::mmix {
thread_local ThreadControl *current_control = nullptr;
}
extern "C" int fork();
extern "C" int waitpid(int, int *, int);
static void require(bool value) { if (!value) __builtin_abort(); }
static unsigned mode, waits, wakes, continuations, managers, identities;
static ThreadControl control;
struct Done {};

namespace entry_test { namespace internal {
ThreadAtExitCallbackMgr *get_thread_atexit_callback_mgr() {
  require(self.attrib == &control.attributes && int(libc_errno) == 0);
  require(control.attributes.tid == 321 && !wakes && !waits);
  ++managers;
  return mode == 5 || mode == 15 ? nullptr : reinterpret_cast<ThreadAtExitCallbackMgr *>(1);
}
} }

extern "C" long __llvm_libc_mmix_syscall(unsigned long n, long a, long b,
                                         long c, long d, long e, long f) {
  if (n == SYS_gettid) {
    require(!(a | b | c | d | e | f) && !wakes && !waits);
    ++identities;
    return mode == 2 ? -EAGAIN : mode == 3 ? 0 : mode == 4 ? 2147483648L : 321;
  }
  require(n == SYS_futex && !d && !e);
  if (b == FUTEX_WAKE_PRIVATE) {
    require(a == reinterpret_cast<long>(&control.child_status.value.val));
    require(c == 2147483647 && !f && !wakes++);
    bool failed = (mode >= 2 && mode <= 5) || mode == 15;
    require(control.acquire_child() == (failed ? ChildStatus::Failed : ChildStatus::Ready));
    require(control.child_error == (mode == 2 ? EAGAIN : mode == 3 || mode == 4 ? EINVAL : mode == 5 || mode == 15 ? ENOMEM : 0));
    require(!continuations);
    if (mode == 0) control.publish_decision(CreatorDecision::Go); // Before wait.
    if (mode == 1 || failed || mode == 13) control.publish_decision(CreatorDecision::Abort);
    if (mode == 15) control.publish_decision(CreatorDecision::Go);
    if (mode == 9) return -EFAULT;
    return 0;
  }
  require(b == FUTEX_WAIT_BITSET_PRIVATE && c == 0 && f == 0xffffffffu);
  require(a == reinterpret_cast<long>(&control.creator_decision.value.val));
  require(wakes == 1 && !continuations);
  ++waits;
  if (mode == 10) return -EFAULT;
  if (waits == 1) return -EINTR;
  if (waits == 2) return -EAGAIN;
  if (waits == 3) return 0; // Spurious wake keeps HOLD.
  require(waits == 4);
  control.publish_decision(CreatorDecision::Go);
  return -EAGAIN;
}
extern "C" void __llvm_libc_mmix_thread_run(ThreadControl *c) {
  require(c == &control && c->acquire_decision() == CreatorDecision::Go);
  require(c->acquire_child() == ChildStatus::Ready && managers == 1);
  require(internal::self.attrib == &c->attributes && int(libc_errno) == 0);
  require(current_control == c);
  require(c->attributes.tls == 8192 && c->attributes.tls_size == 8192);
  require(c->attributes.stack == reinterpret_cast<void *>(32768));
  require(c->attributes.stacksize == 16384 && c->attributes.guardsize == 8192);
  require(c->attributes.owned_stack && c->attributes.platform_data == &c->clear_tid.value.val);
  require(c->saved_signal_mask == 0x1234 && c->clear_tid.value.load() == UINT32_MAX);
  ++continuations;
  if (mode == 11) return; // The ordinary frame must trap, not return to clone.
  throw Done{};
}
extern "C" void __llvm_libc_mmix_thread_abort(ThreadControl *c) {
  require(c == &control && c->acquire_decision() == CreatorDecision::Abort);
  require(wakes == 1 && !waits && !continuations++);
  if (mode == 13) return;
  throw Done{};
}
extern "C" int main(int argc, char **argv) {
  require(argc == 2);
  mode = unsigned(argv[1][0] - '0');
  if (argv[1][1]) mode = 10 * mode + unsigned(argv[1][1] - '0');
  control.stack_bottom = 32768;
  control.stack_top = 49152;
  control.guard_size = 8192;
  control.owns_stack = true;
  control.tls = {8192, 8192, 8208};
  control.saved_signal_mask = 0x1234;
  if (mode != 14) control.publish_prepared();
  libc_errno = 99;
  // Fork isolates deliberate traps from the harness, with no timing-based
  // semantic assertion. subprocess's outer deadline bounds a missing notice.
  bool traps = mode >= 7;
  int child = traps ? fork() : 0;
  require(child >= 0);
  if (child) {
    int status;
    require(waitpid(child, &status, 0) == child && (status & 127) == 4);
    return 0;
  }
  try {
    if (mode == 8) internal::self.attrib = &control.attributes;
    if (mode == 12) control.publish_decision(static_cast<CreatorDecision>(99));
    __llvm_libc_mmix_thread_start(mode == 7 ? nullptr : &control);
  } catch (Done) {
    require(!traps && continuations == 1 && wakes == 1 && identities == 1);
    require(mode == 6 ? waits == 4 : waits == 0);
    return 0;
  }
}
