# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-synchronization.test %t/sync
# RUN: split-file %S/libc-linux-thread-resources.test %t/resources
# RUN: split-file %S/libc-linux-thread-create.test %t/create
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(['clang', '-print-resource-dir'], text=True).strip()
common = ['-std=c++17', '-ffreestanding', '-fno-builtin', '-DLIBC_FULL_BUILD',
          '-DLIBC_NAMESPACE=reclaim_test', '-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM',
          '-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL', '-I', str(root/'headers'),
          '-I', str(root/'resources/headers'), '-I', str(root/'sync'), '-I', str(libc),
          '-I', str(libc/'include'), '-I', str(root/'create/headers')]
sources = [libc/'src/__support/threads/linux/mmix'/n for n in
           ('thread_reclaim.cpp', 'resources.cpp', 'tls.cpp', 'lifecycle.cpp', 'thread_create.cpp')]
for opt in ('0', '2'):
    objects = []
    for index, source in enumerate(sources):
        obj = root / (str(index)+'-O'+opt+'.o')
        subprocess.run(['clang', '-cc1', '-triple', 'mmix-unknown-linux',
            '-mrelocation-model', 'static', '-internal-isystem', resource+'/include',
            *common, '-O'+opt, '-emit-obj', str(source), '-o', str(obj)], check=True)
        objects.append(str(obj))
    combined = root/('reclaim-O'+opt+'.o')
    subprocess.run(['ld.lld', '-r', *objects, '-o', str(combined)], check=True)
    undefined = subprocess.check_output(['llvm-nm', '-u', str(combined)], text=True)
    # Reaper bootstrap is injected here; its dedicated test executes production.
    assert {l.split()[-1] for l in undefined.splitlines() if 'ensure_thread_reaper' not in l} <= {
        '__llvm_libc_mmix_syscall', '__llvm_libc_mmix_clone_thread', 'memcpy', 'memset'}, undefined
    report = subprocess.check_output(['llvm-readobj', '--sections', str(combined)], text=True)
    for forbidden in ('.init_array', 'SHF_TLS', '.MMIX.reg_contents'):
        assert forbidden not in report
    if len(sys.argv) == 4:
        import resource as limits
        limits.setrlimit(limits.RLIMIT_CORE, (0, 0))
        exe = root/('host-O'+opt)
        subprocess.run([sys.argv[3], *common, '-D__mmix__',
            '-include', str(root/'transport.h'),
            '-O'+opt, *map(str, sources), str(root/'test.cpp'), '-o', str(exe)], check=True)
        for mode in range(17):
            subprocess.run([str(exe), str(mode)], check=True, timeout=10)
        print('Native reclamation: 17 scenarios passed at O'+opt, flush=True)

#--- headers/sys/syscall.h
#define SYS_mmap 222
#define SYS_munmap 215
#define SYS_mprotect 226
#define SYS_futex 98
#define SYS_write 64
#define SYS_clock_gettime 113
#define SYS_rt_sigprocmask 135
#--- headers/linux/errno.h
#include "include/llvm-libc-macros/generic-error-number-macros.h"
#define EWOULDBLOCK EAGAIN
#define ETIMEDOUT 110
#define ENOSYS 38
#define EOVERFLOW 75
#--- transport.h
#define LLVM_LIBC_SRC___SUPPORT_OSUTIL_LINUX_X86_64_SYSCALL_H
#include "src/__support/OSUtil/linux/mmix/syscall.h"
#--- test.cpp
#include "src/__support/threads/linux/mmix/thread_reclaim.h"
#include "src/__support/threads/linux/mmix/thread_create.h"
#include "hdr/errno_macros.h"
#include <linux/futex.h>
#include <sys/syscall.h>
using namespace reclaim_test;
using namespace reclaim_test::mmix;
namespace reclaim_test { namespace mmix {
ThreadCreationResult ensure_thread_reaper(const TLSImage &, uintptr_t) { return {}; }
} }
extern "C" int fork();
extern "C" int waitpid(int, int *, int);
extern "C" void *memset(void *, int, __SIZE_TYPE__);
extern "C" int printf(const char *, ...);
static void check(bool ok, unsigned line) {
  if (!ok) { printf("reclaim check failed: %u\n", line); __builtin_abort(); }
}
#define require(x) check(bool(x), __LINE__)
alignas(8192) static unsigned char control_mem[8192], stack_mem[73728], tls_mem[8192];
alignas(8) static unsigned char caller_stack[65536];
static ThreadControl *control;
static ThreadControl main_control;
static unsigned mode, maps, unmaps, shared_waits, private_waits, wakes;
static bool reclaiming;
static uintptr_t bases[3];
static size_t sizes[3];
static void *runner(void *p) { return p; }
extern "C" long __llvm_libc_mmix_clone_thread(unsigned long, uintptr_t,
    uint32_t *parent, uint32_t *clear, uintptr_t) {
  require(mode == 15 || mode == 16);
  control = reinterpret_cast<ThreadControl *>(control_mem);
  *parent = 71;
  require(clear == &control->clear_tid.value.val);
  if (mode == 15) control->publish_child(ChildStatus::Failed, ENOMEM);
  control->clear_tid.value.store(0, cpp::MemoryOrder::RELEASE);
  return 71;
}
extern "C" long __llvm_libc_mmix_syscall(unsigned long n, long a, long b,
    long c, long d, long e, long f) {
  if (n == SYS_rt_sigprocmask) {
    require(mode >= 15);
    if (c) *reinterpret_cast<uint64_t *>(c) = 0x1234;
    return 0;
  }
  if (n == SYS_mmap) {
    unsigned i = maps++;
    require(i < 3);
    unsigned char *p = i == 0 ? control_mem : (mode == 4 || i == 2) ? tls_mem : stack_mem;
    bases[i] = reinterpret_cast<uintptr_t>(p); sizes[i] = b;
    return bases[i];
  }
  if (n == SYS_mprotect) return 0;
  if (n == SYS_clock_gettime) {
    if (mode == 13) return -ENOSYS;
    *reinterpret_cast<timespec *>(a == CLOCK_MONOTONIC ? b : 0) = {10, 0};
    return 0;
  }
  if (n == SYS_futex) {
    if (b == FUTEX_WAKE_PRIVATE) {
      require(!control || a != reinterpret_cast<long>(&control->clear_tid.value.val));
      ++wakes; return 0;
    }
    require(!unmaps && e == 0 && f == FUTEX_BITSET_MATCH_ANY);
    auto *ts = reinterpret_cast<timespec *>(d);
    require(ts && ts->tv_sec == 11 && ts->tv_nsec == 0);
    if (b == FUTEX_WAIT_BITSET) {
      require(a == reinterpret_cast<long>(&control->clear_tid.value.val));
      require(c == UINT32_MAX);
      ++shared_waits;
      if (mode == 12) return -EFAULT;
      if (shared_waits == 1) return -EINTR;
      if (shared_waits == 2) return -EAGAIN;
      if (shared_waits == 3) return -ETIMEDOUT;
      if (shared_waits == 4) return 0; // Late wake/key reuse is not clear.
      require(shared_waits == 5);
      control->clear_tid.value.store(0, cpp::MemoryOrder::RELEASE);
      return 0;
    }
    require(b == FUTEX_WAIT_BITSET_PRIVATE && mode == 2);
    require(a != reinterpret_cast<long>(&control->clear_tid.value.val));
    ++private_waits;
    ThreadRegistryLock lock(thread_registry); // Wait must not hold registry lock.
    require(!lock.pin(&control->attributes));
    require(!lock.begin_reaping(*control)); // Exclusive ownership cannot be stolen.
    require(!lock.acquire_lease(*control));
    if (private_waits == 1) return -ETIMEDOUT;
    require(private_waits == 2);
    require(lock.drop_creator(*control) && lock.unpin(*control));
    return 0;
  }
  if (n == SYS_munmap) {
    require(reclaiming && unmaps < maps);
    // Actual resource implementation must release TLS, owned stack, then control.
    unsigned i = maps - 1 - unmaps++;
    require(uintptr_t(a) == bases[i] && size_t(b) == sizes[i]);
    {
      ThreadRegistryLock lock(thread_registry);
      require(!lock.pin(&control->attributes));
      require(lock.owner(*control) == ThreadOwner::Reaped);
      require(!lock.finish_reaping(*control) && !lock.begin_reaping(*control));
    }
    if ((mode == 5 && i == maps-1) || (mode == 6 && i == 1) ||
        (mode == 7 && i == 0) || mode == 8) return -EINVAL;
    memset(reinterpret_cast<void *>(a), 0xa5, b);
    return 0;
  }
  __builtin_trap();
}
extern "C" int main(int argc, char **argv) {
  require(argc == 2);
  for (const char *p = argv[1]; *p; ++p) mode = mode*10 + *p-'0';
  ThreadPreparation request;
  request.runner.posix_runner = runner;
  if (mode >= 15) {
    { ThreadRegistryLock lock(thread_registry);
      main_control.attributes.tid = 1;
      require(lock.register_main(main_control)); }
    ThreadAttributes *out = &main_control.attributes;
    reclaiming = true;
    auto result = create_thread(request, out);
    require(result.error == (mode == 15 ? -ENOMEM : -EAGAIN));
    require(out == &main_control.attributes && unmaps == maps && maps == 3);
    ThreadRegistryLock lock(thread_registry);
    require(!lock.pending_creations() && lock.live_threads() == 1);
    return 0;
  }
  if (mode == 4) { request.stack = caller_stack; request.guard_size = 0; }
  require(prepare_thread(request, control).error == ThreadPrepareError::None);
  ThreadOwner owner = mode == 3 ? ThreadOwner::JoinOwner :
      (mode == 2 || mode == 4) ? ThreadOwner::Detached : ThreadOwner::AbortOwner;
  {
    ThreadRegistryLock lock(thread_registry);
    main_control.attributes.tid = 1;
    require(lock.register_main(main_control));
    if (owner == ThreadOwner::AbortOwner) {
      require(lock.adopt_abort(*control));
      if (mode != 9) require(lock.abort_ready(*control));
    } else {
      require(lock.reserve() && lock.insert(*control, owner == ThreadOwner::Detached));
      require(lock.start(*control) && lock.begin_cleanup(*control));
      require(lock.close_leases(*control) && lock.exit_ready(*control, ThreadReturnValue(42)));
      if (mode == 2 || mode == 3) require(lock.pin(&control->attributes) == control);
      if (mode == 3) require(lock.claim_join(*control));
      if (mode != 2) require(lock.drop_creator(*control));
    }
    if (mode == 10) require(lock.drop_creator(*control)); // Invalid abort owner pin.
  }
  if (mode != 1 && mode != 12 && mode != 13)
    control->clear_tid.value.store(0, cpp::MemoryOrder::RELEASE);
  bool fatal = mode >= 10;
  if (fatal) {
    int child = fork(); require(child >= 0);
    if (child) { int status; require(waitpid(child, &status, 0) == child);
      require((status & 127) == 4); return 0; }
  }
  ThreadResources retained;
  reclaiming = true;
  if (mode == 14) {
    // Production failed-create continuation must not return after unmap failure.
    mode = 8;
    __llvm_libc_mmix_reclaim_failed_thread(control);
  } else if (mode == 11) {
    reclaim_thread(*control, ThreadOwner::Detached, retained);
  } else {
    long error = reclaim_thread(*control, owner, retained);
    require(!fatal);
    require(error == ((mode >= 5 && mode <= 8) ? EINVAL : 0));
    require(bool(retained.tls.size) == (mode == 5 || mode == 8));
    require(bool(retained.stack.size) == (mode == 6 || mode == 8));
    require(bool(retained.control.size) == (mode == 7 || mode == 8));
    require(unmaps == maps && wakes);
    require(shared_waits == (mode == 1 ? 5 : 0));
    require(private_waits == (mode == 2 ? 2 : 0));
    for (auto c : caller_stack) require(c == 0);
    return 0;
  }
  __builtin_abort();
}
