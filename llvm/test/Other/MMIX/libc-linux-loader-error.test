# REQUIRES: mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../.. %t %mmix_host_cxx

# Actual wrapper with injected service results; guest TLS/cancellation is separate.
#--- run.py
import pathlib
import shlex
import subprocess
import sys
source, out = map(pathlib.Path, sys.argv[1:3])
for opt in ("0", "2"):
    exe = out / ("error-O" + opt)
    subprocess.run([
        *shlex.split(sys.argv[3]), "-std=c++17", "-UNDEBUG", "-O" + opt,
        "-I", str(source / "libc"), "-DLIBC_NAMESPACE=loader_error_test",
        str(source / "libc/test/src/__support/threads/mmix_loader_error_native.cpp"),
        "-o", str(exe)], check=True)
    subprocess.run([str(exe)], check=True, timeout=30)
