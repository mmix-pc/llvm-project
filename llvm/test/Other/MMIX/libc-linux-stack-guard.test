# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-process-args.test %t/args
# RUN: split-file %S/libc-linux-synchronization.test %t/args/sync
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
args = root / "args"
subprocess.run([sys.executable, str(args / "run.py"), str(libc), str(args)], check=True)
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
common = ["-std=c++17", "-ffreestanding", "-fno-builtin",
    "-DLIBC_FULL_BUILD", "-DLIBC_NAMESPACE=startup_test",
    "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_SINGLE", "-DSYS_exit=93", "-DSYS_exit_group=94",
    "-I", str(args / "headers"), "-I", str(args / "sync"),
    "-I", str(libc), "-I", str(libc / "include")]
base = ["clang", "-cc1", "-triple", "mmix-unknown-linux",
    "-mrelocation-model", "static", "-internal-isystem", resource + "/include", *common]
guard_source = libc / "startup/linux/mmix/stack_guard.cpp"
syscall = root / "syscall.o"
subprocess.run(["clang", "--target=mmix-unknown-linux", "-c",
    str(libc / "src/__support/OSUtil/linux/mmix/syscall.S"), "-o", str(syscall)], check=True)

# Verify ordinary archive extraction never pulls compiler-rt's fixed guard or
# spin-loop failure fallback when the real Linux owner is supplied by the CRT.
fallback = root / "fallback.a"
fallbacks = []
for name in ("stack_protector_guard", "stack_protector_fail"):
    obj = root / (name + ".o")
    subprocess.run(["clang", "--target=mmix-unknown-linux", "-ffreestanding",
        "-fno-stack-protector", "-c",
        str(libc.parent / "compiler-rt/lib/builtins/mmix" / (name + ".c")),
        "-o", str(obj)], check=True)
    fallbacks.append(str(obj))
subprocess.run(["llvm-ar", "rcs", str(fallback), *fallbacks], check=True)

def undefined(obj):
    text = subprocess.check_output(["llvm-nm", "-u", str(obj)], text=True)
    return {line.split()[-1] for line in text.splitlines()}

for opt in ("0", "2"):
    guard = root / ("guard-O" + opt + ".o")
    subprocess.run([*base, "-O" + opt, "-emit-obj", "-o", str(guard), str(guard_source)], check=True)
    assert undefined(guard) == {"__llvm_libc_mmix_syscall"}
    relocs = subprocess.check_output(["llvm-readobj", "--relocations", str(guard)], text=True)
    assert "R_MMIX_GETA __stack_chk_fail" not in relocs
    assert "R_MMIX_PUSHJ_STUBBABLE __stack_chk_fail" not in relocs
    assert relocs.count("R_MMIX_GETA __stack_chk_guard") == 1, relocs
    combined = root / ("bootstrap-O" + opt + ".o")
    subprocess.run(["ld.lld", "-r", str(args / ("startup-O" + opt + ".o")),
        str(guard), str(syscall), str(fallback), "-o", str(combined)], check=True)
    assert undefined(combined) == {"__llvm_libc_mmix_linux_run"}
    for source in (root / "consumer.cpp", libc / "src/__support/OSUtil/linux/exit.cpp"):
        obj = root / (source.stem + "-O" + opt + ".o")
        subprocess.run([*base, "-O" + opt, "-stack-protector", "2",
            "-emit-obj", "-o", str(obj), str(source)], check=True)
        refs = undefined(obj)
        # Retain the O0 exit-template reproducer with stack protection enabled.
        if opt == "0" or source.stem == "consumer":
            assert {"__stack_chk_guard", "__stack_chk_fail"} <= refs, refs
    linked = root / ("protected-O" + opt + ".elf")
    # Symbol-closure probe only, not an executable CRT/startup qualification.
    subprocess.run(["ld.lld", "-m", "elf64mmix_linux", "-static", "-e", "check",
        str(root / ("consumer-O" + opt + ".o")), str(root / ("exit-O" + opt + ".o")),
        str(guard), str(syscall), str(fallback), "-o", str(linked)], check=True)
    assert not undefined(linked)
    symbols = subprocess.check_output(["llvm-nm", str(linked)], text=True)
    for name, kind in (("__stack_chk_guard", "B"), ("__stack_chk_fail", "T")):
        matches = [line.split() for line in symbols.splitlines() if line.endswith(" " + name)]
        assert len(matches) == 1 and matches[0][-2] == kind, matches
    assert "__mmix_stack_chk_terminate" not in symbols
    sections = subprocess.check_output(["llvm-readobj", "--sections", str(linked)], text=True)
    assert "SHF_TLS" not in sections and ".MMIX.reg_contents" not in sections

# Host-only hooks inspect bytes and failure calls; never used in a target link.
if len(sys.argv) == 4:
    for opt in ("0", "2"):
        exe = root / ("native-O" + opt)
        subprocess.run([sys.argv[3], "-I", str(root / "fake"), *common,
            "-fno-stack-protector", "-O" + opt, str(guard_source),
            str(root / "test.cpp"), "-o", str(exe)], check=True)
        subprocess.run([str(exe)], check=True)

#--- consumer.cpp
extern "C" __attribute__((noinline)) int check(int index) {
  char data[16];
  asm volatile("" : : "r"(data) : "memory");
  return data[index & 15];
}

#--- fake/src/__support/OSUtil/linux/mmix/syscall.h
extern "C" long __llvm_libc_mmix_syscall(unsigned long, long, long, long, long, long, long);

#--- test.cpp
extern "C" {
extern __UINT64_TYPE__ __stack_chk_guard;
void __llvm_libc_mmix_linux_init_guard(const unsigned char *);
[[noreturn]] void __llvm_libc_mmix_linux_start_fail();
[[noreturn]] void __stack_chk_fail();
}
static unsigned calls;
static void require(bool condition) {
  if (!condition)
    __builtin_abort();
}
extern "C" long __llvm_libc_mmix_syscall(unsigned long number, long status,
    long a2, long a3, long a4, long a5, long a6) {
  require(number == ((calls % 2) ? SYS_exit : SYS_exit_group));
  require(status == 1 && !(a2 | a3 | a4 | a5 | a6));
  if (++calls == 4)
    throw 7;
  return -1; // Exercise both unexpected-return paths and the retry loop.
}
int main() {
  alignas(8) unsigned char bytes[17];
  for (unsigned i = 0; i != 17; ++i)
    bytes[i] = static_cast<unsigned char>(i);
  __llvm_libc_mmix_linux_init_guard(bytes + 1);
  require(__stack_chk_guard == 0x0102030405060708ULL);
  for (auto &byte : bytes)
    byte = 0;
  __llvm_libc_mmix_linux_init_guard(bytes + 1);
  require(__stack_chk_guard == 0); // Zero entropy bytes are not a fallback trigger.
  for (auto &byte : bytes)
    byte = 0xff;
  __llvm_libc_mmix_linux_init_guard(bytes + 1);
  require(__stack_chk_guard == ~static_cast<__UINT64_TYPE__>(0));
  for (unsigned path = 0; path != 2; ++path) {
    calls = 0;
    try {
      if (path)
        __stack_chk_fail();
      __llvm_libc_mmix_linux_start_fail();
    } catch (int value) {
      require(value == 7 && calls == 4);
    }
  }
  return 0;
}
