# CALLER-DAG: R_MMIX_GETA __mulsc3
# CALLER-DAG: R_MMIX_GETA __divsc3
# CALLER-DAG: R_MMIX_GETA __muldc3
# CALLER-DAG: R_MMIX_GETA __divdc3
# ELF:      Format: elf64-mmix
# ELF-NEXT: Arch: mmix
# ELF:      Type: Executable
# ELF:      Machine: EM_MMIX
# SYMBOL-DAG: T __mulsc3
# SYMBOL-DAG: T __divsc3
# SYMBOL-DAG: T __muldc3
# SYMBOL-DAG: T __divdc3
