# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-shared-thread-resources.test %t/shared
# RUN: split-file %S/libc-linux-thread-resources.test %t/base
# RUN: split-file %S/libc-linux-synchronization.test %t/sync
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import runpy
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
native = sys.argv[3] if len(sys.argv) == 4 else None
# Reuse the shared test's target-object and host-interpreter checks, but build
# this test.cpp against the production resources.cpp and lifecycle.cpp.
sys.argv = [sys.argv[0], str(libc), str(root)]
context = runpy.run_path(str(root / "shared/run.py"))
if native:
    for opt in ("0", "2"):
        exe = root / ("native-O" + opt)
        subprocess.run([native, "-I", str(root / "base/fake"),
            *context["flags"], "-include",
            str(root / "base/fake/src/__support/OSUtil/linux/syscall.h"),
            "-O" + opt, *map(str, context["sources"]), "-o", str(exe)], check=True)
        subprocess.run([str(exe)], check=True, timeout=10)

#--- test.cpp
// Reuse the deterministic shared TLS/syscall transport and its fault masks.
// Only the test entry point changes; resource ownership stays production code.
#define main shared_resources_baseline_main
#include "shared/test.cpp"
#undef main

struct ResourceOwner {
  unsigned references = 1, retains = 0, attempts = 0, releases = 0;
  long release_error = 0;
};
static long retain_owner(void *p) {
  auto &owner = *static_cast<ResourceOwner *>(p);
  CHECK(owner.references == 1 && !owner.retains++);
  ++owner.references;
  return 0;
}
static long release_owner(void *p) {
  auto &owner = *static_cast<ResourceOwner *>(p);
  // All shared allocation components, including the loader runtime owner,
  // must be gone before even attempting the external owner release.
  CHECK(!live[0] && !live[1] && !tls_live && !dtv_live && !runtime_live);
  CHECK(owner.references == 2 && owner.retains == 1 && !owner.releases);
  ++owner.attempts;
  if (owner.release_error) return owner.release_error;
  ++owner.releases;
  --owner.references;
  return 0;
}
static void retained_owner(const ThreadResources &r, const ResourceOwner &owner) {
  CHECK(r.owns_mappings() && r.owner.context == &owner);
  CHECK(r.owner.retain == retain_owner && r.owner.release == release_owner);
  CHECK(owner.references == 2 && owner.retains == 1 && !owner.releases);
}
static ThreadResources prepare(ResourceOwner &owner) {
  reset();
  ThreadPreparation input;
  input.runner.posix_runner = run;
  input.resource_owner = {&owner, retain_owner, release_owner};
  ThreadControl *control = nullptr;
  CHECK(prepare_thread(input, control).error == ThreadPrepareError::None);
  CHECK(control == prepared_state && prepares == 1 && maps == 2);
  CHECK(control->resource_owner.context == &owner);
  auto resources = thread_resources(*control);
  input = {}; // Neither the caller's request nor the control owns the retry.
  retained_owner(resources, owner);
  return resources;
}
static void released(ThreadResources &r, ResourceOwner &owner) {
  CHECK(!r.owns_mappings() && !r.owner.context && !r.owner.retain && !r.owner.release);
  CHECK(owner.references == 1 && owner.retains == 1 && owner.releases == 1);
  unsigned attempts = owner.attempts, tls_releases = releases;
  CHECK(!release_thread_resources(r) && !release_thread_resources(r));
  CHECK(owner.attempts == attempts && owner.releases == 1 && releases == tls_releases);
}
extern "C" int main() {
  // Bits 0/1 are control/stack; 2/3/4 are shared TLS/DTV/runtime owner.
  // Exercise total failure, every partial success, and an all-success release.
  for (unsigned failed = 0; failed != 32; ++failed) {
    ResourceOwner owner;
    auto resources = prepare(owner);
    release_mask = failed;
    CHECK(release_thread_resources(resources) == (failed ? 5 : 0));
    CHECK(!resources.tls.size && !resources.tls.addr && !resources.tls.tp);
    CHECK(bool(resources.control.size) == bool(failed & 1));
    CHECK(bool(resources.stack.size) == bool(failed & 2));
    CHECK(bool(resources.shared_tls.tls_mapping_size) == bool(failed & 4));
    CHECK(bool(resources.shared_tls.dtv_mapping_size) == bool(failed & 8));
    CHECK(bool(resources.shared_tls.runtime_owner) == bool(failed & 16));
    CHECK(resources.shared_tls.tls_mapping_base == (failed & 4 ? 0x10000u : 0u));
    CHECK(resources.shared_tls.dtv_mapping_base == (failed & 8 ? 0x20000u : 0u));
    CHECK(resources.shared_tls.runtime_owner == (failed & 16 ? 0x30000u : 0u));
    if (failed) {
      retained_owner(resources, owner);
      CHECK(!owner.attempts);
      // Independent control/stack releases need not wait for shared TLS.
      CHECK(live[0] == bool(failed & 1) && live[1] == bool(failed & 2));
      CHECK(release_thread_resources(resources) == 5);
      retained_owner(resources, owner);
      CHECK(!owner.attempts);
      release_mask = 0;
      CHECK(!release_thread_resources(resources));
    }
    CHECK(owner.attempts == 1);
    released(resources, owner);
  }

  // A failed owner hook keeps its complete descriptor even when all mappings
  // are gone. Exercise both direct teardown and a preceding partial TLS release.
  const unsigned failures[] = {0, 16};
  for (unsigned failed : failures) {
    ResourceOwner owner;
    auto resources = prepare(owner);
    owner.release_error = 12;
    release_mask = failed;
    if (failed) {
      CHECK(release_thread_resources(resources) == 5);
      retained_owner(resources, owner);
      CHECK(!owner.attempts && resources.shared_tls.runtime_owner == 0x30000);
      CHECK(!resources.control.size && !resources.stack.size);
      CHECK(!resources.shared_tls.tls_mapping_size && !resources.shared_tls.dtv_mapping_size);
    }
    release_mask = 0;
    CHECK(release_thread_resources(resources) == 12);
    CHECK(!resources.control.size && !resources.stack.size && !resources.tls.size);
    CHECK(!resources.shared_tls.tls_mapping_size && !resources.shared_tls.dtv_mapping_size &&
          !resources.shared_tls.runtime_owner);
    retained_owner(resources, owner);
    CHECK(owner.attempts == 1);
    unsigned tls_releases = releases;
    CHECK(release_thread_resources(resources) == 12);
    retained_owner(resources, owner);
    CHECK(owner.attempts == 2 && releases == tls_releases);
    owner.release_error = 0;
    CHECK(!release_thread_resources(resources));
    CHECK(owner.attempts == 3 && releases == tls_releases);
    released(resources, owner);
  }
  reset();
  return 0;
}
