# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: split-file %S/libc-linux-synchronization.test %t/sync
# RUN: %python %t/run.py %S/../../../../libc %t

#--- run.py
import pathlib
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
resource = subprocess.check_output(["clang", "-print-resource-dir"], text=True).strip()
common = ["-std=c++17", "-ffreestanding", "-fno-builtin", "-DLIBC_FULL_BUILD",
          "-DLIBC_NAMESPACE=resource_test", "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
          "-I", str(root / "headers"), "-I", str(root / "sync"), "-I", str(libc)]
sources = [libc / "src/__support/threads/linux/mmix" / name
           for name in ("resources.cpp", "tls.cpp")]
for opt in ("0", "2"):
    objects, files = [], []
    for index, source in enumerate(sources + [root / "test.cpp"]):
        path = str(root / (str(index) + "-O" + opt))
        subprocess.run(["clang", "-cc1", "-triple", "mmix-unknown-linux",
            "-mrelocation-model", "static", "-internal-isystem", resource + "/include",
            *common, "-O" + opt, "-emit-obj", str(source), "-o", path + ".o"], check=True)
        if index < 2:
            objects.append(path + ".o")
        if opt == "0":
            subprocess.run(["clang", "-cc1", "-triple", "x86_64-unknown-linux-gnu",
                "-mrelocation-model", "static", "-internal-isystem", resource + "/include",
                "-I", str(root / "fake"), *common, "-disable-O0-optnone",
                "-O0", "-emit-llvm-bc", str(source), "-o", path + ".bc"], check=True)
            files.append(path + ".bc")
    combined = str(root / ("resources-O" + opt + ".o"))
    subprocess.run(["ld.lld", "-r", *objects, "-o", combined], check=True)
    undefined = subprocess.check_output(["llvm-nm", "-u", combined], text=True)
    assert {line.split()[-1] for line in undefined.splitlines()} <= {
        "__llvm_libc_mmix_syscall", "memcpy", "memset"}, undefined
    report = subprocess.check_output(["llvm-readobj", "--sections", combined], text=True)
    for forbidden in (".init_array", "SHF_TLS", ".MMIX.reg_contents"):
        assert forbidden not in report, report
    if files:
        linked = str(root / "host-O0.bc")
        subprocess.run(["llvm-link", *files, "-o", linked], check=True)
        lowered = linked + ".lowered.bc"
        # Interpreter-only adaptation; target objects retain actual atomics.
        # O2 semantics use the native delegate below because lli cannot execute
        # the min/max intrinsics introduced by optimization of TLS geometry.
        subprocess.run(["opt", "-passes=function(sroa,instcombine,lower-atomic)",
                        linked, "-o", lowered], check=True)
        subprocess.run(["lli", "-force-interpreter=true", lowered], check=True)
    if len(sys.argv) == 4:
        native = str(root / ("native-O" + opt))
        subprocess.run([sys.argv[3], "-I", str(root / "fake"), *common,
            "-O" + opt, *map(str, sources), str(root / "test.cpp"),
            "-o", native], check=True)
        subprocess.run([native], check=True)

# Synthetic syscall constants isolate fault injection from external UAPI.
# The real CMake provider build uses the reviewed MMIX Linux headers.
#--- headers/sys/syscall.h
#define SYS_mmap 222
#define SYS_munmap 215
#define SYS_mprotect 226
#define SYS_write 64
#define SYS_futex 98
#--- headers/linux/mman.h
#define PROT_NONE 0
#define PROT_READ 1
#define PROT_WRITE 2
#define MAP_PRIVATE 2
#define MAP_ANONYMOUS 32
#--- fake/src/__support/OSUtil/linux/mmix/syscall.h
extern "C" long __llvm_libc_mmix_syscall(unsigned long, long, long, long, long, long, long);

#--- test.cpp
#include "src/__support/threads/linux/mmix/resources.h"
#include <linux/mman.h>
#include <sys/syscall.h>
using namespace resource_test;
using namespace resource_test::mmix;

// Explicit alignment also works in the interpreter, whose global allocation
// does not provide the source's extended alignment guarantees.
unsigned char control_storage[16384], stack_storage[106496];
unsigned char tls_storage[106496], template_storage[32896];
unsigned char *control_memory, *stack_memory, *tls_memory, *template_memory;
alignas(8) unsigned char supplied_stack[16392];
struct Mapping { uintptr_t base; size_t size; int prot; bool live; } mappings[3];
static unsigned maps, protects, unmaps, fail_map, fail_unmap_mask;
static unsigned runner_calls;
static unsigned unmap_order[3];
static bool caller_stack, fail_protect;
static unsigned bad_map;
static uintptr_t bad_address;
extern "C" int printf(const char *, ...);
extern "C" void exit(int);
static void check(bool condition, unsigned line) {
  if (!condition) { printf("resource check failed at line %u\n", line); exit(1); }
}
#define require(condition) check(bool(condition), __LINE__)
static void *runner(void *arg) { ++runner_calls; return arg; }
static int stdc_runner(void *) { ++runner_calls; return 3; }
static unsigned char *aligned(unsigned char *base, uintptr_t alignment) {
  uintptr_t address = reinterpret_cast<uintptr_t>(base);
  return reinterpret_cast<unsigned char *>((address + alignment - 1) & ~(alignment - 1));
}
static void reset(bool supplied = false) {
  maps = protects = unmaps = fail_map = fail_unmap_mask = bad_map = 0;
  runner_calls = 0;
  caller_stack = supplied;
  fail_protect = false;
  for (auto &m : mappings) m = {};
  control_memory = aligned(control_storage, 8192);
  stack_memory = aligned(stack_storage, 8192);
  tls_memory = aligned(tls_storage, 32768);
  template_memory = aligned(template_storage, 32768);
  for (unsigned i = 0; i != 8192; ++i) control_memory[i] = 0xa5;
  for (unsigned i = 0; i != 98304; ++i) stack_memory[i] = 0xb6;
  for (unsigned i = 0; i != 73728; ++i) tls_memory[i] = 0xc7;
  for (auto &b : supplied_stack) b = 0xd8;
  for (unsigned i = 0; i != 128; ++i) template_memory[i] = i + 1;
}
extern "C" long __llvm_libc_mmix_syscall(unsigned long n, long a, long b,
                                         long c, long d, long e, long f) {
  if (n == SYS_mmap) {
    require(!a && b > 0 && b % 8192 == 0 && !f && e == -1);
    require(d == (MAP_PRIVATE | MAP_ANONYMOUS) && maps < 3);
    unsigned index = maps++;
    if (maps == fail_map) return -12;
    uintptr_t address = reinterpret_cast<uintptr_t>(
        index == 0 ? control_memory : index == 1 && !caller_stack ? stack_memory : tls_memory + 8192);
    if (maps == bad_map) address = bad_address;
    mappings[index] = {address, size_t(b), int(c), true};
    return long(address);
  }
  if (n == SYS_mprotect) {
    require(!caller_stack && maps == 2 && !d && !e && !f);
    require(c == (PROT_READ | PROT_WRITE) && b > 0 && b % 8192 == 0);
    require(mappings[1].prot == PROT_NONE);
    require(uintptr_t(a) > mappings[1].base && uintptr_t(a) % 8192 == 0);
    require(uintptr_t(a) + b == mappings[1].base + mappings[1].size);
    ++protects;
    return fail_protect ? -13 : 0;
  }
  require(n == SYS_munmap && !c && !d && !e && !f);
  for (unsigned index = 0; index != 3; ++index) {
    auto &m = mappings[index];
    if (m.live && m.base == uintptr_t(a) && m.size == size_t(b)) {
      if (unmaps < 3) unmap_order[unmaps] = index;
      ++unmaps;
      if (fail_unmap_mask & (1u << index)) return -5;
      m.live = false;
      return 0;
    }
  }
  require(false);
  return -22;
}
static ThreadPreparation request() {
  ThreadPreparation input;
  input.runner.posix_runner = runner;
  input.argument = template_memory;
  input.saved_signal_mask = 0x123456789abcdef0;
  if (caller_stack) {
    input.stack = supplied_stack;
    input.stack_size = sizeof(supplied_stack);
  }
  return input;
}
static void untouched() {
  require(runner_calls == 0);
  for (auto b : supplied_stack) require(b == 0xd8);
  for (unsigned i = 0; i != 98304; ++i) require(stack_memory[i] == 0xb6);
}
static void no_mappings() {
  for (auto m : mappings) require(!m.live);
}
static bool empty(const ThreadResources &r) {
  return !r.control.size && !r.stack.size && !r.tls.size;
}
static ThreadPreparationResult failure(ThreadPreparation &input, ThreadPrepareError error) {
  ThreadControl sentinel;
  ThreadControl *output = &sentinel;
  auto result = prepare_thread(input, output);
  require(result.error == error && output == &sentinel);
  untouched();
  return result;
}
static void invalid_inputs() {
  reset();
  auto input = request();
  input.stack_size = 16383;
  failure(input, ThreadPrepareError::InvalidAttributes);
  input = request(); input.page_size = 4096;
  failure(input, ThreadPrepareError::InvalidAttributes);
  input = request(); input.runner.posix_runner = nullptr;
  failure(input, ThreadPrepareError::InvalidAttributes);
  input = request(); input.style = ThreadStyle(99);
  failure(input, ThreadPrepareError::InvalidAttributes);
  input = request(); input.stack_size = SIZE_MAX;
  failure(input, ThreadPrepareError::Overflow);
  input = request(); input.guard_size = SIZE_MAX;
  failure(input, ThreadPrepareError::Overflow);
  input = request(); input.stack_size = UINTPTR_MAX >> 2; input.guard_size = input.stack_size;
  failure(input, ThreadPrepareError::Overflow);
  input = request(); input.image = {0, 1, 0, 8};
  require(failure(input, ThreadPrepareError::InvalidTLS).tls_error == TLSError::InvalidImage);
  input = request(); input.image = {1, 8, 9, 8};
  failure(input, ThreadPrepareError::InvalidTLS);
  input = request(); input.image = {1, 1, 0, 3};
  failure(input, ThreadPrepareError::InvalidTLS);
  input = request(); input.image = {1, UINTPTR_MAX, 0, 8};
  require(failure(input, ThreadPrepareError::InvalidTLS).tls_error == TLSError::Overflow);
  require(!maps && !protects && !unmaps);
  reset(true);
  input = request(); input.stack = supplied_stack + 1;
  failure(input, ThreadPrepareError::InvalidAttributes);
  input = request(); --input.stack_size;
  failure(input, ThreadPrepareError::InvalidAttributes);
  input = request(); input.stack = reinterpret_cast<void *>((UINTPTR_MAX >> 1) - 7);
  failure(input, ThreadPrepareError::Overflow);
  require(!maps && !protects && !unmaps);
}
static void success(bool supplied, unsigned guard, unsigned tls_case) {
  reset(supplied);
  auto input = request();
  input.guard_size = supplied ? SIZE_MAX : guard;
  input.detached = tls_case & 1;
  if (!supplied) input.stack_size = 16385;
  if (tls_case == 1) input.image = {uintptr_t(template_memory), 32, 0, 8};
  if (tls_case == 2) input.image = {uintptr_t(template_memory), 32, 12, 8};
  if (tls_case == 3) {
    input.image = {uintptr_t(template_memory + 8), 80, 12, 32768};
    input.style = ThreadStyle::STDC; input.runner.stdc_runner = stdc_runner;
  }
  ThreadControl *control = nullptr;
  auto result = prepare_thread(input, control);
  require(result.error == ThreadPrepareError::None && empty(result.retained));
  require(control == reinterpret_cast<ThreadControl *>(control_memory) && control->is_prepared());
  require(control->parent_tid.value.load() == 0 && control->clear_tid.value.load() == UINT32_MAX);
  require(control->clear_tid.reserved == 0 && control->parent_tid.reserved == 0);
  require(control->acquire_child() == ChildStatus::Starting &&
          control->acquire_decision() == CreatorDecision::Hold && control->child_error == 0);
  require(control->argument == template_memory && control->saved_signal_mask == input.saved_signal_mask);
  require(control->attributes.platform_data == &control->clear_tid.value.val);
  require(control->attributes.style == input.style && control->attributes.tid == -1);
  require(control->attributes.detach_state.load() == uint32_t(input.detached ? DetachState::DETACHED : DetachState::JOINABLE));
  require(control->attributes.stack == reinterpret_cast<void *>(control->stack_bottom));
  require(control->attributes.owned_stack == !supplied && control->owns_stack == !supplied);
  if (input.style == ThreadStyle::STDC) require(control->runner.stdc_runner == stdc_runner);
  else require(control->runner.posix_runner == runner);
  if (supplied) {
    require(maps == 2 && !protects && !control->stack_mapping.size && !control->guard_size);
    require(control->stack_top == uintptr_t(supplied_stack) + sizeof(supplied_stack));
    require(control->attributes.stacksize == sizeof(supplied_stack));
  } else {
    size_t expected_guard = (guard + 8191) / 8192 * 8192;
    require(maps == 3 && protects == bool(guard));
    require(control->guard_size == expected_guard && control->attributes.guardsize == expected_guard);
    require(control->stack_bottom == uintptr_t(stack_memory) + expected_guard);
    require(control->stack_top == control->stack_bottom + 24576);
    require(control->stack_mapping.size == 24576 + expected_guard);
    require(control->attributes.stacksize == 24576);
    require(mappings[1].prot == (guard ? PROT_NONE : PROT_READ | PROT_WRITE));
  }
  TLSLayout layout;
  require(tls_layout(input.image, 8192, layout) == TLSError::None);
  auto *header = reinterpret_cast<TLSHeader *>(control->tls.tp);
  require(header->dtv == 0 && header->thread_state == uintptr_t(control));
  require(control->tls.tp % layout.alignment == 0);
  require(control->attributes.tls == control->tls.addr && control->attributes.tls_size == control->tls.size);
  auto *data = reinterpret_cast<unsigned char *>(control->tls.tp + layout.offset);
  for (uintptr_t i = 0; i != input.image.size; ++i)
    require(data[i] == (i < input.image.init_size ? reinterpret_cast<unsigned char *>(input.image.address)[i] : 0));
  auto resources = thread_resources(*control);
  input = {}; // The control must not borrow mutable attribute storage.
  require(control->argument == template_memory && control->is_prepared());
  untouched();
  require(release_thread_resources(resources) == 0 && empty(resources));
  require(release_thread_resources(resources) == 0);
  no_mappings(); untouched();
}
static void faults(bool supplied) {
  unsigned count = supplied ? 2 : 3;
  for (unsigned failed = 1; failed <= count; ++failed) {
    reset(supplied); fail_map = failed;
    auto input = request();
    auto error = failed == 1 ? ThreadPrepareError::ControlMapFailed :
        failed == count ? ThreadPrepareError::TLSFailed : ThreadPrepareError::StackMapFailed;
    auto result = failure(input, error);
    require(result.syscall_error == 12 && !result.rollback_error && empty(result.retained));
    require(maps == failed && unmaps == failed - 1);
    no_mappings();
  }
  if (!supplied) {
    reset(); fail_protect = true;
    auto input = request();
    auto result = failure(input, ThreadPrepareError::ProtectFailed);
    require(result.syscall_error == 13 && empty(result.retained));
    require(maps == 2 && protects == 1 && unmaps == 2);
    require(unmap_order[0] == 1 && unmap_order[1] == 0);
    no_mappings();
    for (unsigned mask = 1; mask != 4; ++mask) {
      reset(); fail_protect = true; fail_unmap_mask = mask;
      input = request(); result = failure(input, ThreadPrepareError::ProtectFailed);
      require(result.syscall_error == 13 && result.rollback_error == 5);
      require(bool(result.retained.control.size) == bool(mask & 1));
      require(bool(result.retained.stack.size) == bool(mask & 2));
      fail_unmap_mask = 0;
      require(!release_thread_resources(result.retained) && empty(result.retained));
      no_mappings();
    }
  }
  uintptr_t invalid_addresses[] = {0, 1, (UINTPTR_MAX >> 1) - 8191};
  for (unsigned bad = 1; bad <= count; ++bad) {
    for (uintptr_t address : invalid_addresses) {
      reset(supplied); bad_map = bad; bad_address = address;
      auto input = request();
      auto result = failure(input, bad == count ? ThreadPrepareError::TLSFailed : ThreadPrepareError::InvalidMapping);
      require(empty(result.retained) && !result.rollback_error);
      no_mappings();
    }
  }
  // TLS's own invalid-map rollback can fail. Keep that descriptor even when
  // independent control/stack releases also fail, then retry from outside.
  reset(supplied); bad_map = count; bad_address = 0;
  fail_unmap_mask = (1u << count) - 1;
  auto input = request();
  auto result = failure(input, ThreadPrepareError::TLSFailed);
  require(result.tls_error == TLSError::UnmapFailed && result.rollback_error == 5);
  require(result.retained.control.size && result.retained.tls.size);
  require(bool(result.retained.stack.size) == !supplied);
  fail_unmap_mask = 0;
  require(!release_thread_resources(result.retained));
  no_mappings();
  // Explicit preclone rollback after success independently retains any subset
  // of failed releases; it never needs to dereference the old control again.
  for (unsigned mask = 1; mask < (1u << count); ++mask) {
    reset(supplied); input = request();
    ThreadControl *control = nullptr;
    require(prepare_thread(input, control).error == ThreadPrepareError::None);
    auto resources = thread_resources(*control);
    fail_unmap_mask = mask;
    require(release_thread_resources(resources) == 5);
    require(bool(resources.control.size) == bool(mask & 1));
    require(bool(resources.tls.size) == bool(mask & (1u << (count - 1))));
    if (!supplied) require(bool(resources.stack.size) == bool(mask & 2));
    fail_unmap_mask = 0;
    require(!release_thread_resources(resources) && empty(resources));
    no_mappings(); untouched();
  }
}
extern "C" int main() {
  invalid_inputs();
  unsigned guards[] = {0, 1, 8193};
  for (unsigned guard : guards)
    for (unsigned tls = 0; tls != 4; ++tls) success(false, guard, tls);
  for (unsigned tls = 0; tls != 4; ++tls) success(true, 0, tls);
  faults(false);
  faults(true);
  return 0;
}
