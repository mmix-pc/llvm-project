# REQUIRES: mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libunwind %t %mmix_host_cxx

# Native lifecycle checks only, not MMIX execution or forced-unwind validation.
# Link the static opt-in without an image provider, including at O0, and inspect
# the object for image dependencies. Reuse existing shared lifecycle fixtures to
# cover the legacy default, startup-images alone, and both feature macros.
#--- run.py
import pathlib
import shlex
import subprocess
import sys

root, out = map(pathlib.Path, sys.argv[1:3])
host = shlex.split(sys.argv[3])
lifetime = "-D_LIBUNWIND_MMIX_CURSOR_LIFETIME"
# Match the loader fixture's empty source definition without redefinition warnings.
startup = "-D_LIBUNWIND_MMIX_STARTUP_IMAGES="
for opt in ("0", "2"):
    flags = ["-std=c++17", "-UNDEBUG", "-pthread", "-O" + opt,
             "-Wall", "-Wextra", "-Werror", "-fno-lto",
             "-I", str(root / "src")]
    obj = out / ("cursor-static-O" + opt + ".o")
    subprocess.run([*host, *flags, lifetime, "-c",
                    str(root / "src/mmix/CursorLifetime.cpp"),
                    "-o", str(obj)], check=True)
    symbols = subprocess.check_output(["llvm-nm", str(obj)], text=True)
    assert "image" not in symbols.lower(), symbols
    assert "dl_iterate_phdr" not in symbols, symbols
    image = out / ("cursor-static-O" + opt)
    subprocess.run([*host, *flags, lifetime, str(obj),
                    str(root / "test/mmix/cursor-lifetime-static.cpp"),
                    "-o", str(image)], check=True)
    subprocess.run([str(image)], check=True, timeout=30)

    for name, defines in (("legacy", []), ("startup", [startup]),
                          ("both", [startup, lifetime])):
        image = out / ("cursor-" + name + "-O" + opt)
        subprocess.run([*host, *flags, *defines,
                        str(root / "src/mmix/CursorLifetime.cpp"),
                        str(root / "test/mmix/cursor-checkpoint.cpp"),
                        "-o", str(image)], check=True)
        subprocess.run([str(image)], check=True, timeout=30)

    # This fixture defines startup-images itself; the new macro must not disable
    # its leases, copy/retain failure, escape pinning or cancellation cleanup.
    image = out / ("cursor-shared-lifecycle-O" + opt)
    subprocess.run([*host, *flags, startup, lifetime,
                    str(root / "src/mmix/CursorLifetime.cpp"),
                    str(root / "src/mmix/StartupImages.cpp"),
                    str(root.parent / "libc/loader/test/unwind_cursor_test.cpp"),
                    "-o", str(image)], check=True)
    subprocess.run([str(image)], check=True, timeout=30)
