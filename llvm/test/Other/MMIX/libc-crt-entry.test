# PLATFORM-UNDEFINED-NOT: U

# TERMINATION-LABEL: <__llvm_libc_exit>:
# TERMINATION:       AND {{.*}}, r231, 0xff
# TERMINATION:       TRAP 0x0, 0x0, 0x0
# TERMINATION-LABEL: <__mmix_stack_chk_terminate>:
# TERMINATION:       SETL {{.*}}, 0x7f
# TERMINATION:       TRAP 0x0, 0x0, 0x0

# ABORT-LABEL: <abort>:
# ABORT:       SETL {{.*}}, 0x6
# ABORT:       GETA [[DISPATCH:r[0-9]+]],
# ABORT-NEXT:  {{.*}} R_MMIX_GETA {{.*}}dispatch_signalEi
# ABORT:       PUSHGO r31, [[DISPATCH]],
# ABORT:       SETL {{.*}}, 0x0
# ABORT:       R_MMIX_GETA {{.*}}set_signal_handler
# ABORT:       PUSHGO r31, {{r[0-9]+}},
# ABORT:       PUSHGO r31, [[DISPATCH]],

# IMAGE:      Format: elf64-mmix
# IMAGE:      Type: Executable
# IMAGE:      Machine: EM_MMIX
# IMAGE:      Entry: 0x100000

# IMAGE-SYMBOLS:      Name: __llvm_libc_mmix_start_main
# IMAGE-SYMBOLS:      Name: _start
# IMAGE-SYMBOLS-NEXT: Value: 0x100000
# IMAGE-SYMBOLS:      Name: main

# FINAL-RELOCS: Relocations [
# FINAL-RELOCS-NEXT: ]

# COMPAT: Format: elf64-mmix
# COMPAT: Machine: EM_MMIX

#--- main.c
int main(int argc, char **argv, char **envp) {
  return argc == 1 && argv != 0 && argv[0] != 0 && argv[1] == 0 && envp == 0
             ? 0
             : 1;
}
