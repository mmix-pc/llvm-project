# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: cmake -DLIBC_SOURCE=%S/../../../../libc -P %t/selection.cmake

#--- selection.cmake
cmake_minimum_required(VERSION 3.20)
set(directory_functions opendir fdopendir readdir closedir dirfd
    rewinddir seekdir telldir readdir_r scandir alphasort scandirat
    versionsort posix_getdents)
include(${LIBC_SOURCE}/config/linux/mmix/entrypoints.txt)
foreach(name IN LISTS directory_functions)
  if("libc.src.dirent.${name}" IN_LIST TARGET_LIBC_ENTRYPOINTS)
    message(FATAL_ERROR "disabled filesystem selected ${name}")
  endif()
endforeach()
set(LIBC_MMIX_BUILD_FILESYSTEM ON CACHE BOOL "" FORCE)
include(${LIBC_SOURCE}/config/linux/mmix/entrypoints.txt)
foreach(name IN LISTS directory_functions)
  if(NOT "libc.src.dirent.${name}" IN_LIST TARGET_LIBC_ENTRYPOINTS)
    message(FATAL_ERROR "missing directory provider ${name}")
  endif()
endforeach()
foreach(name strcoll strverscmp)
  if(NOT "libc.src.string.${name}" IN_LIST TARGET_LIBC_ENTRYPOINTS)
    message(FATAL_ERROR "missing directory sorting dependency ${name}")
  endif()
endforeach()
include(${LIBC_SOURCE}/config/linux/mmix/headers.txt)
if(NOT libc.include.dirent IN_LIST TARGET_PUBLIC_HEADERS)
  message(FATAL_ERROR "missing directory header")
endif()

# The non-point readdir and the pre-consumption closedir point need the
# cancellation runtime only in the selected MMIX composition. Other targets
# and the disabled composition retain their ordinary providers.
function(add_entrypoint_object name)
  cmake_parse_arguments(P "" "" "SRCS;HDRS;DEPENDS" ${ARGN})
  if(name STREQUAL "readdir" OR name STREQUAL "closedir")
    set_property(GLOBAL PROPERTY ${name}_sources "${P_SRCS}")
    set_property(GLOBAL PROPERTY ${name}_dependencies "${P_DEPENDS}")
  endif()
endfunction()
function(add_header_library name)
endfunction()
set(LIBC_TARGET_OS_IS_LINUX ON)
set(LIBC_TARGET_ARCHITECTURE x86_64)
set(LIBC_MMIX_BUILD_CANCELLATION_RUNTIME_LOCKS OFF)
include(${LIBC_SOURCE}/src/dirent/CMakeLists.txt)
foreach(name readdir closedir)
  get_property(${name}_ordinary GLOBAL PROPERTY ${name}_sources)
endforeach()
foreach(arch mmix x86_64)
  foreach(enabled OFF ON)
    set(LIBC_TARGET_ARCHITECTURE ${arch})
    set(LIBC_MMIX_BUILD_CANCELLATION_RUNTIME_LOCKS ${enabled})
    include(${LIBC_SOURCE}/src/dirent/CMakeLists.txt)
    foreach(name readdir closedir)
      get_property(sources GLOBAL PROPERTY ${name}_sources)
      get_property(dependencies GLOBAL PROPERTY ${name}_dependencies)
      if(arch STREQUAL "mmix" AND enabled)
        if(sources STREQUAL "${${name}_ordinary}" OR
           NOT libc.src.__support.threads.linux.mmix.cancellation IN_LIST dependencies)
          message(FATAL_ERROR "missing ${name} cancellation selection")
        endif()
      elseif(NOT sources STREQUAL "${${name}_ordinary}" OR
             libc.src.__support.threads.linux.mmix.cancellation IN_LIST dependencies)
        message(FATAL_ERROR "${name} cancellation selection leaked to ${arch}/${enabled}")
      endif()
    endforeach()
  endforeach()
endforeach()
