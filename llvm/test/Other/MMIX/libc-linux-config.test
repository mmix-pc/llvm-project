# RUN: not cmake -DCMAKE_SYSROOT=/ -P %S/../../../../libc/cmake/caches/mmix-linux.cmake 2>&1 | FileCheck %s --check-prefix=SYSROOT
# RUN: not cmake -DCMAKE_SYSROOT=/./ -P %S/../../../../libc/cmake/caches/mmix-linux.cmake 2>&1 | FileCheck %s --check-prefix=SYSROOT
# RUN: not cmake -DCMAKE_SYSROOT=%t/missing -P %S/../../../../libc/cmake/caches/mmix-linux.cmake 2>&1 | FileCheck %s --check-prefix=SYSROOT
# RUN: not cmake -DCMAKE_SYSROOT=%t/uapi -DLIBC_KERNEL_HEADERS=include -P %S/../../../../libc/cmake/caches/mmix-linux.cmake 2>&1 | FileCheck %s --check-prefix=PATH
# RUN: not cmake -DCMAKE_SYSROOT=%t/uapi -DLIBC_KERNEL_HEADERS=/../uapi/include -P %S/../../../../libc/cmake/caches/mmix-linux.cmake 2>&1 | FileCheck %s --check-prefix=PATH
# RUN: not cmake -DCMAKE_SYSROOT=%t/uapi -DLIBC_KERNEL_HEADERS=%t/uapi/include -P %S/../../../../libc/cmake/caches/mmix-linux.cmake 2>&1 | FileCheck %s --check-prefix=HEADERS
# RUN: not cmake -DCMAKE_SYSROOT=%t/uapi -DLIBC_KERNEL_HEADERS=/missing -P %S/../../../../libc/cmake/caches/mmix-linux.cmake 2>&1 | FileCheck %s --check-prefix=HEADERS
# RUN: not cmake -DCMAKE_SYSROOT=%t/uapi -DLIBC_KERNEL_HEADERS=/escaped -P %S/../../../../libc/cmake/caches/mmix-linux.cmake 2>&1 | FileCheck %s --check-prefix=HEADERS
# RUN: not cmake -DCMAKE_SYSROOT=%t/uapi -DLIBC_KERNEL_HEADERS=/file-escape -P %S/../../../../libc/cmake/caches/mmix-linux.cmake 2>&1 | FileCheck %s --check-prefix=HEADERS
# RUN: cmake -DCMAKE_SYSROOT=%t/sysroot -DLIBC_KERNEL_HEADERS=/usr/include -P %S/../../../../libc/cmake/caches/mmix-linux.cmake
# RUN: rm %t/uapi/include/asm/unistd_64.h
# RUN: not cmake -DCMAKE_SYSROOT=%t/uapi -DLIBC_KERNEL_HEADERS=/include -P %S/../../../../libc/cmake/caches/mmix-linux.cmake 2>&1 | FileCheck %s --check-prefix=HEADERS
# RUN: cmake -S %t/registration -B %t/without -DLIBC_SOURCE=%S/../../../../libc -DHAVE_OSUTIL=OFF
# RUN: cmake -S %t/registration -B %t/with -DLIBC_SOURCE=%S/../../../../libc -DHAVE_OSUTIL=ON
# RUN: cmake -S %t/osutil -B %t/adapter-only -DLIBC_SOURCE=%S/../../../../libc -DHAVE_SYSCALL_OVERLOADS=OFF
# RUN: cmake -S %t/osutil -B %t/adapter-and-overloads -DLIBC_SOURCE=%S/../../../../libc -DHAVE_SYSCALL_OVERLOADS=ON
# RUN: cmake -S %t/osutil -B %t/with-vdso -DLIBC_SOURCE=%S/../../../../libc -DHAVE_SYSCALL_OVERLOADS=ON -DHAVE_VDSO=ON

# SYSROOT: MMIX Linux libc requires an explicit non-root CMAKE_SYSROOT
# PATH: MMIX Linux libc requires a sysroot-relative LIBC_KERNEL_HEADERS path
# HEADERS: MMIX Linux libc requires kernel headers inside CMAKE_SYSROOT

#--- check.cmake
cmake_minimum_required(VERSION 3.20)
# Synthetic headers test cache validation only, not Linux ABI compatibility.
file(MAKE_DIRECTORY "${TEST_ROOT}/uapi/include/asm" "${TEST_ROOT}/uapi/include/linux")
foreach(header asm/unistd.h asm/unistd_64.h linux/errno.h)
  file(WRITE "${TEST_ROOT}/uapi/include/${header}" "")
endforeach()
file(MAKE_DIRECTORY "${TEST_ROOT}/sysroot/usr")
file(COPY "${TEST_ROOT}/uapi/include" DESTINATION "${TEST_ROOT}/sysroot/usr")
file(CREATE_LINK "${TEST_ROOT}/sysroot/usr/include" "${TEST_ROOT}/uapi/escaped" SYMBOLIC)
file(MAKE_DIRECTORY "${TEST_ROOT}/uapi/file-escape/asm")
file(CREATE_LINK "${TEST_ROOT}/sysroot/usr/include/linux" "${TEST_ROOT}/uapi/file-escape/linux" SYMBOLIC)
foreach(header unistd.h unistd_64.h)
  file(CREATE_LINK "${TEST_ROOT}/sysroot/usr/include/asm/${header}"
       "${TEST_ROOT}/uapi/file-escape/asm/${header}" SYMBOLIC)
endforeach()

set(CMAKE_SYSROOT "${TEST_ROOT}/uapi")
set(LIBC_KERNEL_HEADERS "/include")
include(${LIBC_SOURCE}/cmake/caches/mmix-linux.cmake)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR
   NOT LIBC_TARGET_TRIPLE STREQUAL "mmix-unknown-linux-unknown" OR
   NOT CMAKE_C_COMPILER_TARGET STREQUAL "mmix-unknown-linux" OR
   NOT CMAKE_CXX_COMPILER_TARGET STREQUAL "mmix-unknown-linux" OR
   NOT CMAKE_TRY_COMPILE_TARGET_TYPE STREQUAL "STATIC_LIBRARY" OR
   NOT CMAKE_CXX_FLAGS STREQUAL "-nostdinc++" OR
   NOT LLVM_ENABLE_RUNTIMES STREQUAL "libc" OR
   NOT LLVM_LIBC_FULL_BUILD OR LLVM_INCLUDE_TESTS)
  message(FATAL_ERROR "incorrect isolated Linux component profile")
endif()
if(DEFINED CMAKE_C_COMPILER_WORKS OR DEFINED CMAKE_CXX_COMPILER_WORKS)
  message(FATAL_ERROR "compiler probes were overridden")
endif()
if(NOT LIBC_CONF_ERRNO_MODE STREQUAL "LIBC_ERRNO_MODE_SHARED" OR
   NOT LIBC_CONF_THREAD_MODE STREQUAL "LIBC_THREAD_MODE_SINGLE" OR
   LIBC_CONF_TIMEOUT_ENSURE_MONOTONICITY)
  message(FATAL_ERROR "incorrect single-thread Linux state configuration")
endif()
include(${LIBC_SOURCE}/config/linux/mmix/entrypoints.txt)
set(expected libc.src.errno.errno libc.src.string.memcpy libc.src.string.memmove
    libc.src.string.memset libc.src.string.memcmp libc.src.string.strlen
    libc.src.unistd.getpid libc.src.unistd.__llvm_libc_syscall
    libc.src.unistd._exit libc.src.stdlib._Exit
    libc.src.stdlib.malloc libc.src.stdlib.free
    libc.src.stdlib.calloc libc.src.stdlib.realloc
    libc.src.stdlib.aligned_alloc libc.src.stdlib.posix_memalign)
if(NOT TARGET_LIBC_ENTRYPOINTS STREQUAL expected OR
   NOT TARGET_LLVMLIBC_ENTRYPOINTS STREQUAL expected)
  message(FATAL_ERROR "incorrect initial Linux entrypoints")
endif()
include(${LIBC_SOURCE}/config/linux/mmix/headers.txt)
foreach(header libc.include.features libc.include.limits libc.include.stdint
               libc.include.string libc.include.strings libc.include.stdlib
               libc.include.unistd libc.include.errno libc.include.sys_types
               libc.include.sys_syscall libc.include.sys_mman)
  if(NOT header IN_LIST TARGET_PUBLIC_HEADERS)
    message(FATAL_ERROR "missing foundation header ${header}")
  endif()
endforeach()
set(LIBC_MMIX_BUILD_CORE ON)
include(${LIBC_SOURCE}/config/linux/mmix/headers.txt)
if(NOT "libc.include.math" IN_LIST TARGET_PUBLIC_HEADERS)
  message(FATAL_ERROR "missing C math macros for libc++ headers")
endif()
set(LIBC_MMIX_BUILD_DESCRIPTORS ON)
include(${LIBC_SOURCE}/config/linux/mmix/Descriptors.cmake)
if(NOT "libc.src.unistd.isatty" IN_LIST TARGET_LIBC_ENTRYPOINTS)
  message(FATAL_ERROR "missing real Linux terminal query provider")
endif()
file(READ ${LIBC_SOURCE}/config/linux/mmix/config.json config)
foreach(option LIBC_CONF_STRING_LENGTH_IMPL LIBC_CONF_FIND_FIRST_CHARACTER_IMPL)
  string(JSON value GET "${config}" string ${option} value)
  if(NOT value STREQUAL "element")
    message(FATAL_ERROR "unexpected initial string policy")
  endif()
endforeach()

#--- registration/CMakeLists.txt
cmake_minimum_required(VERSION 3.20)
project(CheckLinuxRegistration NONE)
# Execute the real registration files without compiling or faking OSUtil code.
function(add_header_library)
endfunction()
function(add_entrypoint_object)
endfunction()
function(add_object_library name)
  add_custom_target(${name})
endfunction()
if(HAVE_OSUTIL)
  add_custom_target(libc.src.__support.OSUtil.osutil)
  add_custom_target(libc.src.__support.OSUtil.linux.syscall_wrappers.rt_sigprocmask)
endif()
include(${LIBC_SOURCE}/src/setjmp/linux/CMakeLists.txt)
include(${LIBC_SOURCE}/src/signal/linux/CMakeLists.txt)
foreach(name sigsetjmp_epilogue __restore)
  if(HAVE_OSUTIL AND NOT TARGET ${name})
    message(FATAL_ERROR "missing supported Linux object ${name}")
  elseif(NOT HAVE_OSUTIL AND TARGET ${name})
    message(FATAL_ERROR "object ${name} registered without its provider")
  endif()
endforeach()

#--- osutil/CMakeLists.txt
cmake_minimum_required(VERSION 3.20)
project(CheckLinuxUtilityPrerequisite NONE)
set(LIBC_TARGET_ARCHITECTURE mmix)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/mmix")
function(add_object_library name)
  add_custom_target(${name})
endfunction()
function(add_header_library name)
  add_custom_target(${name})
  if(name STREQUAL "linux_mmix_util" AND HAVE_SYSCALL_OVERLOADS)
    cmake_parse_arguments(ARG "" "" "DEPENDS;HDRS" ${ARGN})
    if(NOT ".syscall" IN_LIST ARG_DEPENDS)
      message(FATAL_ERROR "Linux utility lacks the syscall interface")
    endif()
    add_custom_target(libc.src.__support.OSUtil.linux.mmix.linux_mmix_util)
  endif()
endfunction()
function(add_subdirectory name)
  if(name STREQUAL "mmix")
    include(${LIBC_SOURCE}/src/__support/OSUtil/linux/mmix/CMakeLists.txt)
  endif()
endfunction()
if(HAVE_VDSO)
  add_custom_target(libc.src.__support.OSUtil.linux.mmix.vdso)
endif()
# Exercise dependency-based registration without pretending to implement calls.
include(${LIBC_SOURCE}/src/__support/OSUtil/linux/CMakeLists.txt)
if(HAVE_SYSCALL_OVERLOADS AND HAVE_VDSO AND NOT TARGET vdso)
  message(FATAL_ERROR "missing vDSO with its architecture provider")
elseif(NOT HAVE_VDSO AND TARGET vdso)
  message(FATAL_ERROR "vDSO registered without its architecture provider")
endif()
if(NOT TARGET syscall_asm)
  message(FATAL_ERROR "missing independent raw adapter")
endif()
if(NOT TARGET syscall)
  message(FATAL_ERROR "missing independent syscall interface")
endif()
if(HAVE_SYSCALL_OVERLOADS AND NOT TARGET linux_util)
  message(FATAL_ERROR "missing Linux utility with its provider")
elseif(NOT HAVE_SYSCALL_OVERLOADS AND TARGET linux_util)
  message(FATAL_ERROR "Linux utility registered without syscall overloads")
endif()
