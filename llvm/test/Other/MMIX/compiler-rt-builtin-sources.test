# RUN: cmake -P %s
# RUN: rm -rf %t.dir
# RUN: mkdir -p %t.dir
# RUN: cd %t.dir && clang --target=mmix-unknown-unknown -ffreestanding \
# RUN:   -ffp-contract=off -fno-stack-protector -O2 \
# RUN:   -I %S/../../../../compiler-rt/lib/builtins -c \
# RUN:   %S/../../../../compiler-rt/lib/builtins/divdc3.c \
# RUN:   %S/../../../../compiler-rt/lib/builtins/divsc3.c \
# RUN:   %S/../../../../compiler-rt/lib/builtins/ffsdi2.c \
# RUN:   %S/../../../../compiler-rt/lib/builtins/muldc3.c \
# RUN:   %S/../../../../compiler-rt/lib/builtins/mulsc3.c
# RUN: llvm-readobj --file-headers %t.dir/divdc3.o %t.dir/divsc3.o \
# RUN:   %t.dir/ffsdi2.o %t.dir/muldc3.o %t.dir/mulsc3.o \
# RUN:   | FileCheck %s --check-prefix=ELF
# RUN: llvm-nm --defined-only --extern-only %t.dir/divdc3.o %t.dir/divsc3.o \
# RUN:   %t.dir/ffsdi2.o %t.dir/muldc3.o %t.dir/mulsc3.o \
# RUN:   | FileCheck %s --check-prefix=SYMBOL
# RUN: llvm-nm --undefined-only %t.dir/divdc3.o %t.dir/divsc3.o \
# RUN:   %t.dir/ffsdi2.o %t.dir/muldc3.o %t.dir/mulsc3.o | not grep ' U '

# ELF-COUNT-5: Format: elf64-mmix
# ELF: Arch: mmix
# ELF: DataEncoding: BigEndian
# ELF: Machine: EM_MMIX
# SYMBOL-DAG: T __divdc3
# SYMBOL-DAG: T __divsc3
# SYMBOL-DAG: T __ffsdi2
# SYMBOL-DAG: T __muldc3
# SYMBOL-DAG: T __mulsc3

include(${CMAKE_CURRENT_LIST_DIR}/../../../../compiler-rt/lib/builtins/mmix/builtins.cmake)
list(SORT mmix_SOURCES)
list(JOIN mmix_SOURCES ";" actual_sources)
if(NOT actual_sources STREQUAL "clzti2.c;divdc3.c;divsc3.c;divti3.c;ffsdi2.c;fixdfti.c;fixsfti.c;fixunsdfti.c;fixunssfti.c;floattidf.c;floattisf.c;floatuntidf.c;floatuntisf.c;modti3.c;muldc3.c;muloti4.c;mulsc3.c;multi3.c;udivmodti4.c;udivti3.c;umodti3.c")
  message(FATAL_ERROR "unexpected MMIX builtin sources: ${actual_sources}")
endif()
set(generic_sources ${mmix_SOURCES})
set(CMAKE_C_COMPILER_TARGET mmix-unknown-linux)
set(HAVE_UNWIND_H TRUE)
include(${CMAKE_CURRENT_LIST_DIR}/../../../../compiler-rt/lib/builtins/mmix/builtins.cmake)
list(APPEND generic_sources gcc_personality_v0.c int_util.c)
list(SORT generic_sources)
list(SORT mmix_SOURCES)
if(NOT mmix_SOURCES STREQUAL generic_sources)
  message(FATAL_ERROR "Linux builtins must retain the real C personality and abort helper")
endif()
list(JOIN mmix_ATOMIC_SOURCES ";" actual_atomic_sources)
if(NOT actual_atomic_sources STREQUAL "mmix/atomic.c")
  message(FATAL_ERROR
    "unexpected MMIX atomic fallback sources: ${actual_atomic_sources}")
endif()
list(JOIN mmix_STACK_PROTECTOR_SOURCES ";" actual_stack_protector_sources)
if(NOT actual_stack_protector_sources STREQUAL
   "mmix/stack_protector_fail.c;mmix/stack_protector_guard.c")
  message(FATAL_ERROR
    "unexpected MMIX stack protector sources: ${actual_stack_protector_sources}")
endif()
