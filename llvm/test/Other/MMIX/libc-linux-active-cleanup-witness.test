# REQUIRES: mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../.. %t %mmix_host_cxx

# Native production-dispatch/owner regression with injected kernel, cursor and
# lease services. This does not qualify target forced unwind or fork recovery.
# Non-image-owning profiles require a real dispatch witness with empty ownership;
# shared profiles retain the detached Invocation and pending-record lease checks.
# Normal-pop observations cover public registered push/pop, three nested callback
# levels, changed serials, remaining ownership and restoration at each return.
# Ordinary/terminal/async-type claims remain local observations, not forced-state
# authentication. Actual async dispatch and signal-origin callbacks are negative
# controls; C stop dispatch still traps on nested registration. Only async-enabled
# profiles have the registered C++ push entrypoint; other profiles exercise
# registered C pop, not unregistered C++ guards.
#--- run.py
import pathlib
import shlex
import subprocess
import sys

source, out = map(pathlib.Path, sys.argv[1:3])
profiles = {
    "generic": [],
    "static-async": ["LIBC_MMIX_ASYNC_CANCELLATION"],
    "static-signal": ["LIBC_MMIX_ASYNC_CANCELLATION",
                      "LIBC_MMIX_SIGNAL_CLEANUP"],
    "shared": ["LIBC_MMIX_SHARED_STARTUP"],
    "async": ["LIBC_MMIX_SHARED_STARTUP", "LIBC_MMIX_ASYNC_CANCELLATION"],
    "signal": ["LIBC_MMIX_SHARED_STARTUP", "LIBC_MMIX_ASYNC_CANCELLATION",
               "LIBC_MMIX_SIGNAL_CLEANUP"],
}
for name, macros in profiles.items():
    for opt in ("0", "2"):
        exe = out / (name + "-O" + opt)
        subprocess.run([
            *shlex.split(sys.argv[3]), "-std=c++17", "-UNDEBUG", "-O" + opt,
            "-I", str(out), "-I", str(source / "libc"),
            "-I", str(source / "libunwind/src"),
            "-DLIBC_NAMESPACE=active_cleanup_witness_test",
            "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
            "-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL",
            *["-D" + macro for macro in macros],
            str(source / "libc/test/src/__support/threads/active-cleanup-witness-native.cpp"),
            "-o", str(exe)], check=True)
        subprocess.run([str(exe)], check=True, timeout=30)

#--- asm/rstack.h
#ifndef TEST_ACTIVE_CLEANUP_WITNESS_RSTACK_H
#define TEST_ACTIVE_CLEANUP_WITNESS_RSTACK_H
#include <stdint.h>
#define __NR_mmix_rstack_query 10000
struct mmix_rstack_query { uint64_t chain_id; };
#endif

#--- libunwind.h
#ifndef TEST_ACTIVE_CLEANUP_WITNESS_LIBUNWIND_H
#define TEST_ACTIVE_CLEANUP_WITNESS_LIBUNWIND_H
#include <stdint.h>
typedef uintptr_t unw_word_t;
struct unw_context_t {};
struct unw_cursor_t { unsigned step; };
struct unw_proc_info_t { uintptr_t start_ip; };
enum { UNW_MMIX_RO = 0, UNW_REG_SP = 1 };
extern "C" {
int unw_getcontext(unw_context_t *);
int unw_init_local(unw_cursor_t *, unw_context_t *);
int unw_step(unw_cursor_t *);
int unw_is_signal_frame(unw_cursor_t *);
int unw_get_reg(unw_cursor_t *, int, unw_word_t *);
int unw_get_proc_info(unw_cursor_t *, unw_proc_info_t *);
}
#endif
