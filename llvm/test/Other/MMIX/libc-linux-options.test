# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../../libc %t clang

#--- check.py
from pathlib import Path
import subprocess
import sys

libc, work = map(lambda p: Path(p).resolve(), sys.argv[1:3])
clang = sys.argv[3]
base = ["THREADED_LIBC", "THREAD_LIFECYCLE", "PTHREAD_CREATION",
        "PTHREAD_LIFECYCLE", "PTHREAD_MUTEX", "PTHREAD_COND", "PTHREAD_ONCE",
        "PTHREAD_TSS", "PTHREAD_SIGNALS", "DEFERRED_CANCELLATION",
        "ASYNC_CANCELLATION", "COORDINATED_FORK"]
extensions = {
    "PTHREAD_SCHEDULING": "THREAD_PRIORITY_SCHEDULING",
    "PI_MUTEX": "THREAD_PRIO_INHERIT",
    "PROTECT_MUTEX": "THREAD_PRIO_PROTECT",
    "PROCESS_SHARED": "THREAD_PROCESS_SHARED",
    "PTHREAD_CLOCKS": "THREAD_CPUTIME",
    "PTHREAD_BARRIER": "BARRIERS",
    "PTHREAD_RWLOCK": "READER_WRITER_LOCKS",
    "PTHREAD_SPIN": "SPIN_LOCKS",
}
all_flags = base + list(extensions) + ["ROBUST_MUTEX"]
options = ["THREADS", "THREAD_ATTR_STACKADDR", "THREAD_ATTR_STACKSIZE",
           *extensions.values(), "THREAD_ROBUST_PRIO_INHERIT",
           "THREAD_ROBUST_PRIO_PROTECT", "SPAWN", "REGEXP"]
providers = {
    "MAPPED_FILES": {"sys.mman.mmap", "sys.mman.munmap"},
    "MEMORY_PROTECTION": {"sys.mman.mprotect"},
    "SHARED_MEMORY_OBJECTS": {"sys.mman.shm_open", "sys.mman.shm_unlink"},
    "FSYNC": {"unistd.fsync", "unistd.fdatasync"},
    "SYNCHRONIZED_IO": {"unistd.fsync", "unistd.fdatasync"},
    "MEMLOCK": {"sys.mman.mlockall", "sys.mman.munlockall"},
    "MEMLOCK_RANGE": {"sys.mman.mlock", "sys.mman.munlock"},
    "SEMAPHORES": {"semaphore." + name for name in (
        "sem_init", "sem_open", "sem_wait", "sem_post", "sem_close",
        "sem_unlink", "sem_destroy", "sem_getvalue", "sem_trywait",
        "sem_timedwait")},
    "MONOTONIC_CLOCK": {"time.clock_gettime", "time.clock_getres"},
    "CLOCK_SELECTION": {"time.clock_nanosleep",
                        "pthread.pthread_condattr_setclock",
                        "pthread.pthread_condattr_getclock"},
    "CPUTIME": {"time.clock_getcpuclockid", "time.clock_gettime",
                "time.clock_getres"},
    "REALTIME_SIGNALS": {"signal.sigqueue", "signal.sigtimedwait",
                        "signal.sigwaitinfo"},
    "PRIORITY_SCHEDULING": {"sched.sched_setscheduler",
                           "sched.sched_getscheduler",
                           "sched.sched_setparam", "sched.sched_getparam"},
    "SAVED_IDS": {"unistd.setuid", "unistd.setgid"},
    "JOB_CONTROL": {"unistd.tcsetpgrp", "unistd.tcgetpgrp", "unistd.setsid"},
    "TIMEOUTS": {"semaphore.sem_timedwait", "pthread.pthread_mutex_timedlock",
                 "pthread.pthread_rwlock_timedrdlock",
                 "pthread.pthread_rwlock_timedwrlock"},
}

def check(name, enabled, entries=()):
    directory = work / name
    header = directory / "llvm-libc-macros/mmix/unistd-options.h"
    header.parent.mkdir(parents=True, exist_ok=True)
    script = directory / "configure.cmake"
    script.write_text(
        'include("' + str(libc / "include/llvm-libc-macros/mmix/UnistdOptions.cmake") + '")\n' +
        "".join("set(LIBC_MMIX_BUILD_" + flag + " ON)\n" for flag in enabled) +
        'set(TARGET_LIBC_ENTRYPOINTS ' +
        " ".join("libc.src." + entry for entry in entries) + ')\n' +
        'mmix_configure_unistd_options("' + str(header) + '")\n')
    subprocess.run(["cmake", "-P", script], check=True)
    public = set(base) <= set(enabled)
    expected = {option: -1 for option in options}
    for option, required in providers.items():
        value = 1 if option in {"SAVED_IDS", "JOB_CONTROL"} else 200809
        expected[option] = value if required <= set(entries) else -1
    if public:
        for option in ("THREADS", "THREAD_ATTR_STACKADDR", "THREAD_ATTR_STACKSIZE"):
            expected[option] = 200809
        for flag, option in extensions.items():
            if flag in enabled:
                expected[option] = 200809
        if "ROBUST_MUTEX" in enabled and "PI_MUTEX" in enabled:
            expected["THREAD_ROBUST_PRIO_INHERIT"] = 200809
    source = directory / "probe.c"
    source.write_text(
        '#include "llvm-libc-macros/mmix/unistd-macros.h"\n' +
        "".join('_Static_assert(_POSIX_' + option + ' == ' + str(value) +
                'L, "' + option + '");\n' for option, value in expected.items()) +
        '#if defined(_POSIX_VERSION) || defined(_XOPEN_VERSION)\n'
        '#error "Do not advertise complete POSIX/XSI conformance"\n#endif\n')
    # Private consumer flags must not change the installed provider contract.
    subprocess.run([clang, "-cc1", "-triple", "mmix-unknown-linux",
                    "-std=c17", "-ffreestanding", "-DLIBC_THREAD_MODE=0",
                    "-I", str(directory), "-I", str(libc / "include"),
                    "-fsyntax-only", str(source)], check=True)

check("minimal", [])
check("full", all_flags)
for flag in all_flags:
    check("without-" + flag, [f for f in all_flags if f != flag])

entries = sorted(set.union(*providers.values()))
check("selected-providers", [], entries)
check("partial-spawn", all_flags + ["SPAWN"],
      entries + ["spawn.posix_spawn", "spawn.posix_spawnp"])
check("partial-regexp", all_flags,
      entries + ["regex." + name for name in
                 ("regcomp", "regexec", "regerror", "regfree")])
for entry in entries:
    check("without-provider-" + entry, [], [e for e in entries if e != entry])
