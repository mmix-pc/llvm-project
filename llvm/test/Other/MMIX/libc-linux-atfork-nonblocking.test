# REQUIRES: mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libc %t %mmix_host_cxx

# Native production callback registry, not guest signal-handler qualification.
#--- run.py
import pathlib
import shlex
import subprocess
import sys
source, out = map(pathlib.Path, sys.argv[1:3])
for opt in ('0', '2'):
    exe = out / ('native-O' + opt)
    subprocess.run([*shlex.split(sys.argv[3]), '-std=c++17', '-UNDEBUG',
                    '-O' + opt, '-DLIBC_NAMESPACE=atfork_snapshot_test',
                    '-I', str(source), str(out / 'test.cpp'), '-o', str(exe)],
                   check=True)
    subprocess.run([str(exe)], check=True, timeout=5)

#--- test.cpp
#include <cassert>
#include "src/__support/threads/linux/mmix/atfork_callbacks.cpp"
namespace M = atfork_snapshot_test::mmix;
static unsigned prepared, parents, children;
static bool busy_parent;
static void prepare() { ++prepared; }
static void parent() {
  ++parents;
  bool locked = M::try_lock_fork_callbacks();
  assert(locked != busy_parent);
  if (locked) M::registry.mutex.unlock();
}
static void child() { ++children; }
int main() {
  assert(M::register_fork_callbacks(prepare, parent, child));
  size_t count = M::prepare_fork_callbacks();
  assert(count == 1 && prepared == 1);
  // A peer owns registration while fork holds its unrelated snapshot locks.
  M::registry.mutex.lock();
  assert(!M::try_lock_fork_callbacks());
  busy_parent = true;
  M::finish_fork_callbacks(count, false, false);
  assert(parents == 1 && !children && !M::try_lock_fork_callbacks());
  M::registry.mutex.unlock();
  busy_parent = false;
  assert(M::register_fork_callbacks(prepare, parent, child));
  // Late registration does not enlarge the old prepared prefix.
  M::finish_fork_callbacks(count, false, false);
  assert(parents == 2 && !children);
  count = M::prepare_fork_callbacks();
  assert(count == 2 && prepared == 3 && M::try_lock_fork_callbacks());
  M::finish_fork_callbacks(count, false, true);
  assert(parents == 4 && !children && M::try_lock_fork_callbacks());
  M::finish_fork_callbacks(count, true, true);
  assert(children == 2 && M::try_lock_fork_callbacks());
  M::registry.mutex.unlock();
}
