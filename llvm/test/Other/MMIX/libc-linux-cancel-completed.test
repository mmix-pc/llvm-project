# REQUIRES: mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../.. %t %mmix_host_cxx

# Production cancellation/registry with deterministic native interleavings.
# Notification interception does not qualify MMIX signal delivery or unwinding.
#--- run.py
import pathlib
import shlex
import subprocess
import sys

source, out = map(pathlib.Path, sys.argv[1:3])
for opt in ("0", "2"):
    exe = out / ("cancel-completed-O" + opt)
    subprocess.run([
        *shlex.split(sys.argv[3]), "-std=c++17", "-UNDEBUG", "-O" + opt,
        "-pthread", "-ffunction-sections", "-fdata-sections", "-Wl,--gc-sections",
        "-I", str(out), "-I", str(source / "libc"),
        "-DLIBC_NAMESPACE=cancel_completed_test",
        "-DLIBC_THREAD_MODE=LIBC_THREAD_MODE_PLATFORM",
        "-DLIBC_ERRNO_MODE=LIBC_ERRNO_MODE_THREAD_LOCAL",
        "-DLIBC_MMIX_CANCELLATION_WINDOWS",
        str(source / "libc/test/src/__support/threads/mmix_cancel_completed_native.cpp"),
        "-o", str(exe)], check=True)
    subprocess.run([str(exe)], check=True, timeout=30)

#--- asm/rstack.h
#ifndef TEST_CANCEL_COMPLETED_RSTACK_H
#define TEST_CANCEL_COMPLETED_RSTACK_H
#include <stdint.h>
#define __NR_mmix_rstack_query 10000
struct mmix_rstack_query { uint64_t chain_id; };
#endif
