# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../../libc %t clang

#--- check.py
from pathlib import Path
import shutil
import subprocess
import sys

libc, out = map(Path, sys.argv[1:3])
clang = sys.argv[3]
resource = subprocess.check_output(
    [clang, "--no-default-config", "-print-resource-dir"], text=True).strip()
include = out / "include"
include.mkdir(exist_ok=True)
for name in ("llvm-libc-types", "llvm-libc-macros"):
    shutil.copytree(libc / "include" / name, include / name, dirs_exist_ok=True)
shutil.copyfile(libc / "include/__llvm-libc-common.h", include / "__llvm-libc-common.h")
for name in ("mqueue", "semaphore", "fcntl"):
    subprocess.run([sys.executable, str(libc / "utils/hdrgen/main.py"),
                    str(libc / "include" / (name + ".yaml")),
                    "-o", str(include / (name + ".h"))], check=True)
for triple in ("mmix-unknown-linux", "x86_64-unknown-linux-gnu"):
    for language in ("c", "c++"):
        command = [clang, "--no-default-config", "--target=" + triple,
                   "-nostdinc", "-I", str(include), "-isystem", resource + "/include",
                   "-x", language, "-std=c17" if language == "c" else "-std=c++17",
                   "-fsyntax-only", "-Werror", "-"]
        check = "static_assert" if language == "c++" else "_Static_assert"
        for first in ("", "#include <fcntl.h>\n"):
            source = first + '#include <mqueue.h>\n' + check + '''(sizeof(mqd_t) == 4, "descriptor ABI");
int (*close_fn)(mqd_t) = &mq_close;
int (*get_fn)(mqd_t, struct mq_attr *) = &mq_getattr;
int (*notify_fn)(mqd_t, const struct sigevent *) = &mq_notify;
mqd_t (*open_fn)(const char *, int, ...) = &mq_open;
ssize_t (*receive_fn)(mqd_t, char *, size_t, unsigned *) = &mq_receive;
int (*send_fn)(mqd_t, const char *, size_t, unsigned) = &mq_send;
int (*set_fn)(mqd_t, const struct mq_attr *, struct mq_attr *) = &mq_setattr;
ssize_t (*timedreceive_fn)(mqd_t, char *, size_t, unsigned *, const struct timespec *) = &mq_timedreceive;
int (*timedsend_fn)(mqd_t, const char *, size_t, unsigned, const struct timespec *) = &mq_timedsend;
int (*unlink_fn)(const char *) = &mq_unlink;
int creation_flags = O_RDONLY | O_WRONLY | O_RDWR | O_CREAT | O_EXCL | O_NONBLOCK;
'''
            source += check + '(sizeof(struct mq_attr) == 64 && __alignof__(struct mq_attr) == 8, "queue ABI");\n'
            for member, offset in (("mq_flags", 0), ("mq_maxmsg", 8), ("mq_msgsize", 16), ("mq_curmsgs", 24)):
                source += check + '(__builtin_offsetof(struct mq_attr, ' + member + ') == ' + str(offset) + ', "queue member offset");\n'
                source += 'void check_' + member + '(struct mq_attr *a) { long *p = &a->' + member + '; }\n'
            if language == "c++":
                source += '''static_assert(!noexcept(mq_receive(0, nullptr, 0, nullptr)), "cancellation");
static_assert(!noexcept(mq_send(0, nullptr, 0, 0)), "cancellation");
static_assert(!noexcept(mq_timedreceive(0, nullptr, 0, nullptr, nullptr)), "cancellation");
static_assert(!noexcept(mq_timedsend(0, nullptr, 0, 0, nullptr)), "cancellation");
'''
            subprocess.run(command, input=source, text=True, check=True)
        # semaphore.h must supply its required creation flags independently.
        subprocess.run(command, input='#include <semaphore.h>\nint flags = O_CREAT | O_EXCL;\n',
                       text=True, check=True)
