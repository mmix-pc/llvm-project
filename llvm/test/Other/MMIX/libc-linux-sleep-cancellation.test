# REQUIRES: mmix-registered-target
# RUN: split-file %s %t
# RUN: %python %t/check.py %S/../../../../libc %t

#--- check.py
import pathlib
import subprocess
import sys

libc, root = map(pathlib.Path, sys.argv[1:3])
sources = [libc / ('src/unistd/linux/mmix/cancellation_' + name + '.cpp')
           for name in ('sleep', 'usleep')]
for opt in ('0', '2'):
    for source in sources:
        obj = root / (source.stem + opt + '.o')
        subprocess.run(['clang', '--target=mmix-unknown-linux', '-O' + opt,
                        '-std=c++17', '-ffreestanding', '-fexceptions',
                        '-funwind-tables', '-DLIBC_FULL_BUILD',
                        '-DLIBC_NAMESPACE=sleep_test', '-I', str(root),
                        '-I', str(libc), '-c', str(source), '-o', str(obj)], check=True)
        undefined = subprocess.check_output(['llvm-nm', '-u', str(obj)], text=True)
        assert 'cancellation_syscall' in undefined, undefined
        assert '__llvm_libc_mmix_syscall' not in undefined, undefined
        sections = subprocess.check_output(['llvm-readobj', '--sections', str(obj)], text=True)
        assert '.eh_frame' in sections, sections
    if len(sys.argv) == 4:
        binary = root / ('native-' + opt)
        subprocess.run([sys.argv[3], '--no-default-config', '-O' + opt, '-std=c++17',
                        '-DLIBC_NAMESPACE=sleep_test', '-DLIBC_ERRNO_MODE=6',
                        '-I', str(libc), *map(str, sources), str(root / 'native.cpp'),
                        '-o', str(binary)], check=True)
        subprocess.run([str(binary)], check=True, timeout=10)

#--- sys/syscall.h
#define SYS_nanosleep 101

#--- linux/errno.h
// This compile-only fixture does not inspect errno constants.

#--- native.cpp
#include "src/unistd/sleep.h"
#include "src/unistd/usleep.h"
#include "src/__support/threads/linux/mmix/cancellation_point.h"
#include <assert.h>
#include <errno.h>
#include <limits.h>
#include <sys/syscall.h>
#include <time.h>

static long result, seconds, nanoseconds, remaining;
static bool interrupted, expects_remaining;
static int calls;
namespace sleep_test { namespace mmix {
long cancellation_syscall(unsigned long number, long request, long rest,
                          long a3, long a4, long a5, long a6) {
  ++calls;
  assert(number == SYS_nanosleep && !a3 && !a4 && !a5 && !a6);
  auto *ts = reinterpret_cast<timespec *>(request);
  assert(ts->tv_sec == seconds && ts->tv_nsec == nanoseconds);
  assert(bool(rest) == expects_remaining);
  if (rest) {
    auto *rem = reinterpret_cast<timespec *>(rest);
    assert(!rem->tv_sec && !rem->tv_nsec);
    rem->tv_sec = remaining;
    rem->tv_nsec = 999999999;
  }
  if (interrupted)
    throw 42;
  return result;
}
} }
int main() {
  expects_remaining = true;
  errno = EDOM;
  assert(sleep_test::sleep(0) == 0 && errno == EDOM && calls == 1);
  seconds = UINT_MAX;
  assert(sleep_test::sleep(UINT_MAX) == 0);
  seconds = 3;
  remaining = 2;
  result = -EINTR;
  assert(sleep_test::sleep(3) == 2 && errno == EDOM);
  interrupted = true;
  try { sleep_test::sleep(3); assert(false); } catch (int value) { assert(value == 42); }
  expects_remaining = false;
  seconds = 1;
  nanoseconds = 234000;
  try { sleep_test::usleep(1000234); assert(false); } catch (int value) { assert(value == 42); }
  interrupted = false;
  assert(sleep_test::usleep(1000234) == -1 && errno == EINTR);
  result = 0;
  seconds = UINT_MAX / 1000000;
  nanoseconds = (UINT_MAX % 1000000) * 1000;
  assert(sleep_test::usleep(UINT_MAX) == 0);
  seconds = nanoseconds = 0;
  assert(sleep_test::usleep(0) == 0);
}
