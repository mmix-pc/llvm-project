#--- CMakeLists.txt
cmake_minimum_required(VERSION 3.20)
project(MathCompatibility NONE)
option(ENABLE_MATH "Select the math profile" ON)
set(LIBC_MMIX_BUILD_MATH ${ENABLE_MATH})
set(LLVM_LIBC_FULL_BUILD ON)
set(LIBC_LIBRARY_DIR ${CMAKE_BINARY_DIR}/lib)
set(LIBC_INSTALL_LIBRARY_DIR lib)
include(${LIBC_SOURCE}/config/linux/mmix/MathLinkerScript.cmake)

#--- math.s
.text
.globl math_provider
math_provider:
  POP 0, 0

#--- start.s
.text
.globl _start
_start:
  PUSHJ r0, math_provider
  TRAP 255, 0, 0
