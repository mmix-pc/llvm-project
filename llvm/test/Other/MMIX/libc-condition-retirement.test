# REQUIRES: mmix-registered-target, mmix-native-linux-host
# RUN: %python %s %S/../../../../libc %t "%mmix_host_cxx"

# Actual generic CndVar shared paths and Linux futex drain. Wait results and
# cancellation are injected; public MMIX cancellation needs guest coverage.
import pathlib
import shlex
import subprocess
import sys

libc, out = map(pathlib.Path, sys.argv[1:3])
host = shlex.split(sys.argv[3])
out.mkdir(parents=True, exist_ok=True)
for opt in ("0", "2"):
    exe = out / ("native-O" + opt)
    subprocess.run([*host, "-std=c++17", "-fexceptions", "-pthread", "-UNDEBUG",
                    "-O" + opt, "-I", str(libc),
                    "-DLIBC_NAMESPACE=condition_retirement_test",
                    str(libc / "test/src/__support/threads/condition-retirement-native.cpp"),
                    "-MD", "-MF", str(exe) + ".d", "-o", str(exe)], check=True)
    subprocess.run([str(exe)], check=True, timeout=20)

# Inject the Darwin platform API while compiling the actual Darwin adapter.
# Runtime Darwin kernel semantics are not supplied by this Linux host test.
sdk = out / "sdk" / "os"
sdk.mkdir(parents=True, exist_ok=True)
(sdk / "os_sync_wait_on_address.h").write_text("""
#pragma once
#include <stddef.h>
#include <stdint.h>
typedef unsigned os_sync_wait_on_address_flags_t;
typedef unsigned os_sync_wake_by_address_flags_t;
enum { OS_SYNC_WAIT_ON_ADDRESS_NONE = 0, OS_SYNC_WAIT_ON_ADDRESS_SHARED = 1,
       OS_SYNC_WAKE_BY_ADDRESS_NONE = 0, OS_SYNC_WAKE_BY_ADDRESS_SHARED = 1,
       OS_CLOCK_MACH_ABSOLUTE_TIME = 1 };
int os_sync_wait_on_address(void *, uint64_t, size_t, os_sync_wait_on_address_flags_t);
int os_sync_wait_on_address_with_timeout(void *, uint64_t, size_t,
                                        os_sync_wait_on_address_flags_t, int, uint64_t);
int os_sync_wake_by_address_any(void *, size_t, os_sync_wake_by_address_flags_t);
int os_sync_wake_by_address_all(void *, size_t, os_sync_wake_by_address_flags_t);
""")
for opt in ("0", "2"):
    exe = out / ("darwin-adapter-O" + opt)
    subprocess.run([*host, "-std=c++17", "-UNDEBUG", "-O" + opt,
                    "-I", str(sdk.parent), "-I", str(libc),
                    "-DLIBC_NAMESPACE=condition_retirement_test",
                    str(libc / "test/src/__support/threads/futex-address-darwin-native.cpp"),
                    "-MD", "-MF", str(exe) + ".d", "-o", str(exe)], check=True)
    subprocess.run([str(exe)], check=True, timeout=10)
