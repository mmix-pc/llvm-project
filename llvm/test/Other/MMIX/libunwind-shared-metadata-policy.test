# REQUIRES: mmix-native-linux-host
# RUN: split-file %s %t
# RUN: %python %t/run.py %S/../../../../libunwind %t %mmix_host_cxx

# Check the actual MMIX build selector and a single startup TLS provider shared
# by two native DSOs, plus private saved-context gates with native fake backends.
# This is not MMIX signal-unwind execution qualification.
#--- run.py
import pathlib
import shlex
import subprocess
import sys

source, root = map(pathlib.Path, sys.argv[1:3])
source = source.resolve()
host = shlex.split(sys.argv[3])
for enabled in (False, True):
    build = root / ("on" if enabled else "off")
    subprocess.run(["cmake", "-S", str(root), "-B", str(build),
                    "-DUNWIND_SOURCE=" + str(source),
                    "-DENABLE_POLICY=" + ("ON" if enabled else "OFF")], check=True)
    selected = (build / "sources.txt").read_text()
    exports = (build / "mmix-shared-unwind.exports").read_text()
    assert ("UnwindMetadataPolicy.cpp" in selected) == enabled
    assert ("ForcedContext.cpp" in selected) == enabled
    for name in ("enter", "commit", "leave", "current"):
        assert ("__unw_metadata_policy_" + name + ";" in exports) == enabled
    for name in ("cursor_checkpoint", "forced_capture", "forced_validate",
                 "forced_quarantine", "set_managed_stop"):
        assert "__libunwind_mmix_" + name + ";" in exports
    for name in ("cursor_at_checkpoint", "cursor_finish_at",
                 "init_saved_cursor", "forcedunwind_from_context"):
        assert ("__libunwind_mmix_" + name + ";" in exports) == enabled
    assert "__unw_init_local_current;" not in exports

for opt in ("0", "2"):
    build = root / ("host-O" + opt)
    build.mkdir(exist_ok=True)
    flags = ["-std=c++17", "-O" + opt, "-Wall", "-Wextra", "-Werror",
             "-I", str(source / "src"), "-D_LIBUNWIND_USE_METADATA_POLICY"]
    provider = build / "libpolicy.so"
    subprocess.run([*host, *flags, "-fPIC", "-ftls-model=initial-exec", "-shared",
                    str(source / "src/UnwindMetadataPolicy.cpp"), "-o", str(provider)], check=True)
    consumer = build / "libconsumer.so"
    subprocess.run([*host, *flags, "-fPIC", "-shared", str(root / "consumer.cpp"),
                    "-L" + str(build), "-lpolicy", "-Wl,-z,defs,-z,now",
                    "-Wl,-rpath,$ORIGIN", "-o", str(consumer)], check=True)
    exe = build / "test"
    subprocess.run([*host, *flags, str(root / "main.cpp"), "-L" + str(build),
                    "-lconsumer", "-lpolicy", "-Wl,-z,now", "-Wl,-rpath,$ORIGIN",
                    "-o", str(exe)], check=True)
    subprocess.run([str(exe)], check=True, timeout=30)
    forced = build / "forced"
    subprocess.run([*host, *flags, "-I", str(source / "include"),
                    str(root / "forced.cpp"), str(source / "src/mmix/ForcedContext.cpp"),
                    str(source / "src/UnwindMetadataPolicy.cpp"), "-o", str(forced)], check=True)
    subprocess.run([str(forced)], check=True, timeout=30)

#--- CMakeLists.txt
cmake_minimum_required(VERSION 3.20)
project(SharedMetadataPolicy CXX)
add_library(unwind_shared_objects OBJECT consumer.cpp)
add_library(unwind_shared SHARED $<TARGET_OBJECTS:unwind_shared_objects>)
if(ENABLE_POLICY)
  set(LIBUNWIND_ADDITIONAL_COMPILE_FLAGS -D_LIBUNWIND_USE_METADATA_POLICY)
endif()
include("${UNWIND_SOURCE}/src/mmix/Shared.cmake")
function(check_sources)
  get_target_property(sources unwind_shared_objects SOURCES)
  file(WRITE "${CMAKE_BINARY_DIR}/sources.txt" "${sources}")
endfunction()
cmake_language(DEFER CALL check_sources)

#--- consumer.cpp
#include "UnwindMetadataPolicy.h"
extern "C" unsigned observed() {
  return libunwind::currentUnwindMetadataPolicy();
}
extern "C" int nested(UnwindMetadataPolicyToken *token) {
  return __unw_metadata_policy_enter(token);
}
extern "C" int finish(UnwindMetadataPolicyToken *token) {
  return __unw_metadata_policy_leave(token);
}

#--- main.cpp
#include "UnwindMetadataPolicy.h"
#include <cstdlib>
extern "C" unsigned observed();
extern "C" int nested(UnwindMetadataPolicyToken *);
extern "C" int finish(UnwindMetadataPolicyToken *);
static void check(bool value) { if (!value) std::abort(); }
int main() {
  UnwindMetadataPolicyToken outer{}, inner{};
  check(observed() == UNW_METADATA_ORDINARY);
  check(__unw_metadata_policy_enter(&outer));
  check(observed() == UNW_METADATA_PREFLIGHT);
  check(nested(&inner));
  check(!__unw_metadata_policy_leave(&outer));
  check(__unw_metadata_policy_commit(&inner));
  check(observed() == UNW_METADATA_TERMINAL);
  check(finish(&inner));
  check(observed() == UNW_METADATA_PREFLIGHT);
  check(finish(&outer));
  check(observed() == UNW_METADATA_ORDINARY);
  check(!finish(&outer));
}

#--- forced.cpp
#include "mmix/ForcedContext.h"
#include "UnwindMetadataPolicy.h"
#include <cstdlib>
static unsigned calls;
static unsigned initCalls;
static int initResult;
static _Unwind_Exception object{};
static unw_cursor_t cursor{};
static unw_context_t saved{};
static unw_cursor_t *expectedCursor = &cursor;
static unw_context_t *expectedContext = &saved;
extern "C" int __unw_init_local_current(unw_cursor_t *output,
                                      unw_context_t *context) {
  if (output != expectedCursor || context != expectedContext ||
      __unw_metadata_policy_current() != UNW_METADATA_PREFLIGHT)
    std::abort();
  ++initCalls;
  return initResult;
}
static _Unwind_Reason_Code stop(int, _Unwind_Action, _Unwind_Exception_Class,
                               _Unwind_Exception *, _Unwind_Context *, void *) {
  std::abort();
}
extern "C" _Unwind_Reason_Code __unw_forcedunwind_from_context(
    _Unwind_Exception *exception, _Unwind_Stop_Fn callback, void *argument,
    unw_context_t *context) {
  if (exception != &object || callback != stop || argument != &calls || context != &saved)
    std::abort();
  ++calls;
  return _URC_END_OF_STACK;
}
static void check(bool value) { if (!value) std::abort(); }
int main() {
  auto run = [] { return __libunwind_mmix_forcedunwind_from_context(&object, stop, &calls, &saved); };
  auto init = [] { return __libunwind_mmix_init_saved_cursor(expectedCursor, expectedContext); };
  check(__unw_metadata_policy_current() == UNW_METADATA_ORDINARY);
  check(init() == UNW_EINVAL && initCalls == 0 && calls == 0);
  check(run() == _URC_FATAL_PHASE2_ERROR && calls == 0);
  UnwindMetadataPolicyToken policy{};
  check(__unw_metadata_policy_enter(&policy));
  const int results[] = {UNW_ESUCCESS, UNW_ENOINFO, UNW_EINVAL};
  for (int result : results) {
    initResult = result;
    unsigned before = initCalls;
    check(init() == result && initCalls == before + 1 && calls == 0);
    check(__unw_metadata_policy_current() == UNW_METADATA_PREFLIGHT);
  }
  // Argument validation belongs to the hidden initializer, not this gate.
  expectedCursor = nullptr;
  check(init() == UNW_EINVAL && initCalls == 4 && calls == 0);
  expectedCursor = &cursor;
  expectedContext = nullptr;
  check(init() == UNW_EINVAL && initCalls == 5 && calls == 0);
  expectedContext = &saved;
  check(run() == _URC_FATAL_PHASE2_ERROR && calls == 0);
  check(__unw_metadata_policy_commit(&policy));
  check(__unw_metadata_policy_current() == UNW_METADATA_TERMINAL);
  check(init() == UNW_EINVAL && initCalls == 5 && calls == 0);
  check(__unw_metadata_policy_current() == UNW_METADATA_TERMINAL);
  check(run() == _URC_END_OF_STACK && calls == 1);
  check(__unw_metadata_policy_leave(&policy));
  check(__unw_metadata_policy_current() == UNW_METADATA_ORDINARY);
  check(init() == UNW_EINVAL && initCalls == 5 && calls == 1);
  check(run() == _URC_FATAL_PHASE2_ERROR && calls == 1);
}
