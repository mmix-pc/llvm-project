# RUN: llc -mtriple=mmix -run-pass=prolog-epilog -verify-machineinstrs \
# RUN:   -o - %s | FileCheck %s

# CHECK: frame-setup CFI_INSTRUCTION def_cfa $r253, 0
# CHECK: $r254 = frame-setup ANDNI $r254, 15
# CHECK: $r254 = frame-destroy SUBUI $r253, [[SIZE:[0-9]+]]
# CHECK-NEXT: frame-destroy CFI_INSTRUCTION def_cfa $r254, [[SIZE]]
# CHECK: $r253 = LDOU
# CHECK-NEXT: frame-destroy CFI_INSTRUCTION same_value $r253
# CHECK-NEXT: $r254 = frame-destroy ADDUI $r254, [[SIZE]]
# CHECK-NEXT: frame-destroy CFI_INSTRUCTION def_cfa_offset 0

--- |
  define void @overaligned_object() {
    ret void
  }
...
---
name:            overaligned_object
tracksRegLiveness: true
stack:
  - { id: 0, size: 16, alignment: 16 }
body:             |
  bb.0:
    POP 0, 0
...
