# RUN: llc -mtriple=mmix -start-before=postrapseudos -verify-machineinstrs \
# RUN:   -filetype=obj %s -o %t.o
# RUN: llvm-readobj --sections --section-data --relocations --expand-relocs \
# RUN:   %t.o | FileCheck %s --check-prefix=OBJ --implicit-check-not=R_MMIX_
# RUN: llvm-objdump --no-print-imm-hex -dr %t.o \
# RUN:   | FileCheck %s --check-prefix=DIS
# RUN: llc -mtriple=mmix-unknown-linux -start-before=postrapseudos -verify-machineinstrs -filetype=obj %s -o %t.linux.o
# RUN: llvm-readobj --sections --section-data --relocations --expand-relocs \
# RUN:   %t.linux.o | FileCheck %s --check-prefix=OBJ --implicit-check-not=R_MMIX_ --implicit-check-not=.MMIX.reg_contents
# RUN: llvm-objdump --no-print-imm-hex -dr %t.linux.o | FileCheck %s --check-prefix=DIS

# OBJ:      Name: .rodata.cst8
# OBJ-NEXT: Type: SHT_PROGBITS
# OBJ-NEXT: Flags [
# OBJ-NEXT:   SHF_ALLOC
# OBJ-NEXT:   SHF_MERGE
# OBJ-NEXT: ]
# OBJ-NEXT: Address: 0x0
# OBJ-NEXT: Offset: 0x{{[0-9A-F]+}}
# OBJ-NEXT: Size: 8
# OBJ-NEXT: Link: 0
# OBJ-NEXT: Info: 0
# OBJ-NEXT: AddressAlignment: 8
# OBJ-NEXT: EntrySize: 8
# OBJ-NEXT: SectionData (
# OBJ-NEXT:   0000: 11223344 55667788
# OBJ-NEXT: )
# OBJ:      Relocations [
# OBJ-NEXT:   Section {{.*}} .rela.text {
# OBJ-NEXT:     Relocation {
# OBJ-NEXT:       Offset: 0x0
# OBJ-NEXT:       Type: R_MMIX_GETA (13)
# OBJ-NEXT:       Symbol: .rodata.cst8
# OBJ-NEXT:       Addend: 0x0
# OBJ-NEXT:     }
# OBJ-NEXT:   }
# OBJ-NEXT: ]

# DIS-LABEL: <constant_pool_address>:
# DIS-NEXT:  {{.*}} GETA r0, 0
# DIS-NEXT:  {{.*}} R_MMIX_GETA .rodata.cst8
# DIS-NEXT:  {{.*}} SWYM 0, 0, 0
# DIS-NEXT:  {{.*}} SWYM 0, 0, 0
# DIS-NEXT:  {{.*}} SWYM 0, 0, 0
# DIS-NEXT:  {{.*}} POP 0, 0

--- |
  define void @constant_pool_address() nounwind {
  entry:
    ret void
  }
...
---
name: constant_pool_address
tracksRegLiveness: true
constants:
  - id: 0
    value: 'i64 1234605616436508552'
    alignment: 8
body: |
  bb.0.entry:
    $r0 = LOAD_ADDR %const.0
    POP 0, 0
...
