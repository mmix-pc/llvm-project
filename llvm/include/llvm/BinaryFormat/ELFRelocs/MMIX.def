#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

ELF_RELOC(R_MMIX_NONE, 0)

// Standard absolute relocations.
ELF_RELOC(R_MMIX_8, 1)
ELF_RELOC(R_MMIX_16, 2)
ELF_RELOC(R_MMIX_24, 3)
ELF_RELOC(R_MMIX_32, 4)
ELF_RELOC(R_MMIX_64, 5)

// Standard PC-relative relocations.
ELF_RELOC(R_MMIX_PC_8, 6)
ELF_RELOC(R_MMIX_PC_16, 7)
ELF_RELOC(R_MMIX_PC_24, 8)
ELF_RELOC(R_MMIX_PC_32, 9)
ELF_RELOC(R_MMIX_PC_64, 10)

// GNU extensions for C++ vtables.
ELF_RELOC(R_MMIX_GNU_VTINHERIT, 11)
ELF_RELOC(R_MMIX_GNU_VTENTRY, 12)

// Relaxable instruction relocations.
ELF_RELOC(R_MMIX_GETA, 13)
ELF_RELOC(R_MMIX_GETA_1, 14)
ELF_RELOC(R_MMIX_GETA_2, 15)
ELF_RELOC(R_MMIX_GETA_3, 16)
ELF_RELOC(R_MMIX_CBRANCH, 17)
ELF_RELOC(R_MMIX_CBRANCH_J, 18)
ELF_RELOC(R_MMIX_CBRANCH_1, 19)
ELF_RELOC(R_MMIX_CBRANCH_2, 20)
ELF_RELOC(R_MMIX_CBRANCH_3, 21)
ELF_RELOC(R_MMIX_PUSHJ, 22)
ELF_RELOC(R_MMIX_PUSHJ_1, 23)
ELF_RELOC(R_MMIX_PUSHJ_2, 24)
ELF_RELOC(R_MMIX_PUSHJ_3, 25)
ELF_RELOC(R_MMIX_JMP, 26)
ELF_RELOC(R_MMIX_JMP_1, 27)
ELF_RELOC(R_MMIX_JMP_2, 28)
ELF_RELOC(R_MMIX_JMP_3, 29)

// Instruction-field relocations.
ELF_RELOC(R_MMIX_ADDR19, 30)
ELF_RELOC(R_MMIX_ADDR27, 31)
ELF_RELOC(R_MMIX_REG_OR_BYTE, 32)
ELF_RELOC(R_MMIX_REG, 33)
ELF_RELOC(R_MMIX_BASE_PLUS_OFFSET, 34)
ELF_RELOC(R_MMIX_LOCAL, 35)
ELF_RELOC(R_MMIX_PUSHJ_STUBBABLE, 36)

// Linux local-exec TLS instruction-field relocations.
ELF_RELOC(R_MMIX_TPREL_LO16, 37)
ELF_RELOC(R_MMIX_TPREL_ML16, 38)
ELF_RELOC(R_MMIX_TPREL_MH16, 39)
ELF_RELOC(R_MMIX_TPREL_HI16, 40)
