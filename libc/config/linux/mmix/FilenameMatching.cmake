option(LIBC_MMIX_BUILD_FNMATCH "Build filename pattern matching" OFF)
if(LIBC_MMIX_BUILD_FNMATCH)
  list(APPEND TARGET_LIBC_ENTRYPOINTS libc.src.fnmatch.fnmatch)
endif()

option(LIBC_MMIX_BUILD_GLOB "Build POSIX pathname expansion" OFF)
if(LIBC_MMIX_BUILD_GLOB)
  if(NOT LIBC_MMIX_BUILD_FNMATCH OR NOT LIBC_MMIX_BUILD_FILESYSTEM)
    message(FATAL_ERROR "MMIX glob requires filename matching and filesystem providers")
  endif()
  list(APPEND TARGET_LIBC_ENTRYPOINTS libc.src.glob.glob libc.src.glob.globfree)
endif()
