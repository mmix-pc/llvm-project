option(LIBC_MMIX_BUILD_WORDEXP "Build POSIX word expansion" OFF)
if(NOT LIBC_MMIX_BUILD_WORDEXP)
  return()
endif()
foreach(component LOCALE GLOB ACCOUNT_LOOKUP STDIO)
  if(NOT LIBC_MMIX_BUILD_${component})
    message(FATAL_ERROR "MMIX word expansion requires ${component}")
  endif()
endforeach()
if(NOT LIBC_MMIX_BUILD_SPAWN AND NOT LIBC_MMIX_BUILD_THREADED_LIBC)
  message(FATAL_ERROR "MMIX word expansion requires a spawn provider")
endif()
list(APPEND TARGET_LIBC_ENTRYPOINTS
  libc.src.wordexp.wordexp libc.src.wordexp.wordfree)
