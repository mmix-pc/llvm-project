# Build-tree preparation metadata, not an installed runtime package.
set(MMIX_STATE_SYSROOT "@CMAKE_SYSROOT@")
set(MMIX_STATE_COMPILER "@CMAKE_CXX_COMPILER@")
set(MMIX_STATE_SOURCE "@LIBC_SOURCE_DIR@")
set(MMIX_STATE_HEADERS "@LIBC_INCLUDE_DIR@")
set(MMIX_STATE_NAMESPACE "@LIBC_NAMESPACE@")
set(MMIX_STATE_KERNEL_HEADERS "@LIBC_KERNEL_HEADERS@")
include("${CMAKE_CURRENT_LIST_DIR}/LibcStateTargets.cmake")
