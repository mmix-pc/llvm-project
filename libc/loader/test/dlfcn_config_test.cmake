# Exercise actual routing while keeping static/other-target selection unchanged.
set(root "${CMAKE_CURRENT_LIST_DIR}/../../src/dlfcn")
function(add_entrypoint_object name)
  if(name MATCHES "^(dlopen|dlsym|dlerror)$")
    set_property(GLOBAL PROPERTY "route_${name}" "${ARGN}")
  endif()
endfunction()
function(add_object_library name)
endfunction()
function(add_subdirectory path)
  include("${root}/${path}/CMakeLists.txt")
endfunction()
function(check_profile architecture shared expected)
  set(LIBC_TARGET_OS linux)
  set(LIBC_TARGET_ARCHITECTURE "${architecture}")
  set(LIBC_MMIX_BUILD_SHARED_LIBC "${shared}")
  include("${root}/CMakeLists.txt")
  foreach(name dlopen dlsym dlerror)
    get_property(route GLOBAL PROPERTY "route_${name}")
    if(expected)
      if(NOT route STREQUAL "ALIAS;DEPENDS;.linux.mmix.${name}")
        message(FATAL_ERROR "Missing shared route for ${name}: ${route}")
      endif()
    elseif(NOT "${name}.cpp" IN_LIST route OR "ALIAS" IN_LIST route)
      message(FATAL_ERROR "Changed static/other route for ${name}: ${route}")
    endif()
  endforeach()
endfunction()
cmake_policy(SET CMP0057 NEW)
check_profile(mmix ON TRUE)
check_profile(mmix OFF FALSE)
check_profile(x86_64 ON FALSE)
