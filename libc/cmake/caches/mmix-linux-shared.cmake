# Build-tree shared provider, not an installed or executable dynamic profile.
set(LIBC_MMIX_BUILD_SHARED_LIBC ON CACHE BOOL "")
# Select the startup storage backend; shared objects use IE rather than LE.
set(LIBC_MMIX_ENABLE_STATIC_TLS ON CACHE BOOL "")
set(LIBC_CONF_THREAD_MODE LIBC_THREAD_MODE_PLATFORM CACHE STRING "")
set(LIBC_CONF_ERRNO_MODE LIBC_ERRNO_MODE_THREAD_LOCAL CACHE STRING "")
set(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE BOOL "")
set(LIBC_COMPILE_OPTIONS_DEFAULT "-fPIC;-ftls-model=initial-exec;-fno-lto" CACHE STRING "")
set(LIBC_CONF_PRINTF_DISABLE_FIXED_POINT ON CACHE BOOL "")
foreach(component EXTENDED_PTHREAD THREADED_LIBC THREAD_LIFECYCLE RUNTIME_STATE
    PTHREAD_CREATION PTHREAD_LIFECYCLE PTHREAD_MUTEX PTHREAD_COND PTHREAD_ONCE
    PTHREAD_TSS PTHREAD_SIGNALS CONCURRENT_ALLOCATION CONCURRENT_STDIO
    UNWIND_DIAGNOSTICS UNWIND_ROOTS FORCED_EXIT TLS_DESTRUCTORS
    CXX_RUNTIME_DEPENDENCIES MUTEX_TYPES TIMED_MUTEX PTHREAD_RWLOCK
    PTHREAD_BARRIER PTHREAD_SPIN PROCESS_SHARED ROBUST_MUTEX PI_MUTEX
    PROTECT_MUTEX PTHREAD_SCHEDULING PTHREAD_CLOCKS CONCURRENCY_HINTS
    COORDINATED_FORK DEFERRED_CANCELLATION CANCELLATION_WINDOWS
    CANCELLATION_RUNTIME_LOCKS ASYNC_CANCELLATION)
  set(LIBC_MMIX_BUILD_${component} ON CACHE BOOL "")
endforeach()
include(${CMAKE_CURRENT_LIST_DIR}/mmix-linux.cmake)
