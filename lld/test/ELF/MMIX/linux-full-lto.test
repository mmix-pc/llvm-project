# REQUIRES: mmix
# RUN: split-file %s %t
# RUN: llvm-as %t/entry.ll -o %t/entry.bc
# RUN: llvm-as %t/direct.ll -o %t/direct.bc
# RUN: llvm-as %t/archive.ll -o %t/archive.bc
# RUN: llvm-as %t/unused.ll -o %t/unused.bc
# RUN: llc -filetype=obj %t/entry.ll -o %t/entry.o
# RUN: llvm-mc -triple=mmix-unknown-linux -filetype=obj %t/native.s -o %t/native.o
# RUN: llvm-ar rcs %t/inputs.a %t/unused.bc %t/archive.bc %t/native.o
# RUN: ld.lld -m elf64mmix_linux --threads=1 --lto-O0 %t/entry.bc %t/direct.bc %t/inputs.a --trace -o %t/o0 2>&1 | FileCheck %s --check-prefix=TRACE --implicit-check-not=unused.bc
# RUN: ld.lld -m elf64mmix_linux --threads=1 --lto-O2 %t/entry.bc %t/direct.bc %t/inputs.a -o %t/o2
# RUN: ld.lld -m elf64mmix_linux --threads=1 --lto-O2 %t/entry.o %t/direct.bc %t/inputs.a -o %t/mixed
# RUN: llvm-readobj -h -r -S --symbols --program-headers %t/o0 | FileCheck %s --implicit-check-not=.MMIX.reg_contents --implicit-check-not=unused --implicit-check-not=PT_INTERP --implicit-check-not=PT_DYNAMIC
# RUN: llvm-readobj -h -r -S --symbols --program-headers %t/o2 | FileCheck %s --implicit-check-not=.MMIX.reg_contents --implicit-check-not=unused --implicit-check-not=PT_INTERP --implicit-check-not=PT_DYNAMIC
# RUN: llvm-readobj -h -r -S --symbols --program-headers %t/mixed | FileCheck %s --implicit-check-not=.MMIX.reg_contents --implicit-check-not=unused --implicit-check-not=PT_INTERP --implicit-check-not=PT_DYNAMIC
# RUN: llvm-objdump -d %t/o2 | FileCheck %s --check-prefix=TP
# RUN: not ld.lld -m elf64mmix_linux --threads=1 %t/entry.bc %t/direct.bc -o /dev/null 2>&1 | FileCheck %s --check-prefix=MISSING

# TRACE: entry.bc
# TRACE: direct.bc
# TRACE: inputs.a({{.*}}archive.bc)
# TRACE: inputs.a({{.*}}native.o)
# CHECK: Format: elf64-mmix
# CHECK: DataEncoding: BigEndian
# CHECK: Type: Executable
# CHECK: Machine: EM_MMIX
# CHECK: Type: PT_LOAD
# CHECK: Alignment: 8192
# CHECK: Relocations [
# CHECK-NEXT: ]
# CHECK-DAG: Name: _start
# CHECK-DAG: Name: native_leaf
# CHECK-DAG: Name: tp
# TP-LABEL: <tp>:
# TP: OR r231, r230, 0x0
# MISSING: undefined symbol: archived

#--- entry.ll
target datalayout = "E-m:e-p:64:64-i64:64-n64-S64"
target triple = "mmix-unknown-linux"
declare i64 @direct()
declare i64 @archived()
declare ptr @tp()
define i64 @_start() {
  %a = call i64 @direct()
  %b = call i64 @archived()
  %p = call ptr @tp()
  %v = ptrtoint ptr %p to i64
  %c = add i64 %a, %b
  %d = add i64 %c, %v
  ret i64 %d
}

#--- direct.ll
target datalayout = "E-m:e-p:64:64-i64:64-n64-S64"
target triple = "mmix-unknown-linux-unknown"
declare ptr @llvm.thread.pointer()
define ptr @tp() noinline {
  %p = call ptr @llvm.thread.pointer()
  ret ptr %p
}
define i64 @direct() noinline { ret i64 7 }

#--- archive.ll
target datalayout = "E-m:e-p:64:64-i64:64-n64-S64"
target triple = "mmix-unknown-linux"
declare i64 @native_leaf()
define i64 @archived() noinline {
  %v = call i64 @native_leaf()
  ret i64 %v
}

#--- unused.ll
target datalayout = "E-m:e-p:64:64-i64:64-n64-S64"
target triple = "mmix-unknown-unknown"
declare i64 @missing()
define i64 @unused() { %v = call i64 @missing() ret i64 %v }

#--- native.s
.globl native_leaf
.type native_leaf,@function
native_leaf:
SETL r231,42
POP 0,0
