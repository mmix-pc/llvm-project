# RUN: yaml2obj %s -DALIGN=4 -o %t.align.o
# RUN: not ld.lld -m elf64mmix_linux -shared %t.align.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=STORAGE
# RUN: yaml2obj %s -DSIZE=4 -o %t.short.o
# RUN: not ld.lld -m elf64mmix_linux -shared %t.short.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=STORAGE
