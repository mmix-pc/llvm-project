# RUN: yaml2obj %s -DREL=R_MMIX_TLSGD_PC64 -DADDEND=0x7fffffffffffffff -o %t.gd-overflow.o
# RUN: not ld.lld -m elf64mmix_linux -shared %t.gd-overflow.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=RANGE
# RUN: yaml2obj %s -DREL=R_MMIX_TLSLD_PC64 -DADDEND=0x7fffffffffffffff -o %t.ld-overflow.o
# RUN: not ld.lld -m elf64mmix_linux -shared %t.ld-overflow.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=RANGE
# RUN: yaml2obj %s -DREL=R_MMIX_DTPOFF64 -DADDEND=0x7fffffffffffffff -o %t.offset-overflow.o
