# RUN: yaml2obj %s -DVALUE=24 -o %t.extent.o
# RUN: not ld.lld -m elf64mmix_linux -shared %t.extent.o -o /dev/null 2>&1 | FileCheck %s --check-prefix=EXTENT
# GENERIC: unknown relocation (49)
# UNDEF: requires a defined TLS provider
# LOCAL: requires a nonpreemptible local TLS definition
# TYPE: requires an STT_TLS symbol
# SECTION: requires a definition in an allocated TLS section
# STORAGE: requires a complete aligned 8-byte literal in an allocated file-backed section
# RANGE: out of signed 64-bit range
# EXTENT: lies outside its section or PT_TLS

--- !ELF
FileHeader:
  Class: ELFCLASS64
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MMIX
Sections:
  - Name: .refs
    Type: SHT_PROGBITS
    Flags: [ [[FLAGS=SHF_ALLOC]] ]
    AddressAlign: [[ALIGN=8]]
    Size: [[SIZE=16]]
  - Name: .tdata
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_WRITE, SHF_TLS ]
    AddressAlign: 8
    Size: 24
  - Name: .rela.refs
    Type: SHT_RELA
    Info: .refs
    Link: .symtab
    Relocations:
      - Offset: [[OFFSET=0]]
        Type: [[REL=R_MMIX_GOTTPREL_PC64]]
        Symbol: value
        Addend: [[ADDEND=0]]
Symbols:
  - Name: value
    Type: [[TYPE=STT_TLS]]
    Binding: [[BINDING=STB_GLOBAL]]
    Other: [ [[VIS=STV_HIDDEN]] ]
    Index: [[SECTION=2]]
    Value: [[VALUE=16]]
    Size: 8
