include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/SharedConfig.cmake")

function(mmix_shared_input path)
  if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR "MMIX shared C++ requires an existing absolute input: ${path}")
  endif()
endfunction()

mmix_shared_input("${CMAKE_C_COMPILER}")
file(REAL_PATH "${CMAKE_C_COMPILER}" compiler)
foreach(language CXX ASM)
  mmix_shared_input("${CMAKE_${language}_COMPILER}")
  file(REAL_PATH "${CMAKE_${language}_COMPILER}" selected)
  if(NOT selected STREQUAL compiler)
    message(FATAL_ERROR "MMIX shared C++ requires one compiler")
  endif()
endforeach()
if(NOT IS_ABSOLUTE "${CMAKE_SYSROOT}" OR NOT IS_DIRECTORY "${CMAKE_SYSROOT}")
  message(FATAL_ERROR "MMIX shared C++ requires an explicit sysroot")
endif()
file(REAL_PATH "${CMAKE_SYSROOT}" sysroot)
set(libc_image "${sysroot}/usr/lib/libc.so.1")
set(profile "${sysroot}/usr/lib/mmix-shared-libc-profile")
foreach(path "${libc_image}" "${profile}" "${sysroot}/usr/include/pthread.h"
             "${sysroot}/usr/include/errno.h" "${sysroot}/usr/include/asm/unistd.h")
  mmix_shared_input("${path}")
  file(REAL_PATH "${path}" resolved)
  string(FIND "${resolved}" "${sysroot}/" inside)
  if(NOT inside EQUAL 0)
    message(FATAL_ERROR "MMIX shared C++ input escapes the sysroot: ${path}")
  endif()
endforeach()
file(READ "${profile}" kind)
string(STRIP "${kind}" kind)
if(NOT kind STREQUAL "mmix-linux-shared-pthread-c")
  message(FATAL_ERROR "MMIX shared C++ requires shared pthread LLVM libc")
endif()
set(builtins "${LIBCXX_MMIX_LINUX_BUILTINS}")
mmix_shared_input("${builtins}")
get_filename_component(compiler_bin "${CMAKE_C_COMPILER}" DIRECTORY)
set(readobj "${compiler_bin}/llvm-readobj")
mmix_shared_input("${readobj}")
foreach(path "${libc_image}" "${builtins}")
  execute_process(COMMAND "${readobj}" --file-headers "${path}"
    RESULT_VARIABLE status OUTPUT_VARIABLE headers ERROR_VARIABLE diagnostics)
  string(REGEX MATCHALL "Format: [^\n]+" formats "${headers}")
  if(NOT status EQUAL 0 OR NOT formats)
    message(FATAL_ERROR "Cannot inspect MMIX shared C++ input: ${path}: ${diagnostics}")
  endif()
  foreach(format IN LISTS formats)
    if(NOT format STREQUAL "Format: elf64-mmix")
      message(FATAL_ERROR "MMIX shared C++ requires native MMIX ELF inputs")
    endif()
  endforeach()
  if(path STREQUAL libc_image AND NOT headers MATCHES "Type: SharedObject")
    message(FATAL_ERROR "MMIX shared C++ requires an ELF shared libc")
  endif()
endforeach()
foreach(language C CXX)
  string(APPEND CMAKE_${language}_FLAGS " -nostdlibinc -isystem =/usr/include")
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/InstalledLibc.cmake")
if(NOT RUNTIMES_USE_LIBC STREQUAL "llvm-libc")
  message(FATAL_ERROR "MMIX shared C++ requires LLVM libc")
endif()
# -nostdlib suppresses the Driver's implicit builtins, including for libunwind.
target_link_libraries(runtimes-libc-shared INTERFACE "${libc_image}" "${builtins}")
foreach(project LIBCXX LIBCXXABI LIBUNWIND)
  set(${project}_BUILTINS_LIBRARY "${builtins}")
endforeach()
# Component installation is explicit; package qualification remains separate.
set(MMIX_LINUX_SHARED_RUNTIME_VALIDATED TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/../../../../libunwind/src/mmix/Shared.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SharedInstallation.cmake")
cmake_language(DEFER CALL mmix_shared_installation)
message(STATUS "MMIX shared C++: configuration only; packaging must audit PIC providers and dependency closure")
