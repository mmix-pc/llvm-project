# Opt-in Linux runtime preparation, not an installable libc++ distribution.
set(LIBCXX_MMIX_LINUX_STATE_DIR "" CACHE PATH "Matching libc build-tree state package")
set(CMAKE_SYSTEM_NAME Linux CACHE STRING "")
set(CMAKE_SYSTEM_PROCESSOR mmix CACHE STRING "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY CACHE STRING "")
set(CMAKE_C_COMPILER_TARGET mmix-unknown-linux CACHE STRING "")
set(CMAKE_CXX_COMPILER_TARGET mmix-unknown-linux CACHE STRING "")
set(CMAKE_ASM_COMPILER_TARGET mmix-unknown-linux CACHE STRING "")
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(CMAKE_POSITION_INDEPENDENT_CODE OFF CACHE BOOL "")
set(LLVM_ENABLE_RUNTIMES "libcxx;libcxxabi;libunwind" CACHE STRING "")
set(CMAKE_PROJECT_Runtimes_INCLUDE
  "${CMAKE_CURRENT_LIST_DIR}/../Modules/MMIX/InstalledLibc.cmake" CACHE FILEPATH "")
set(LIBCXX_ENABLE_STATIC ON CACHE BOOL "")
set(LIBCXX_ENABLE_SHARED OFF CACHE BOOL "")
set(LIBCXX_ENABLE_EXCEPTIONS ON CACHE BOOL "")
set(LIBCXX_ENABLE_RTTI ON CACHE BOOL "")
set(LIBCXX_USE_COMPILER_RT ON CACHE BOOL "")
set(LIBCXX_CXX_ABI libcxxabi CACHE STRING "")
set(LIBCXX_ENABLE_NEW_DELETE_DEFINITIONS OFF CACHE BOOL "")
set(LIBCXX_ENABLE_STATIC_ABI_LIBRARY OFF CACHE BOOL "")
set(LIBCXX_STATICALLY_LINK_ABI_IN_STATIC_LIBRARY OFF CACHE BOOL "")
# FIXME: Replace the transitional external adapter with the pthread backend
# when real threads/TLS are available; rebuild its runtimes and consumers.
set(LIBCXX_ENABLE_THREADS ON CACHE BOOL "")
set(LIBCXX_HAS_EXTERNAL_THREAD_API ON CACHE BOOL "")
set(LIBCXX_HAS_PTHREAD_API OFF CACHE BOOL "")
set(LIBCXX_HAS_C11_THREAD_API OFF CACHE BOOL "")
set(LIBCXX_HAS_WIN32_THREAD_API OFF CACHE BOOL "")
# Required by upstream when types are enabled; this is not a clock provider.
set(LIBCXX_ENABLE_MONOTONIC_CLOCK ON CACHE BOOL "")
set(LIBCXX_PSTL_BACKEND serial CACHE STRING "")
set(LIBCXX_ENABLE_FILESYSTEM OFF CACHE BOOL "")
set(LIBCXX_ENABLE_LOCALIZATION OFF CACHE BOOL "")
set(LIBCXX_ENABLE_RANDOM_DEVICE OFF CACHE BOOL "")
set(LIBCXX_ENABLE_TIME_ZONE_DATABASE OFF CACHE BOOL "")
set(LIBCXX_ENABLE_UNICODE OFF CACHE BOOL "")
set(LIBCXX_ENABLE_WIDE_CHARACTERS ON CACHE BOOL "")
set(LIBCXXABI_ENABLE_STATIC ON CACHE BOOL "")
set(LIBCXXABI_ENABLE_SHARED OFF CACHE BOOL "")
set(LIBCXXABI_ENABLE_THREADS OFF CACHE BOOL "")
set(LIBCXXABI_ENABLE_EXCEPTIONS ON CACHE BOOL "")
set(LIBCXXABI_HAS_EXTERNAL_THREAD_API OFF CACHE BOOL "")
set(LIBCXXABI_HAS_PTHREAD_API OFF CACHE BOOL "")
set(LIBCXXABI_HAS_WIN32_THREAD_API OFF CACHE BOOL "")
set(LIBCXXABI_USE_COMPILER_RT ON CACHE BOOL "")
set(LIBCXXABI_USE_LLVM_UNWINDER ON CACHE BOOL "")
set(LIBUNWIND_ENABLE_STATIC ON CACHE BOOL "")
set(LIBUNWIND_ENABLE_SHARED OFF CACHE BOOL "")
set(LIBUNWIND_ENABLE_THREADS OFF CACHE BOOL "")
set(LIBUNWIND_USE_FRAME_HEADER_CACHE OFF CACHE BOOL "")
set(LIBUNWIND_USE_COMPILER_RT ON CACHE BOOL "")
foreach(project LIBCXX LIBCXXABI LIBUNWIND)
  set(${project}_INCLUDE_TESTS OFF CACHE BOOL "")
  set(${project}_INSTALL_HEADERS OFF CACHE BOOL "")
  set(${project}_INSTALL_LIBRARY OFF CACHE BOOL "")
endforeach()
set(LIBCXX_INCLUDE_BENCHMARKS OFF CACHE BOOL "")
set(LIBCXX_INSTALL_MODULES OFF CACHE BOOL "")
# Static compiler checks cannot establish target library availability.
set(LIBCXX_HAS_PTHREAD_LIB OFF CACHE BOOL "")
set(LIBCXX_HAS_RT_LIB OFF CACHE BOOL "")
set(LIBCXX_HAS_ATOMIC_LIB OFF CACHE BOOL "")
set(LIBCXX_HAS_GCC_LIB OFF CACHE BOOL "")
set(LIBCXX_HAS_GCC_S_LIB OFF CACHE BOOL "")
set(LIBCXXABI_HAS_PTHREAD_LIB OFF CACHE BOOL "")
set(LIBCXXABI_HAS_CXA_THREAD_ATEXIT_IMPL OFF CACHE BOOL "")
set(LIBCXXABI_HAS_GCC_S_LIB OFF CACHE BOOL "")
set(LIBCXXABI_HAS_DL_LIB OFF CACHE BOOL "")
set(LIBUNWIND_HAS_PTHREAD_LIB OFF CACHE BOOL "")
set(LIBUNWIND_HAS_DL_LIB OFF CACHE BOOL "")
