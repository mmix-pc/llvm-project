# Shared Linux C++ preparation. Use a fresh build and explicit PIC providers.
set(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE BOOL "")
set(CMAKE_SKIP_RPATH ON CACHE BOOL "")
set(CMAKE_C_FLAGS "-fPIC -ftls-model=initial-exec -fno-lto" CACHE STRING "")
set(CMAKE_CXX_FLAGS "-nostdinc++ -fPIC -ftls-model=initial-exec -fno-lto" CACHE STRING "")
set(CMAKE_ASM_FLAGS "-fPIC" CACHE STRING "")
set(CMAKE_SHARED_LINKER_FLAGS
  "-nostdlib -Wl,-z,defs,-z,now,-z,relro,--eh-frame-hdr" CACHE STRING "")
foreach(project LIBCXX LIBCXXABI LIBUNWIND)
  set(${project}_ENABLE_SHARED ON CACHE BOOL "")
  set(${project}_ENABLE_STATIC OFF CACHE BOOL "")
  foreach(library C PTHREAD DL RT ATOMIC GCC GCC_S)
    set(${project}_HAS_${library}_LIB OFF CACHE BOOL "")
  endforeach()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/MMIXLinuxRuntimeBase.cmake")
set(LIBCXX_HAS_EXTERNAL_THREAD_API OFF CACHE BOOL "")
set(LIBCXX_HAS_PTHREAD_API ON CACHE BOOL "")
set(LIBCXX_STATICALLY_LINK_ABI_IN_SHARED_LIBRARY OFF CACHE BOOL "")
set(LIBCXXABI_ENABLE_THREADS ON CACHE BOOL "")
set(LIBCXXABI_HAS_PTHREAD_API ON CACHE BOOL "")
set(LIBCXXABI_HAS_CXA_THREAD_ATEXIT_IMPL ON CACHE BOOL "")
set(LIBCXXABI_STATICALLY_LINK_UNWINDER_IN_SHARED_LIBRARY OFF CACHE BOOL "")
set(LIBUNWIND_ENABLE_THREADS ON CACHE BOOL "")
set(LIBUNWIND_HIDE_SYMBOLS OFF CACHE BOOL "")
set(LIBUNWIND_ENABLE_ASSERTIONS OFF CACHE BOOL "")
set(LIBUNWIND_ADDITIONAL_COMPILE_FLAGS
  "-D_LIBUNWIND_MMIX_LINUX_THREADS;-D_LIBUNWIND_MMIX_STARTUP_IMAGES" CACHE STRING "")
set(LIBCXX_MMIX_LINUX_BUILTINS "" CACHE FILEPATH "Explicit MMIX Linux PIC builtins archive")
set(CMAKE_PROJECT_Runtimes_INCLUDE
  "${CMAKE_CURRENT_LIST_DIR}/../Modules/MMIX/SharedRuntime.cmake" CACHE FILEPATH "" FORCE)
